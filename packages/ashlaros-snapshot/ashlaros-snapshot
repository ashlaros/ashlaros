#!/usr/bin/env bash
#
# Snapshots of the root subvolume, for the update that breaks the machine.
#
# We install btrfs by default and this is what it is for: a `pacman -Syu`
# that breaks the kernel, the GPU driver or systemd otherwise leaves a live
# ISO and a manual chroot, on an Arch base running a third-party kernel.
#
# Recovery is NOT from the boot menu, and it is NOT `snapper rollback`.
# That was tried on a real install: archinstall mounts @ by subvol= in
# fstab rather than as the filesystem's default subvolume, so snapper
# cannot detect its ambit, and forcing it with --ambit reports success
# while fstab still wins at the next boot - the machine comes back broken
# having been told it was fixed. Recovery is replacing @ with a snapshot
# from rescue media; the README has the commands, verified end to end.
#
# The failure modes matter more than the happy path. A snapshot tool that
# quietly does nothing is worse than no snapshot tool, because it turns "I
# have no backups" into "I think I have backups" - so an ext4 root and an
# unconfigured snapper are both reported, not swallowed.
set -uo pipefail

# 127 rather than 1 when snapshots are simply not available on this
# machine, so an update path can tell "cannot snapshot here" from "tried to
# snapshot and failed" and keep going in the first case.
readonly UNAVAILABLE=127

warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
die() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

usage() {
    cat <<'EOF'
usage: ashlaros-snapshot <create|list|rollback> [description|number]

  create     snapshot the root subvolume now
  list       what has been captured
  rollback   replace the root subvolume with a snapshot

Rollback is a RESCUE-MEDIA procedure: boot the AshlarOS ISO, unlock the
disk, mount the btrfs top level, and run it there. It refuses to run
against the root you are booted from, because replacing a subvolume that
is currently mounted cannot take effect and would report success anyway.

  cryptsetup open /dev/nvme0n1p2 root
  mount -o subvolid=5 /dev/mapper/root /mnt
  ashlaros-snapshot rollback --top-level /mnt

NOT `snapper rollback`, which cannot work on this layout: fstab mounts @
by subvol=, so snapper cannot detect its ambit, and forcing it reports
success while the machine comes back still broken.
EOF
}

# btrfs is a choice at install time - the configurator offers ext4 too - so
# everything here has to degrade to "not available" rather than error.
require_snapper() {
    if ! command -v snapper >/dev/null; then
        warn "snapper is not installed, so no snapshot was taken."
        return "$UNAVAILABLE"
    fi
    if [ "$(findmnt -no FSTYPE /)" != "btrfs" ]; then
        warn "the root filesystem is not btrfs, so no snapshot was taken."
        return "$UNAVAILABLE"
    fi
    # Snapper installed but unconfigured snapshots nothing. Staying quiet
    # here reads as a successful snapshot, so the next update looks
    # recoverable when nothing has ever been captured.
    #
    # The listing is read from the config file rather than from
    # `snapper list-configs`, whose output is a D-Bus round trip: with
    # snapperd unreachable it fails with org.freedesktop.DBus.Error rather
    # than printing an empty table, and a grep over that failure is
    # indistinguishable from a machine that has no config.
    if [ ! -f /etc/snapper/configs/root ]; then
        die "snapper has no 'root' config, so NO SNAPSHOT WAS TAKEN."
        die "create one with: sudo snapper -c root create-config /"
        return 1
    fi
    return 0
}

create() {
    local status
    require_snapper || return $?
    # "single" rather than pre/post: this is a point in time to come back
    # to, and snap-pac already brackets pacman transactions in pairs
    snapper -c root create --type single --cleanup-algorithm number \
        --description "${1:-manual}" || {
        status=$?
        die "snapper failed to create the snapshot (exit $status)."
        return "$status"
    }
    printf 'snapshot taken: %s\n' "${1:-manual}"
}

# The recovery half of #21. Snapshots existed; getting back to one was
# five manual steps from the README, performed on a machine that will not
# boot, probably read off a phone - which is the moment a typo costs most.
#
# This is the README's verified procedure and nothing more: rename @ aside,
# snapshot the chosen one into its place. No `btrfs subvolume set-default`,
# which snapper-rollback does and which is precisely the operation that
# reports success while fstab's subvol=/@ still wins at the next boot.
#
# It refuses rather than guesses. Every way this can be wrong - not btrfs,
# no @ there, no such snapshot, the root you are booted from - is a check,
# because a rollback that silently does nothing leaves someone believing
# they recovered.
rollback() {
    local top="" number="" reply

    while [ $# -gt 0 ]; do
        case "$1" in
            --top-level) top="${2:-}"; shift 2 || return 2 ;;
            --number) number="${2:-}"; shift 2 || return 2 ;;
            *) number="$1"; shift ;;
        esac
    done

    if [ -z "$top" ]; then
        die "rollback needs --top-level: the mount point of subvolid=5."
        die "  mount -o subvolid=5 /dev/mapper/root /mnt"
        return 2
    fi
    if [ ! -d "$top" ]; then
        die "$top is not a directory."
        return 1
    fi
    if [ "$(findmnt -no FSTYPE --target "$top" 2>/dev/null)" != "btrfs" ]; then
        die "$top is not on btrfs."
        return 1
    fi
    if [ ! -d "$top/@" ]; then
        die "$top has no @ subvolume - is this the top level (subvolid=5)?"
        die "  mount -o subvolid=5 <device> $top"
        return 1
    fi

    # The check that decides whether this can work at all. Replacing the
    # subvolume the running system is mounted from does not take effect,
    # and the tool would otherwise congratulate the user on a rollback
    # that did nothing.
    local running
    running=$(findmnt -no UUID --target / 2>/dev/null)
    if [ -n "$running" ] && [ "$running" = "$(findmnt -no UUID --target "$top" 2>/dev/null)" ]; then
        die "$top is the filesystem this system is booted from."
        die "Rollback replaces the root subvolume, which cannot take effect"
        die "while it is mounted. Boot the AshlarOS ISO and run it there."
        return 1
    fi

    local snapdir="$top/@/.snapshots"
    if [ ! -d "$snapdir" ]; then
        die "no $snapdir - this root has no snapshots to roll back to."
        return 1
    fi

    if [ -z "$number" ]; then
        printf 'snapshots in %s:\n\n' "$snapdir"
        local n
        for n in $(ls -1 "$snapdir" 2>/dev/null | sort -n); do
            [ -d "$snapdir/$n/snapshot" ] || continue
            printf '  %-6s %s\n' "$n" \
                "$(sed -n 's|.*<description>\(.*\)</description>.*|\1|p' \
                    "$snapdir/$n/info.xml" 2>/dev/null | head -1)"
        done
        printf '\nchoose one: ashlaros-snapshot rollback --top-level %s <number>\n' "$top"
        return 0
    fi

    local source="$snapdir/$number/snapshot"
    if [ ! -d "$source" ]; then
        die "no snapshot $number in $snapdir."
        return 1
    fi

    # @.broken is kept, not deleted: it is the only copy of whatever the
    # user had, and a rollback that destroys it is unrecoverable if the
    # snapshot turns out to be the wrong one.
    local aside="$top/@.broken"
    if [ -e "$aside" ]; then
        aside="$top/@.broken.$(date +%s)"
    fi

    printf 'about to replace %s/@ with snapshot %s\n' "$top" "$number"
    printf 'the current root is kept as %s\n\n' "$aside"
    printf 'type yes to continue: '
    read -r reply
    [ "$reply" = "yes" ] || { warn "nothing was changed."; return 1; }

    mv -- "$top/@" "$aside" || {
        die "could not move $top/@ aside; nothing was changed."
        return 1
    }

    # The snapshot lives UNDER @, so the move just took it with it. The
    # README's procedure reads from @.broken for exactly this reason, and
    # a source path computed before the move points at nothing afterwards.
    source="$aside/.snapshots/$number/snapshot"
    if [ ! -d "$source" ]; then
        die "$source vanished with the move; restoring the original root."
        mv -- "$aside" "$top/@"
        return 1
    fi

    if ! btrfs subvolume snapshot "$source" "$top/@"; then
        die "could not create $top/@ from $source."
        # put it back rather than leaving a machine with no root at all
        mv -- "$aside" "$top/@" && die "the original root was restored."
        return 1
    fi

    printf '\nrolled back to snapshot %s.\n' "$number"
    printf 'reboot, then once the machine is known good:\n'
    printf '  btrfs subvolume delete %s\n' "$aside"
}

main() {
    case "${1:-}" in
        create)
            shift
            create "$@"
            ;;
        list)
            require_snapper || return $?
            snapper -c root list
            ;;
        rollback)
            shift
            rollback "$@"
            ;;
        -h | --help)
            usage
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
