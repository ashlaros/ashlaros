# Maintainer: AshlarOS <build@ashlaros.download>

# rebuilt once when source_hash began covering the executable bit
pkgname=ashlaros-settings
pkgver=20260910
pkgrel=1
pkgdesc="AshlarOS sway desktop configuration and skel"
arch=('any')
url="https://github.com/ashlaros/ashlaros"
license=('GPL-3.0-or-later')
groups=('ashlaros')
depends=(
    # the snapshot tool moved to its own package so the ISO can carry it
    # for rescue-media rollback; the desktop still gets it through this
    'ashlaros-snapshot'
    'sway'                    # window manager
    'swaybg'                  # wallpaper setter
    'swayidle'                # idle management daemon
    'sway-services'           # systemd units for sway and friends
    'waybar'                  # configurable bar
    'foot'                    # terminal application
    'foot-terminfo'           # terminal info for foot
    'rofi'                    # launcher; provides rofi-wayland since 2.0
    'rofimoji'                # emoji picker
    'wtype'                   # the only wayland typer rofimoji supports;
                              # without it the picker falls through to its
                              # NoopTyper and raises NoTyperFoundException
                              # on its default action, which is "type"
    'mako'                    # desktop notifications
    'brightnessctl'           # cli to control brightness
    'wob'                     # overlay bar for brightness and volume
    'grim'                    # screenshot tool
    'slurp'                   # region select, helper for grim
    'grimshot'                # screenshot helper built on grim/slurp
    'swappy'                  # screenshot editing tool
    'tesseract'               # OCR engine behind capture-text.sh
    # language data is per-language and separate: this is the default, and
    # ASHLAROS_OCR_LANGS selects others once tesseract-data-deu and friends
    # are installed
    'tesseract-data-eng'
    'zbar'                    # QR decode; qrencode below writes them, this reads
    'wf-recorder'             # screen recording util
    'wl-clipboard'            # copy/paste utilities for wayland
    'wl-clip-persist'         # persists clipboard content between clients
    'xdg-terminal-exec'       # execute-in-terminal xdg standard
    'idlehack'                # inhibit swayidle on screensaver-inhibit dbus calls
    'swayr'                   # lru window switcher for sway
    'way-displays'            # display management; the user unit, the
                              # autostart entry and the skel cfg.yaml here
                              # all assume it, and without it the desktop
                              # loses auto-scale, hotplug and lid handling
    'nwg-wrapper'             # conky like onscreen information
    'dex'                     # executes desktop entries on autostart
    'gum'                     # the TUI toolkit ashlaros-settings-tui and
                              # ashlaros-displays are built from; without
                              # it both exit with "gum is not installed"
                              # the first time a user opens settings
    'qrencode'                # renders the current wifi as a QR code a
                              # phone can scan, instead of reading a
                              # passphrase off a sticky note
    'jq'                      # json parsing, used across the scripts
    'bc'                      # arithmetic for the bar scripts
    'inotify-tools'           # file watchers
    'lm_sensors'              # sensor readings for the bar
    'calcurse'                # tui calendar application
    # notes, as plain Markdown in a directory: nothing to export and
    # nothing to sync, so git persistence is `git init` and no more
    'zk'                      # plain-text notes with an index and an LSP
    'btop'                    # system monitor
    'bluetuith'               # bluetooth management tool
    'noto-fonts-emoji'        # emoji font, e.g. weather icons
    'pacman-contrib'          # checkupdates, for the updates module
    'topgrade'                # the update path the bar clicks through to;
                              # a depends rather than an optdepend because
                              # "default update path" and "optional" are
                              # contradictory - if it may be missing, the
                              # fallback chain has to stay
    'ashlaros-branding'       # logo, wallpaper and palette
    ## shell
    'zsh'
    'fzf'                     # ^R over history, ^T over files; the shipped
                              # .zshrc sources its key bindings
    'zoxide'                  # `z` frecency jump, also sourced there
    'grml-zsh-config'         # arch's own zsh baseline, in place of oh-my-zsh
    'zsh-autosuggestions'
    'zsh-syntax-highlighting'
    'starship'                # prompt
    ## portal
    'xdg-desktop-portal-lxqt' # native file chooser, via the portal
    'lxqt-qtplugin'           # styles the portal dialog process
    ## theme
    'qt6ct'                   # provides qt6ct-style, used by the portal dialog
    'kvantum'                 # theme engine for qt
    'kvantum-qt5'             # theme engine for qt5
    'gtk-nocsd'               # the skel .profile preloads it to disable
                              # client-side decorations; without it the
                              # GTK_CSD=0 beside it is a no-op and GTK
                              # apps draw headerbars inside sway's border
    'adw-gtk-theme'           # default gtk theme
    'gnome-themes-extra'      # ships Adwaita/Adwaita-dark for gtk3
    'papirus-icon-theme'      # default icon theme
    'adwaita-cursors'         # default cursor theme
    'ttf-jetbrains-mono-nerd' # default monospace font
    'ttf-roboto'              # default font
)
optdepends=(
    'flashfocus: better flashing on focus changes'
    'gtklock: lockscreen based on gtkgreet'
    'swaylock-effects: minimalistic lockscreen with fancy effects'
    'wlsunset: time & place based light temperature'
    'autotiling: automated tiling'
    'sworkstyle: dynamic workspace names (icons) in waybar'
    'cliphist: clipboard manager'
    'swaycwd: open here helper'
    'poweralertd: battery and power notifications'
    'wluma: adaptive brightness based on screen contents and ALS'
    # the installer puts this on every x86_64 desktop; it stays optional
    # here because this package is arch=any and yay is not built for ARM
    'yay: AUR helper, required by ashlaros-theme for the catppuccin themes'
    'pcmanfm-qt: file manager'
    'python-requests: the waybar weather module'
    # never a hard dependency: the Ask key sends a picture of your screen
    # to whichever provider you configure, and an LLM tool on every
    # desktop by default is a statement this distribution should not make
    # on the user's behalf
    'aichat: ask a model about a screen region (Print, then a)'
    # mail is personal and aerc does nothing until it has an account, so
    # an unconfigured client in the launcher would be worse than none
    'aerc: terminal mail client, configured from the settings TUI'
    # never a hard dependency: pacman resolves 182 packages for it -
    # opencv is 112.81 MiB and qt6-base 66.53 MiB, measured - for an
    # infrared camera most machines do not have. And it is weaker than a
    # password: a similar face or a photo may work.
    'howdy-next: infrared face unlock for sudo, from the settings TUI'
    # the desktop otherwise cannot open a .docx at all: this installs
    # Docs and Microsoft 365 as their own windows, from the settings TUI
    'firefoxpwa: Google Docs and Microsoft 365 as web apps'
    # 147 MB, and the only thing that faithfully round-trips Office
    # formats - which is why it is here rather than absent or default
    'libreoffice-still: full office suite, for real .docx round-tripping'
    # mounts Drive and OneDrive as a directory, which is the version of
    # "open it from the cloud" that does not publish the document first
    'rclone: mount Drive and OneDrive as local directories'
)
# generated_background.svg is rewritten on every theme apply, and the
# per-user theme.conf is the file the theme switcher edits
backup=()

package() {
    local payload="${startdir}/payload"

    install -d "${pkgdir}/etc" "${pkgdir}/usr"
    cp -a "${payload}/etc/." "${pkgdir}/etc/"
    cp -a "${payload}/usr/." "${pkgdir}/usr/"

    # cp -a keeps the source tree's modes; the scripts must be executable
    # whatever the checkout looked like
    # -type f under scripts/ reaches hw/ too, which is the point: a
    # predicate that is not executable answers nothing
    find "${pkgdir}/usr/bin" "${pkgdir}/usr/local/bin" \
        "${pkgdir}/usr/share/sway/scripts" \
        "${pkgdir}/usr/share/ashlaros/migrations" -type f -exec chmod 755 {} +
}
