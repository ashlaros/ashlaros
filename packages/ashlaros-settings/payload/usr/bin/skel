#!/bin/bash
# Copy /etc/skel over the current user's home directory.
#
# A package upgrade installs new configuration into /etc/skel, where an
# existing account never reads it. This is how that account picks it up,
# and how a broken hand-edited sway config is recovered from a TTY.
set -eu

backup="$HOME/.config-backup-$(date +%Y.%m.%d-%H.%M.%S)"

cat <<EOF
This overwrites your configuration in $HOME with the shipped defaults from
/etc/skel. Your current ~/.config is copied to
  $backup
first, so nothing is lost - but files you have edited will be replaced.
EOF

read -r -p "Continue? [y/N] " response
case "$response" in
[yY] | [yY][eE][sS]) ;;
*)
  echo "Nothing changed."
  exit 0
  ;;
esac

if [ -d "$HOME/.config" ]; then
  cp -a "$HOME/.config" "$backup"
  echo "backed up ~/.config to $backup"
fi

cp -r /etc/skel/. "$HOME"
echo "copied /etc/skel to $HOME"
echo "run 'swaymsg reload' to apply the new sway configuration"
