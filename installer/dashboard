#!/usr/bin/env bash
# The visible install UI.
#
# This process owns the screen: it launches the installer as a
# non-interactive child, sends the child's output to the log, renders
# progress from the state file the orchestrator writes, and then renders the
# result. There is deliberately no second, background dashboard.
#
# Usage: dashboard <log-file> <state-file> -- <installer command...>
set -uo pipefail

usage() {
  echo "Usage: $0 <log-file> <state-file> -- <installer command...>" >&2
  exit 2
}

(($# >= 4)) || usage
LOG_FILE="$1"
STATE_FILE="$2"
shift 2
[[ ${1:-} == "--" ]] || usage
shift
(($# > 0)) || usage
INSTALL_CMD=("$@")

TTY_PATH="${ASHLAROS_DASHBOARD_TTY:-/dev/tty}"
LOGO_PATH="${ASHLAROS_PATH:-/usr/share/ashlaros}/logo.txt"

CSI=$'\033['
RESET="${CSI}0m"
DIM="${CSI}2m"
HIDE_CURSOR="${CSI}?25l"
SHOW_CURSOR="${CSI}?25h"
CLEAR="${CSI}2J${CSI}H"
STONE="${CSI}37m"
BRIGHT="${CSI}97m"
RED="${CSI}31m"

BAR_WIDTH=40

child_pid=""

cleanup() {
  printf '%s' "$SHOW_CURSOR" >"$TTY_PATH"
  [[ -n $child_pid ]] && kill "$child_pid" 2>/dev/null
}
trap cleanup EXIT

# each line is centred on its own width, so the logo's overall dimensions
# never come up; a missing logo degrades to the word rather than an error
if [[ -r $LOGO_PATH ]]; then
  LOGO=$(<"$LOGO_PATH")
else
  LOGO="AshlarOS"
fi

term_width() {
  local width
  width=$(stty size 2>/dev/null <"$TTY_PATH" | awk '{print $2}')
  [[ $width =~ ^[0-9]+$ ]] && ((width > 0)) && echo "$width" || echo 80
}

# State the orchestrator publishes. Read in one jq pass: a second read could
# straddle an atomic replace and see a different generation of the file.
read_state() {
  local raw
  raw=$(jq -r '
    [ (.current_phase // "Starting"),
      ((.current_index // 0) | floor),
      ((.total_phases // 1) | floor),
      (.target // "/mnt"),
      ((.expected_packages // 0) | floor)
    ] | @tsv' "$STATE_FILE" 2>/dev/null) || return 1
  [[ -n $raw ]] || return 1
  IFS=$'\t' read -r PHASE INDEX TOTAL TARGET EXPECTED <<<"$raw"
}

# libalpm makes one directory per package under <target>/var/lib/pacman/local,
# which is the only count of real progress available while pacstrap runs.
count_packages() {
  local dir="$TARGET/var/lib/pacman/local"
  [[ -d $dir ]] || { echo 0; return; }
  find "$dir" -mindepth 1 -maxdepth 1 -type d -printf . 2>/dev/null | wc -c
}

# Per-mille, so the bar still moves inside a long phase: whole phases set the
# floor, the package count fills the band up to the next phase's floor.
progress_permille() {
  local floor=$((INDEX * 1000 / (TOTAL > 0 ? TOTAL : 1)))
  local ceiling=$(((INDEX + 1) * 1000 / (TOTAL > 0 ? TOTAL : 1)))

  if ((EXPECTED > 0)); then
    local installed
    installed=$(count_packages)
    local within=$((installed * 1000 / EXPECTED))
    ((within > 1000)) && within=1000
    local band=$((floor + (ceiling - floor) * within / 1000))
    ((band > floor)) && floor=$band
  fi

  ((floor > 1000)) && floor=1000
  echo "$floor"
}

draw_bar() {
  local permille="$1" filled empty
  filled=$((permille * BAR_WIDTH / 1000))
  empty=$((BAR_WIDTH - filled))
  printf '%s' "$BRIGHT"
  printf '█%.0s' $(seq 1 "$filled" 2>/dev/null)
  printf '%s' "${DIM}${STONE}"
  printf '░%.0s' $(seq 1 "$empty" 2>/dev/null)
  printf '%s' "$RESET"
}

centre() {
  local text="$1" width="$2" visible pad
  # strip the escapes before measuring, or every colour costs columns
  visible=$(sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' <<<"$text")
  pad=$(((width - ${#visible}) / 2))
  ((pad < 0)) && pad=0
  printf '%*s%s' "$pad" "" "$text"
}

render() {
  local width permille
  width=$(term_width)
  permille=$(progress_permille)

  {
    printf '%s%s' "$CLEAR" "$HIDE_CURSOR"
    while IFS= read -r line; do
      centre "${STONE}${line}${RESET}" "$width"
      printf '\n'
    done <<<"$LOGO"
    printf '\n'
    centre "$PHASE" "$width"
    printf '\n\n'
    centre "$(draw_bar "$permille")" "$width"
    printf '\n\n'
    centre "${DIM}step $((INDEX + 1)) of ${TOTAL}${RESET}" "$width"
    printf '\n'
  } >"$TTY_PATH"
}

render_result() {
  local width status="$1" message="$2"
  width=$(term_width)
  {
    printf '%s%s' "$CLEAR" "$SHOW_CURSOR"
    while IFS= read -r line; do
      centre "${STONE}${line}${RESET}" "$width"
      printf '\n'
    done <<<"$LOGO"
    printf '\n'
    centre "$status" "$width"
    printf '\n\n'
    centre "${DIM}${message}${RESET}" "$width"
    printf '\n\n'
  } >"$TTY_PATH"
}

# read_state overwrites all of these; the defaults are what the first frame
# draws while the orchestrator is still writing its first state file
PHASE="Starting"
INDEX=0
TOTAL=1
TARGET="/mnt"
EXPECTED=0

"${INSTALL_CMD[@]}" >>"$LOG_FILE" 2>&1 &
child_pid=$!

while kill -0 "$child_pid" 2>/dev/null; do
  read_state && render
  sleep 1
done

wait "$child_pid"
status=$?
child_pid=""

read_state || true

if ((status == 0)); then
  render_result "${BRIGHT}AshlarOS is installed${RESET}" \
    "Remove the install medium and reboot."
  if gum confirm --affirmative "Reboot now" --negative "Stay here" "Reboot?" </"$TTY_PATH"; then
    systemctl reboot
  fi
else
  render_result "${RED}Installation failed${RESET}" \
    "The log is at $LOG_FILE"
fi

exit "$status"
