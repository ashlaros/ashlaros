; The keybinding help overlay.
;
; Replaces nwg-wrapper, which needed one process per output, a manual
; `swaymsg -t get_outputs` loop to spawn them, and a pkill over an argv
; pattern to toggle them. eww's daemon owns the window, so `eww open
; --toggle help` is the whole toggle and a reload does not respawn anything.
;
; :monitor 0 rather than a name: eww takes either, and the overlay belongs
; on one screen rather than every screen at once - which is also what the
; old per-output loop got wrong when a display was hotplugged.

(defpoll help-text
  :interval "1h"
  :initial ""
  ; sbdp.sh parses the sway config and emits JSON; jq turns it into the
  ; Pango markup that label :markup renders. Sorting is stable, so entries
  ; within a category keep the order the parser produced them in.
  ;
  ; jq's own newlines are the line breaks; nothing reshapes them afterwards.
  ; This used to end `| tr '\n' '\r' | sed 's/\r/\\n/g'`, which never
  ; reached /bin/sh as written: yuck's lexer unescapes \(.) inside a string
  ; literal first, so sh ran `tr 'n' 'r' | sed 's/r/\n/g'` and broke every
  ; line at each n and r - "window" as "wi/dow", "Super" as "Supe/",
  ; "[number]" as "/umbe/]". Nothing needed escaping to begin with: eww's
  ; run_command only trims newlines off the ends of a command's output, so
  ; the ones between entries survive into the markup pango renders.
  `/usr/share/sway/scripts/sbdp.sh $HOME/.config/sway/config | jq --raw-output 'sort_by(.category) | .[] | .action + ": <b>" + .keybinding + "</b>"'`)

; :show-truncated false is what stops the text being cut. For a :markup
; label eww's default is show-truncated true, which sets pango's
; EllipsizeMode::End; with the label narrower than its content that ate
; every line down to "…" and, once the window had a width, broke them
; mid-word instead. eww's own doc: disabling it "will completly disable
; truncation on pango markup", which is exactly what a cheatsheet wants -
; a binding shown as "Move focused wo…" tells nobody anything.
(defwidget help-box []
  (box :class "help" :orientation "vertical" :halign "start" :valign "end"
    (label :markup help-text :xalign 0 :wrap false :show-truncated false)))

; :width is not optional. Omitted, eww's geometry defaults to Pixels(0)
; and app.rs calls set_size_request(0, 0), so GTK allocates the minimum
; and every label ellipsizes to a bare "…" - which is what the overlay
; actually shipped as. The height is left to the content: the number of
; keybindings changes with the config, and a fixed height would either
; clip the list or leave a gap under it.
(defwindow help
  :monitor 0
  :stacking "bg"
  :geometry (geometry :x "20px" :y "20px" :width "620px"
                      :anchor "bottom left")
  (help-box))
