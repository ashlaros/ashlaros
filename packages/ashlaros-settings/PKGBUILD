    # in the repository stack, so a package under upstream's own name
    # could never win. Carries the tabbed-layout fix the sway config
    # here needs, because $mod+w then $mod+e leaves a stray tab bar
    # without it (ammgws/autotiling-rs#29)
    'autotiling-rs-ashlaros'
    'way-displays'            # display management; the user unit, the
