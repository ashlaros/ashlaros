# Maintainer: AshlarOS <build@ashlaros.download>

pkgname=ashlaros-branding
pkgver=20260910
pkgrel=1
pkgdesc="AshlarOS logo, wallpaper and palette"
arch=('any')
url="https://github.com/ashlaros/ashlaros"
license=('GPL-3.0-or-later')
# the splash script is generated from logo.txt at build time
makedepends=('python')
# built from branding/ in the monorepo checkout, not from a tarball: the
# assets and the PKGBUILD move together, so a source= would only pin them
# to a release that does not exist yet
source=()

# Content built from outside this directory. Read by
# scripts/discover_packages.py and scripts/package_version.py, which
# otherwise see only the package directory and would never notice an edit
# to branding/ - the package would keep its version and stay skipped.
_source_trees=(branding)

package() {
  local branding="${startdir}/../../branding"

  install -Dm644 "${branding}/logo.svg" "${pkgdir}/usr/share/ashlaros/logo.svg"
  install -Dm644 "${branding}/favicon.svg" "${pkgdir}/usr/share/ashlaros/favicon.svg"
  install -Dm644 "${branding}/background.svg" "${pkgdir}/usr/share/ashlaros/background.svg"
  # the installer's TUI header reads this; see installer/configurator
  install -Dm644 "${branding}/logo.txt" "${pkgdir}/usr/share/ashlaros/logo.txt"
  install -Dm644 "${branding}/palette.conf" "${pkgdir}/usr/share/ashlaros/palette.conf"
  # derives its frames from logo.txt above, so the two ship together
  install -Dm755 "${branding}/ashlaros-logo-animate" \
    "${pkgdir}/usr/bin/ashlaros-logo-animate"

  # The boot splash. Its courses are generated from logo.txt at build time
  # rather than transcribed into the script: plymouth's language has no
  # file I/O, so the rows must be literals, and a literal traced by hand is
  # how a theme drifts from the mark it came from.
  install -d "${pkgdir}/usr/share/plymouth/themes/ashlaros"
  install -Dm644 "${branding}/plymouth/ashlaros.plymouth" \
    "${pkgdir}/usr/share/plymouth/themes/ashlaros/ashlaros.plymouth"
  python3 "${branding}/plymouth/generate-script.py" "${branding}/logo.txt" \
    "${pkgdir}/usr/share/plymouth/themes/ashlaros/ashlaros.script"
  chmod 644 "${pkgdir}/usr/share/plymouth/themes/ashlaros/ashlaros.script"

  # the desktop's wallpaper lookup and os-release's LOGO= both read the
  # freedesktop locations rather than /usr/share/ashlaros
  install -Dm644 "${branding}/background.svg" \
    "${pkgdir}/usr/share/backgrounds/ashlaros/background.svg"
  install -Dm644 "${branding}/logo.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/ashlaros.svg"
}
