#!/bin/bash
# AshlarOS install configurator.
#
# Four screens plus a confirmation, each with its default preselected, so
# Enter-Enter-Enter-Enter-Enter installs. Produces the two JSON files
# archinstall reads (user_configuration.json, user_credentials.json) plus
# the AshlarOS-specific bits the orchestrator needs, and hands off to
# ashlaros-install.
#
# Modelled on omarchy-iso's configurator (MIT); the question flow, the
# archinstall JSON shape and the openssl password hashing are theirs.
set -uo pipefail

ASHLAROS_PATH="${ASHLAROS_PATH:-/usr/share/ashlaros}"
LOGO_PATH="${LOGO_PATH:-$ASHLAROS_PATH/logo.txt}"
OUTPUT_DIR="${OUTPUT_DIR:-/root}"

# gum draws on stderr and measures /dev/tty, so both are addressed directly
# throughout rather than through whatever stdout happens to be.
export GUM_CHOOSE_CURSOR_FOREGROUND="7"
export GUM_CHOOSE_SELECTED_FOREGROUND="15"
export GUM_CONFIRM_SELECTED_BACKGROUND="8"
export GUM_CONFIRM_SELECTED_FOREGROUND="15"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="7"

if [[ ! -r $LOGO_PATH ]]; then
  echo "ashlaros: logo not found at $LOGO_PATH" >&2
  exit 1
fi

LOGO_WIDTH=$(awk '{ if (length > max) max = length } END { print max+0 }' "$LOGO_PATH")

# The console grows after boot - the framebuffer settles late, especially in
# VMs - so remeasure at every redraw rather than trusting startup geometry.
measure_terminal() {
  TERM_WIDTH=$(stty size 2>/dev/null </dev/tty | awk '{print $2}')
  [[ $TERM_WIDTH =~ ^[0-9]+$ ]] && ((TERM_WIDTH > 0)) || TERM_WIDTH=${COLUMNS:-80}

  PADDING_LEFT=$(((TERM_WIDTH - LOGO_WIDTH) / 2))
  ((PADDING_LEFT < 0)) && PADDING_LEFT=0
  PADDING_LEFT_SPACES=$(printf "%*s" "$PADDING_LEFT" "")

  local padding="0 0 0 $PADDING_LEFT"
  export GUM_CHOOSE_PADDING="$padding"
  export GUM_INPUT_PADDING="$padding"
  export GUM_SPIN_PADDING="$padding"
  export GUM_TABLE_PADDING="$padding"
  export GUM_CONFIRM_PADDING="$padding"
}
measure_terminal

clear_logo() {
  measure_terminal
  printf "\033[H\033[2J"
  gum style --foreground 7 --padding "1 0 0 $PADDING_LEFT" "$(<"$LOGO_PATH")"
}

say() {
  gum style --padding "0 0 0 $PADDING_LEFT" "$@"
}

step() {
  clear_logo
  echo
  say "$1"
  echo
}

abort() {
  gum style "${1:-Aborted installation}"
  echo
  gum style "Run 'ashlaros-configurator' to start again."
  exit 1
}

# STEP 1: LOCALE & KEYBOARD

# en_US.UTF-8 with a de keyboard is the EU default: an English system whose
# keyboard matches the hardware most of our users have.
#
# The LAYOUT is what gets chosen, not the console keymap. The desktop is
# sway, which takes an XKB layout; the console keymap is a second namespace
# that only the TTY and the initramfs use. Choosing the console one first
# was backwards - it offered eleven include fragments as if they were
# layouts, and a real install came back with KEYMAP=euro, which is six
# lines binding Alt+E to the euro sign and defines no letters at all.
locale_keymap_form() {
  step "Locale and keyboard"

  local choice
  choice=$(gum choose --header "Layout" --selected "EU (en_US.UTF-8, de keyboard)" \
    "EU (en_US.UTF-8, de keyboard)" \
    "US (en_US.UTF-8, us keyboard)" \
    "EurKEY (en_US.UTF-8, eu keyboard)" \
    "Other...") || abort

  case "$choice" in
  "EU "*)
    locale="en_US.UTF-8"
    layout="de"
    ;;
  "US"*)
    locale="en_US.UTF-8"
    layout="us"
    ;;
  "EurKEY"*)
    # A US layout with the western European letters on AltGr, so one
    # keyboard writes English, German, French and the Nordics without
    # switching. XKB only: xkeyboard-config ships symbols/eu and kbd has
    # no console equivalent, so the TTY falls back below.
    locale="en_US.UTF-8"
    layout="eu"
    ;;
  *)
    # arguments rather than a pipe: gum reads piped choices from stdin and
    # then has to reopen /dev/tty to draw, which fails wherever the process
    # has no controlling terminal. As arguments it uses the fds it was given.
    locale=$(gum choose --header "Locale" --selected "en_US.UTF-8" \
      en_US.UTF-8 en_GB.UTF-8 de_DE.UTF-8 fr_FR.UTF-8 es_ES.UTF-8 \
      it_IT.UTF-8 nl_NL.UTF-8 pt_PT.UTF-8 pl_PL.UTF-8 sv_SE.UTF-8 \
      da_DK.UTF-8 nb_NO.UTF-8 fi_FI.UTF-8 cs_CZ.UTF-8 ja_JP.UTF-8) || abort
    layout=$(xkb_layouts |
      gum filter --header "Keyboard layout" --placeholder "type to filter" --value "de") || abort
    ;;
  esac

  keymap=$(console_keymap_for "$layout")

  # The console keymap is a separate namespace and not every layout has
  # one - `eu` has none at all. Offered rather than assumed, because this
  # is what the TTY, the initramfs and the LUKS passphrase prompt use, and
  # a passphrase typed on the wrong keymap is a disk that will not open.
  if [[ $choice == "Other..." ]] || [[ -z $keymap ]]; then
    keymap=$(localectl list-keymaps 2>/dev/null |
      keymaps_only |
      gum filter --header "Console keymap (TTY, initramfs, disk unlock)" \
        --placeholder "type to filter" --value "${keymap:-us}") || abort
  fi

  # loadkeys only works on a virtual console, not in a terminal emulator
  [[ $(tty 2>/dev/null) == /dev/tty[0-9]* ]] && loadkeys "$keymap" 2>/dev/null

  timezone=$(timedatectl show --property=Timezone --value 2>/dev/null)
  [[ -n $timezone ]] || timezone="UTC"
}

# The XKB layouts sway can load: xkeyboard-config's own registry, plus the
# ones it ships symbols for but does not register. `eu` is the reason that
# second half exists - EurKEY is in symbols/eu and in no rules list, so a
# registry-only reading of "what is supported" leaves it out.
XKB_RULES_LST=/usr/share/X11/xkb/rules/evdev.lst
XKB_SYMBOLS_DIR=/usr/share/X11/xkb/symbols
XKB_UNREGISTERED=(eu)

xkb_layouts() {
  {
    awk '/^! layout/ { inside = 1; next } /^! / { inside = 0 } inside && NF { print $1 }' \
      "$XKB_RULES_LST" 2>/dev/null
    local name
    for name in "${XKB_UNREGISTERED[@]}"; do
      [[ -f $XKB_SYMBOLS_DIR/$name ]] && echo "$name"
    done
  } | sort -u
}

# Fragments dropped. localectl lists everything under the keymap tree, and
# eleven of those live in an include/ directory: they are pieces a layout
# includes, not layouts, and selecting one leaves a console with no
# letters.
keymaps_only() {
  grep -vxE 'euro[12]?|mac-euro2?|applkey|backspace|ctrl|keypad|unicode|windowkeys'
}

# The console keymap that matches an XKB layout, or empty when there is
# none. systemd ships the table localectl itself uses; read backwards,
# because here the layout is known and the keymap is wanted.
console_keymap_for() {
  local layout="$1"
  [[ -r /usr/share/systemd/kbd-model-map ]] || { echo "$layout"; return; }
  awk -v want="$layout" '
    !/^#/ && NF >= 2 && $2 == want { print $1; found = 1; exit }
    END { if (!found) exit 1 }
  ' /usr/share/systemd/kbd-model-map 2>/dev/null || true
}

# STEP 1b: NETWORK

# The ISO carries every package an install needs, so this is optional by
# design: skipping it installs the versions baked into the image. Taking
# it means pacman resolves against the mirrors instead, and the machine
# comes up current rather than as old as the medium.
#
# Offered before the rest because it changes what gets installed, not just
# how: a user who connects here gets today's packages, and one who does
# not still gets a working system.
#
# Ethernet needs nothing - systemd-networkd DHCPs any wired link on its
# own - so this asks only when there is no route yet, and only about
# Wi-Fi, which is the one that cannot configure itself.
network_form() {
  online && return 0
  wireless_device || return 0

  step "Network"
  say "The install medium carries a complete set of packages, so this is"
  say "optional: without a network you get the versions on the image, and"
  say "with one you get today's."
  echo

  gum confirm --affirmative "Connect to Wi-Fi" --negative "Install offline" \
    "Connect to a network?" || return 0

  wifi_connect
}

# Whether anything answers. `ip route` rather than a ping: a machine can
# have a default route and still sit behind a portal, and what matters
# here is only whether pacman has somewhere to try.
online() {
  ip route show default 2>/dev/null | grep -q .
}

# The first wireless interface, or nothing. iwd names its devices after
# the kernel's, so this is the name iwctl wants too.
wireless_device() {
  local device
  for device in /sys/class/net/*/wireless; do
    [[ -e $device ]] || continue
    basename "$(dirname "$device")"
    return 0
  done
  return 1
}

wifi_connect() {
  local device ssid passphrase
  device=$(wireless_device) || return 0

  while true; do
    step "Wi-Fi"

    # iwd scans on its own once the device is up, but a fresh boot has
    # usually not finished one by the time anybody reaches this screen.
    gum spin --title "Scanning for networks..." -- \
      sh -c "iwctl station '$device' scan >/dev/null 2>&1; sleep 3"

    local networks
    networks=$(iwctl station "$device" get-networks 2>/dev/null |
      sed 's/\x1b\[[0-9;]*m//g' |
      awk 'NR > 4 && NF { $NF = ""; $(NF - 1) = ""; sub(/^[[:space:]*>]+/, ""); sub(/[[:space:]]+$/, ""); if (length) print }')

    if [[ -z $networks ]]; then
      say --foreground 1 "No networks found."
      gum confirm --affirmative "Scan again" --negative "Install offline" "" || return 0
      continue
    fi

    ssid=$(printf '%s\n' "$networks" |
      gum filter --header "Network" --placeholder "type to filter") || return 0
    [[ -n $ssid ]] || return 0

    passphrase=$(gum input --password --header "Passphrase for $ssid" \
      --placeholder "leave empty for an open network") || return 0

    local output
    if [[ -n $passphrase ]]; then
      output=$(iwctl --passphrase "$passphrase" station "$device" connect "$ssid" 2>&1)
    else
      output=$(iwctl station "$device" connect "$ssid" 2>&1)
    fi

    # Association is not a route. systemd-networkd still has to DHCP, and
    # reporting success before it does would send the install at mirrors
    # it cannot reach yet.
    if gum spin --title "Getting an address..." -- \
      sh -c 'for _ in $(seq 1 20); do ip route show default | grep -q . && exit 0; sleep 1; done; exit 1'; then
      say "Connected to $ssid."
      # Remembered for the installed system, which runs NetworkManager
      # rather than the ISO's iwd: a user who typed a passphrase to get
      # current packages should not have to type it again at the first
      # desktop login.
      wifi_ssid="$ssid"
      wifi_passphrase="$passphrase"
      sleep 1
      return 0
    fi

    say --foreground 1 "Could not connect to $ssid.${output:+ $output}"
    gum confirm --affirmative "Try again" --negative "Install offline" "" || return 0
  done
}

# STEP 2: USER

user_form() {
  while true; do
    step "Your user account"

    # --value, not --placeholder: a placeholder is not submitted, so Enter
    # on an untouched field yielded an empty username and re-asked. The
    # promise is that Enter alone installs.
    username=$(gum input --header "Username" --value "${username:-user}") || abort
    if [[ ! $username =~ ^[a-z_][a-z0-9_-]*$ ]]; then
      say --foreground 1 "Usernames start with a letter and hold only a-z, 0-9, - and _."
      gum confirm --affirmative "Try again" --negative "Quit" "" || abort
      continue
    fi

    password=$(gum input --password --header "Password" --placeholder "•••••••") || abort
    if [[ -z $password ]]; then
      say --foreground 1 "The password cannot be empty: it also unlocks the disk."
      gum confirm --affirmative "Try again" --negative "Quit" "" || abort
      continue
    fi

    local again
    again=$(gum input --password --header "Password (again)" --placeholder "•••••••") || abort
    if [[ $password != "$again" ]]; then
      say --foreground 1 "The two passwords differ."
      gum confirm --affirmative "Try again" --negative "Quit" "" || abort
      continue
    fi

    break
  done

  hostname=$(gum input --header "Hostname" --value "ashlaros") || abort

  # Autologin is on by default: the disk is encrypted, so the passphrase
  # prompt at boot already is the authentication.
  if gum confirm --affirmative "Keep autologin" --negative "Ask for the password" \
    "Log in automatically?"; then
    autologin=true
  else
    autologin=false
  fi

  # SHA-512 crypt ($6$), which is what openssl passwd offers and what
  # archinstall's enc_password expects
  password_hash=$(printf '%s' "$password" | openssl passwd -6 -stdin)
}

# STEP 3: ENCRYPTION & TPM

encryption_form() {
  step "Disk encryption"

  say "LUKS2 with your user password as the passphrase."
  if tpm_present; then
    say --foreground 8 "A TPM is present, so unlocking it without typing the passphrase is an option."
  else
    say --foreground 8 "No TPM found: you will type the passphrase at every boot."
  fi
  echo

  if gum confirm --affirmative "Encrypt the disk" --negative "No encryption" \
    "Encrypt this installation?"; then
    encrypt=true
  else
    encrypt=false
    tpm_unlock=none
    return
  fi

  tpm_unlock_form
}

# How the disk unlocks, asked rather than decided by hardware detection.
#
# This used to enrol the TPM against PCR 7 whenever one was present, which
# made a machine unlock silently forever because of a chip it happened to
# have (#64). The tradeoff is personal - a desktop that never leaves the
# house and a laptop want different answers - so it is a question, and the
# table is on screen while it is answered rather than in documentation
# somebody reads later.
#
# Asked once, here, because this is the moment the disk is encrypted. It
# stays changeable afterwards: the settings TUI has the same three modes.
tpm_unlock_form() {
  tpm_present || { tpm_unlock=none; return; }

  step "Disk unlock"

  say "                  boot            defends drive   defends whole"
  say "                  experience      theft           machine theft"
  say "  passphrase      full phrase     yes             yes"
  say "  TPM + PIN       short PIN       yes             yes (rate-limited)"
  say "  TPM only        silent          yes             NO"
  echo

  # PCR 7 measures Secure Boot policy. With Secure Boot off - the normal
  # state for a distribution Microsoft has not signed - it holds the same
  # value for any boot media, so TPM-only defends a removed drive and not
  # this machine. Said here because it changes what the silent option is
  # worth on the hardware in front of the user.
  if ! secure_boot_on; then
    say --foreground 3 "Secure Boot is off on this machine, so a TPM-only unlock protects"
    say --foreground 3 "a removed drive but not this laptop or desktop. A PIN closes that."
    echo
  fi

  local choice
  choice=$(gum choose --header "How should this disk unlock?" \
    "Passphrase only - type it every boot" \
    "TPM + PIN - a short PIN every boot" \
    "TPM only - unlock silently")
  case "$choice" in
    "TPM + PIN"*) tpm_unlock=pin ;;
    "TPM only"*) tpm_unlock=tpm ;;
    *) tpm_unlock=none ;;
  esac

  if [[ $tpm_unlock == pin ]]; then
    local pin confirm
    # With autologin nothing is typed at login, so the keyring can only be
    # unlocked with what was typed at boot - and only when that is the
    # password. The installer checks for exactly that before wiring it.
    if [[ $autologin == true ]] &&
      gum confirm --affirmative "Use my password" --negative "A separate PIN" \
        "Use your password as the PIN? It then also unlocks the keyring at login."; then
      tpm_pin=$password
      return 0
    fi
    while true; do
      pin=$(gum input --password --placeholder "PIN" --header "A PIN for unlocking at boot") || continue
      [[ -n $pin ]] || continue
      confirm=$(gum input --password --placeholder "PIN again" --header "Confirm") || continue
      [[ $pin == "$confirm" ]] && break
      say --foreground 1 "Those did not match."
    done
    tpm_pin=$pin
  fi
}

# Read from the firmware variable rather than parsed out of bootctl: the
# efivar is the value itself, one byte, present on any UEFI machine. When
# it cannot be read this answers "off", which warns rather than reassures.
secure_boot_on() {
  local var
  var=$(echo /sys/firmware/efi/efivars/SecureBoot-*)
  [[ -r $var ]] || return 1
  [[ $(od -An -t u1 "$var" 2>/dev/null | awk '{ print $NF }') == "1" ]]
}

tpm_present() {
  # --tpm2-device=list prints a header and one row per device; no rows means
  # no usable TPM, which is not an error, only a fallback to passphrase
  [[ -n $(systemd-cryptenroll --tpm2-device=list 2>/dev/null | tail -n +2) ]]
}

# STEP 4: PARTITION LAYOUT

disk_form() {
  while true; do
    step "Where to install"

    local boot_source exclude_disk
    boot_source=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
    exclude_disk=$(root_disk_of "$boot_source")

    local rows
    mapfile -t rows < <(lsblk -dpno NAME,SIZE,MODEL,TYPE |
      awk '$NF=="disk"{ $NF=""; print }' |
      grep -E '^/dev/(sd|hd|vd|nvme|mmcblk|xv)' |
      { if [[ -n $exclude_disk ]]; then grep -Fv "$exclude_disk " || true; else cat; fi; })

    if ((${#rows[@]} == 0)); then
      abort "No installable disk found."
    fi

    local selected
    selected=$(gum choose --header "Install disk" "${rows[@]}") || abort
    disk=$(awk '{print $1}' <<<"$selected")

    layout=$(gum choose --header "Layout for $disk" --selected "Erase disk (btrfs)" \
      "Erase disk (btrfs)" \
      "Erase disk (ext4)" \
      "Open cfdisk, then re-detect") || abort

    case "$layout" in
    "Open cfdisk"*)
      clear
      cfdisk "$disk" || true
      partprobe "$disk" 2>/dev/null || true
      sync
      continue
      ;;
    "Erase disk (ext4)") filesystem="ext4" ;;
    *) filesystem="btrfs" ;;
    esac

    return 0
  done
}

# The whole-disk device a partition belongs to, so the live medium is not
# offered as a target.
root_disk_of() {
  local source="$1"
  [[ -n $source ]] || return 0
  local name
  name=$(lsblk -no PKNAME "$source" 2>/dev/null | head -n1)
  [[ -n $name ]] && echo "/dev/$name" || echo "$source"
}

# CONFIRM

# What the summary line says, from the choice rather than from whether a
# TPM happens to be in the machine.
encryption_summary() {
  [[ $encrypt == true ]] || { echo "none"; return; }
  case "$tpm_unlock" in
    pin) echo "LUKS2 + TPM and a PIN" ;;
    tpm) echo "LUKS2 + TPM, unlocks silently" ;;
    *) echo "LUKS2, passphrase every boot" ;;
  esac
}

confirm_form() {
  clear_logo
  echo
  printf 'Field,Value\nUser,%s\nHostname,%s\nAutologin,%s\nLocale,%s\nKeyboard,%s\nConsole keymap,%s\nTimezone,%s\nDisk,%s\nFilesystem,%s\nEncryption,%s\n' \
    "$username" "$hostname" "$autologin" "$locale" "$layout" "$keymap" "$timezone" \
    "$disk" "$filesystem" "$(encryption_summary)" |
    gum table -s "," -p | sed "s/^/${PADDING_LEFT_SPACES}/"
  echo
  say --foreground 1 "Everything on $disk will be erased. There is no recovery."
  echo

  gum confirm --affirmative "Install" --negative "Start over" "Install AshlarOS?"
}

# OUTPUT

# archinstall keys the encryption config to a partition by obj_id, so the
# root partition's id is fixed here and referenced from disk_encryption.
ROOT_OBJ_ID="6f2b1c94-0e1d-4a77-9f3e-2c5d8b7a4e10"
ESP_OBJ_ID="0b7d4c31-58a2-4e69-8c0f-1d6a9b3e5f27"

write_config() {
  local esp_start=$((1024 * 1024))
  local esp_size=$((1024 * 1024 * 1024)) # 1 GiB ESP, per the plan
  local disk_size root_start root_size

  # a failed blockdev leaves disk_size empty, and the arithmetic below then
  # yields a negative root partition that archinstall accepts and parted
  # rejects halfway through the wipe
  if ! disk_size=$(blockdev --getsize64 "$disk" 2>&1); then
    abort "Could not read the size of $disk: $disk_size"
  fi
  [[ $disk_size =~ ^[0-9]+$ ]] || abort "$disk reported a nonsensical size: $disk_size"

  root_start=$((esp_start + esp_size))
  # Rounded DOWN to a mebibyte, after leaving one for the GPT backup
  # header. Both partitions start on a MiB boundary already, but the root
  # SIZE came straight off blockdev, so its end landed wherever the disk
  # happened to end - and a real disk is not a round number. parted warns
  # "Partition is misaligned" and archinstall stops there, which is how
  # this failed on a 512110190592-byte NVMe.
  #
  # Invisible in test/vm: the harness qcow2 is exactly 20 GiB, so every
  # boundary divides cleanly and the bug cannot appear there.
  #
  # The lost bytes are under a mebibyte on a disk of hundreds of gigabytes.
  # An end that a 4Kn drive can address is worth more than they are.
  root_size=$(((disk_size - root_start - 1024 * 1024) / (1024 * 1024) * (1024 * 1024)))

  # 1 GiB ESP plus a root worth having; below this the install fills the
  # disk and fails at a random package instead of here
  ((root_size >= 8 * 1024 * 1024 * 1024)) ||
    abort "$disk is too small: AshlarOS needs at least 10 GiB."

  local btrfs_volumes="[]"
  local mount_options="[]"
  local root_mountpoint='"/"'
  if [[ $filesystem == btrfs ]]; then
    btrfs_volumes='[
                            { "mountpoint": "/", "name": "@" },
                            { "mountpoint": "/home", "name": "@home" },
                            { "mountpoint": "/var/log", "name": "@log" },
                            { "mountpoint": "/var/cache/pacman/pkg", "name": "@pkg" }
                        ]'
    mount_options='[ "compress=zstd" ]'
    # subvolumes carry the mountpoints, so the partition itself has none
    root_mountpoint="null"
  fi

  local encryption_config=""
  if [[ $encrypt == true ]]; then
    encryption_config=",
        \"disk_encryption\": {
            \"encryption_type\": \"luks\",
            \"lvm_volumes\": [],
            \"iter_time\": 2000,
            \"partitions\": [ \"$ROOT_OBJ_ID\" ],
            \"encryption_password\": $(printf '%s' "$password" | jq -Rsa .)
        }"
  fi

  cat >"$OUTPUT_DIR/user_configuration.json" <<-EOF
	{
	    "app_config": null,
	    "archinstall-language": "English",
	    "auth_config": {},
	    "audio_config": { "audio": "pipewire" },
	    "bootloader_config": { "bootloader": "Systemd-boot", "uki": false, "removable": false },
	    "custom_commands": [],
	    "ashlaros_install": {
	        "target_mount": "/mnt",
	        "autologin": $autologin,
	        "username": "$username",
	        "encrypt": $encrypt,
	        "tpm_unlock": "$tpm_unlock",
	        "filesystem": "$filesystem",
	        "root_obj_id": "$ROOT_OBJ_ID",
	        "boot": { "esp_mount": "/boot" },
	        "xkb_layout": "$layout"
	    },
	    "disk_config": {
	        "config_type": "default_layout",
	        "device_modifications": [
	            {
	                "device": "$disk",
	                "partitions": [
	                    {
	                        "btrfs": [],
	                        "dev_path": null,
	                        "flags": [ "boot", "esp" ],
	                        "fs_type": "fat32",
	                        "mount_options": [],
	                        "mountpoint": "/boot",
	                        "obj_id": "$ESP_OBJ_ID",
	                        "size": {
	                            "sector_size": { "unit": "B", "value": 512 },
	                            "unit": "B",
	                            "value": $esp_size
	                        },
	                        "start": {
	                            "sector_size": { "unit": "B", "value": 512 },
	                            "unit": "B",
	                            "value": $esp_start
	                        },
	                        "status": "create",
	                        "type": "primary"
	                    },
	                    {
	                        "btrfs": $btrfs_volumes,
	                        "dev_path": null,
	                        "flags": [],
	                        "fs_type": "$filesystem",
	                        "mount_options": $mount_options,
	                        "mountpoint": $root_mountpoint,
	                        "obj_id": "$ROOT_OBJ_ID",
	                        "size": {
	                            "sector_size": { "unit": "B", "value": 512 },
	                            "unit": "B",
	                            "value": $root_size
	                        },
	                        "start": {
	                            "sector_size": { "unit": "B", "value": 512 },
	                            "unit": "B",
	                            "value": $root_start
	                        },
	                        "status": "create",
	                        "type": "primary"
	                    }
	                ],
	                "wipe": true
	            }
	        ]$encryption_config
	    },
	    "hostname": "$hostname",
	    "kernels": [ "linux-cachyos" ],
	    "network_config": { "type": "iso" },
	    "ntp": true,
	    "parallel_downloads": 8,
	    "script": null,
	    "services": [],
	    "swap": true,
	    "timezone": "$timezone",
	    "locale_config": {
	        "kb_layout": "$keymap",
	        "sys_enc": "UTF-8",
	        "sys_lang": "$locale"
	    },
	    "mirror_config": {
	        "custom_repositories": [],
	        "custom_servers": [],
	        "mirror_regions": {},
	        "optional_repositories": []
	    },
	    "packages": [
	        "base-devel",
	        "git",
	        "chwd",
	        "ashlaros-keyring",
	        "ashlaros-mirrorlist",
	        "ashlaros-release",
	        "ashlaros-settings"
	    ],
	    "profile_config": {
	        "gfx_driver": null,
	        "greeter": null,
	        "profile": {}
	    },
	    "version": "3.0.9"
	}
	EOF

  local hash_json password_json
  hash_json=$(printf '%s' "$password_hash" | jq -Rsa .)
  password_json=$(printf '%s' "$password" | jq -Rsa .)

  # groups: input, so way-displays can read the laptop lid switch through
  # libinput - without it the lid-closed rule in its cfg.yaml never fires.
  # The trade is real and worth stating: input grants read access to
  # /dev/input/*, which is every keystroke on the machine. This user is
  # already sudo, and this installer builds single-user machines, so it
  # concedes nothing that was not already conceded. It would matter on a
  # multi-user box; we do not build one.
  # 077 before the write, not chmod after it: the heredoc below contains the
  # plaintext LUKS passphrase, and between creating the file and chmod'ing
  # it the content sits at whatever the umask allows. /root is 750 on the
  # live ISO so the window is small, but OUTPUT_DIR is overridable and the
  # ISO runs a browser session on tty2.
  local previous_umask
  previous_umask=$(umask)
  umask 077
  cat >"$OUTPUT_DIR/user_credentials.json" <<-EOF
	{
	    "root_enc_password": $hash_json,
	    "users": [
	        {
	            "username": "$username",
	            "enc_password": $hash_json,
	            "groups": ["input"],
	            "sudo": true
	        }
	    ]$([[ $encrypt == true ]] && printf ',\n    "encryption_password": %s' "$password_json")$([[ -n $tpm_pin ]] && printf ',\n    "tpm_pin": %s' "$(printf '%s' "$tpm_pin" | jq -Rsa .)")$([[ -n $wifi_ssid ]] && printf ',\n    "wifi": { "ssid": %s, "passphrase": %s }' "$(printf '%s' "$wifi_ssid" | jq -Rsa .)" "$(printf '%s' "$wifi_passphrase" | jq -Rsa .)")
	}
	EOF

  umask "$previous_umask"
  # belt and braces: the umask above governs creation, this governs a file
  # that already existed from an earlier run
  chmod 600 "$OUTPUT_DIR/user_credentials.json"
}

# MAIN

username=""
autologin=true
encrypt=true
# asked in tpm_unlock_form; none means the passphrase is the only key, and
# it is what a machine with no TPM gets without being asked
tpm_unlock=none
tpm_pin=""
filesystem="btrfs"
# set by wifi_connect when a network was joined, and carried into the
# installed system so the first desktop login is already online
wifi_ssid=""
wifi_passphrase=""

while true; do
  locale_keymap_form
  network_form
  user_form
  encryption_form
  disk_form
  confirm_form && break
done

write_config

if [[ ${1:-} == "--dry-run" ]]; then
  step "Dry run: configuration written, nothing installed"
  say "$OUTPUT_DIR/user_configuration.json"
  say "$OUTPUT_DIR/user_credentials.json"
  exit 0
fi
