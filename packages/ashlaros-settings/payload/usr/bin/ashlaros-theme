#!/bin/bash
set -u

## theme switcher for ashlaros
THEME_DIR="/usr/share/sway/themes"

prompt() {
    read -r -p "-> Press enter to continue..."
}

install() {
    [ -f "$1/packages" ] || return
    local missing_pkgs
    # the file is one package per line and pacman -T takes them as
    # separate arguments, so the split is the point
    local -a wanted
    mapfile -t wanted < "$1/packages"
    missing_pkgs=$(pacman -T "${wanted[@]}" 2>/dev/null)
    if [ -n "$missing_pkgs" ]; then
        echo "> Installing theme requirements"
        # shellcheck disable=SC2086
        foot --app-id floating_shell --window-size-chars 82x25 \
            sudo pacman -S --needed $missing_pkgs
    fi
}

# Can this theme's packages be installed at all on this machine?
#
# Offering a theme that cannot finish is the failure #56 describes: the
# catppuccin themes named AUR-only packages, so on ARM - where no AUR
# helper has an aarch64 build - picking one applied the sway colours and
# then asked for something the machine could not get. Every theme package
# is in a repository now, ours or Arch's, but the check stays: it is what
# keeps that from silently returning if a theme ever names something new.
installable() {
    local dir=$1
    [ -f "$dir/packages" ] || return 0

    local -a wanted
    mapfile -t wanted < "$dir/packages"

    local missing
    missing=$(pacman -T "${wanted[@]}" 2>/dev/null) || true
    [ -n "$missing" ] || return 0

    local pkg
    while read -r pkg; do
        [ -n "$pkg" ] || continue
        pacman -Si "$pkg" >/dev/null 2>&1 || return 1
    done <<< "$missing"
    return 0
}

THEMES=""
while read -r theme; do
    [ -n "$theme" ] || continue
    installable "${THEME_DIR}/${theme}" || continue
    THEMES="${THEMES}${theme}"$'\n'
done <<< "$(find "${THEME_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)"
THEMES=${THEMES%$'\n'}

if [ -z "$THEMES" ]; then
    echo "> No theme on this machine can install its packages."
    prompt
    exit 1
fi

DARK_THEME=$(echo "$THEMES" | rofi -dmenu -p "Select day theme")
DARK_THEME_DIR="${THEME_DIR}/${DARK_THEME}"
install "$DARK_THEME_DIR"

LIGHT_THEME=$(echo "$THEMES" | rofi -dmenu -p "Select night theme")
LIGHT_THEME_DIR="${THEME_DIR}/${LIGHT_THEME}"
install "$LIGHT_THEME_DIR"

# The day theme becomes the active one; the night theme is stashed beside
# it under the name theme-toggle.sh looks for. Those names are load-bearing
# in both directions there - it reads them to decide which theme is live
# and writes them back when toggling - so "light" is not a label here, it
# is the other half of a contract.
ACTIVE_THEME_DIR=$DARK_THEME_DIR
STASHED_THEME="light"
STASHED_THEME_DIR=$LIGHT_THEME_DIR

# copy the sway theme
[ -f "$ACTIVE_THEME_DIR/theme.conf" ] && /usr/bin/cp --backup -v "$ACTIVE_THEME_DIR/theme.conf" "$HOME/.config/sway/definitions.d/theme.conf" && swaymsg reload
[ -f "$STASHED_THEME_DIR/theme.conf" ] && /usr/bin/cp --backup -v "$STASHED_THEME_DIR/theme.conf" "$HOME/.config/sway/definitions.d/theme.${STASHED_THEME}.conf_"

# Copy the foot themes. Unlike sway, foot-theme.ini is not one of the pair:
# theme-toggle.sh regenerates it from both .dark. and .light. halves, so
# writing it here would be undone by the first toggle. Write the halves and
# let the toggle merge them.
[ -f "$ACTIVE_THEME_DIR/foot-theme.ini" ] && /usr/bin/cp --backup -v "$ACTIVE_THEME_DIR/foot-theme.ini" "$HOME/.config/foot/foot-theme.dark.ini_"
[ -f "$STASHED_THEME_DIR/foot-theme.ini" ] && /usr/bin/cp --backup -v "$STASHED_THEME_DIR/foot-theme.ini" "$HOME/.config/foot/foot-theme.${STASHED_THEME}.ini_"
# the active terminal colours, merged from the two halves just written
/usr/share/sway/scripts/theme-toggle.sh merge-foot 2>/dev/null || true
