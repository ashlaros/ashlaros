# Maintainer: Alexander Courtis <alex@courtis.org>
pkgname=way-displays
pkgver=2.0.1
pkgrel=1
pkgdesc="way-displays: Auto Manage Your Wayland Displays"
arch=('x86_64' 'aarch64')
url="https://github.com/alex-courtis/way-displays"
license=('MIT')
depends=('wayland' 'libinput' 'libyaml')
makedepends=('git' 'make' 'gcc')
source=("https://github.com/alex-courtis/${pkgname}/archive/refs/tags/${pkgver}.tar.gz"
        'va_list-aarch64.patch')
sha256sums=('5845837370d676165a60b2c85763ac8aaa06d3acfc274fc48fdbe56aa602fe15'
            '18276043b841daed79825d5c6cdd017ad02bfed15c6cc0b5c7eb3feaa5f85e2a')
install=way-displays.install

prepare() {
	cd "$pkgname-$pkgver"
	# upstream tests a va_list for truthiness, which only compiles where
	# va_list is a pointer. On aarch64 it is an array type and the build
	# fails - so without this the package is absent from the aarch64
	# repository while the build leg still reports success.
	patch -p1 < "$srcdir/va_list-aarch64.patch"
}

build() {
	cd "$pkgname-$pkgver"
	make CC=gcc CXX=g++ way-displays
}

package() {
	cd "$pkgname-$pkgver"
	make PREFIX="/usr" PREFIX_ETC="" DESTDIR="$pkgdir" install
}

