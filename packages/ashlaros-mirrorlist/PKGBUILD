# Maintainer: AshlarOS <build@ashlaros.download>

# rebuilt once when source_hash began covering the executable bit
pkgname=ashlaros-mirrorlist
pkgver=20260910
pkgrel=1
pkgdesc="AshlarOS repository mirrorlist"
arch=('any')
url="https://github.com/ashlaros/ashlaros"
license=('GPL-3.0-or-later')
# a mirrorlist pacman would overwrite on upgrade is a mirrorlist the user
# cannot edit; backup keeps their version and drops a .pacnew beside it
backup=('etc/pacman.d/ashlaros-mirrorlist')
source=('ashlaros-mirrorlist')
sha256sums=('500ed4880eec7ce3cd58c2146eea7bd7b8ec82f307293bc9be6f930e8a9b8fb0')
package() {
  install -Dm644 ashlaros-mirrorlist "${pkgdir}/etc/pacman.d/ashlaros-mirrorlist"
}
