#!/usr/bin/env bash
#
# Bring an existing $HOME up to date with config we have changed since it
# was created.
#
# /etc/skel is copied once, at user creation, and never again - so every
# change to a shipped config file reaches new installs only, and the two
# diverge silently. Editing a file under payload/ and committing is the
# whole release process here, which makes that divergence cheap to create
# and invisible afterwards.
#
# Each migration is a script in MIGRATIONS_DIR, named for the epoch second
# it was written. Timestamps rather than sequence numbers: two branches
# adding a migration must not collide on a name.
#
# The marker is per-user, under $HOME, because what is being migrated is
# per-user. A system-wide marker would run a migration for whoever logs in
# first and skip everyone else on the machine.
#
# This runs at login and must never prevent one: a migration that fails is
# a logged failure, and an unmarked one that will be retried, not a session
# that does not start.
set -uo pipefail

MIGRATIONS_DIR="${ASHLAROS_MIGRATIONS:-/usr/share/ashlaros/migrations}"
STATE_DIR="${ASHLAROS_MIGRATION_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ashlaros/migrations}"

usage() {
    cat <<'EOF'
usage: ashlaros-migrate [--pending]

Runs migrations that have not run for this user yet.

  --pending   list what would run, and run nothing
EOF
}

# Sorted by name, which sorts by time because the names are timestamps.
# A migration that has never completed for this user has no marker.
pending() {
    [ -d "$MIGRATIONS_DIR" ] || return 0
    local path name
    for path in "$MIGRATIONS_DIR"/*.sh; do
        [ -f "$path" ] || continue
        name=$(basename "$path")
        [ -e "$STATE_DIR/$name" ] || printf '%s\n' "$path"
    done
}

run_pending() {
    local path name failed=0
    while read -r path; do
        [ -n "$path" ] || continue
        name=$(basename "$path")
        # captured before anything else runs: $? inside the else branch is
        # whatever the branch itself last did, not the migration
        bash "$path"
        local status=$?
        if [ "$status" -eq 0 ]; then
            # marked only on success, so a failure is retried at the next
            # login rather than silently skipped forever
            : > "$STATE_DIR/$name"
        else
            printf 'ashlaros-migrate: %s failed (exit %s), will retry\n' \
                "$name" "$status" >&2
            failed=1
        fi
    done < <(pending)
    return "$failed"
}

main() {
    case "${1:-}" in
        --pending)
            local path
            while read -r path; do
                [ -n "$path" ] || continue
                printf '%s\n' "$(basename "$path")"
            done < <(pending)
            return 0
            ;;
        -h | --help)
            usage
            return 0
            ;;
        '') ;;
        *)
            usage >&2
            return 2
            ;;
    esac

    mkdir -p "$STATE_DIR" || return 1
    run_pending
}

main "$@"
