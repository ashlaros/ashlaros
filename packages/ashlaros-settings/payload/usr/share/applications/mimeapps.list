[Default Applications]
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
application/x-extension-htm=firefox.desktop
application/x-extension-html=firefox.desktop
application/x-extension-shtml=firefox.desktop
application/x-extension-xhtml=firefox.desktop
application/x-extension-xht=firefox.desktop
audio/x-ms-asx=mplayer.desktop
audio/x-ms-wma=mplayer.desktop
audio/mp2=mplayer.desktop
audio/x-mpegurl=mplayer.desktop
audio/ogg=mplayer.desktop
audio/x-scpls=mplayer.desktop
audio/mpeg=mplayer.desktop
audio/x-wav=mplayer.desktop
audio/aac=mplayer.desktop
audio/mp4=mplayer.desktop
audio/vnd.rn-realaudio=mplayer.desktop
image/x-portable-anymap=imv.desktop
image/jpeg=imv.desktop
image/x-xbitmap=imv.desktop
image/tiff=imv.desktop
image/gif=imv.desktop
image/vnd.zbrush.pcx=imv.desktop
image/heif=imv.desktop
image/png=imv.desktop
image/x-portable-bitmap=imv.desktop
image/x-tga=imv.desktop
image/bmp=imv.desktop
image/x-portable-graymap=imv.desktop
image/x-portable-pixmap=imv.desktop
inode/directory=pcmanfm-qt.desktop
# vim.desktop is the package's own file and carries Terminal=true, which
# libfm.conf honours through xdg-terminal-exec - so a double click opens a
# terminal with the file in it rather than nothing at all.
text/x-c++src=vim.desktop
text/x-pascal=vim.desktop
text/x-c++hdr=vim.desktop
# firefox already owns every other html-shaped type above; an editor here
# was inherited from a list that predates that
text/html=firefox.desktop
text/plain=vim.desktop
# vim.desktop declares text/x-tcl; this is the same thing spelled the way
# shared-mime-info emits it
text/tcl=vim.desktop
text/x-csrc=vim.desktop
text/x-makefile=vim.desktop
text/x-chdr=vim.desktop
text/x-tex=vim.desktop
text/x-java=vim.desktop
text/x-moc=vim.desktop
video/3gpp=mplayer.desktop
video/ogg=mplayer.desktop
video/quicktime=mplayer.desktop
video/x-ms-wmv=mplayer.desktop
video/vnd.rn-realvideo=mplayer.desktop
video/mp4=mplayer.desktop
