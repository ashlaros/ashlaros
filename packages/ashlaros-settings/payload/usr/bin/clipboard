#!/bin/bash
# The clipboard history picker, and the one place it is implemented.
#
# This used to be an fzf variant with no callsites: every launched reference
# - the sway bind at modes/default:17 and both waybar clicks - resolved to a
# menu one-liner in etc/sway/definitions, so the script shipped, was
# chmod 755'd and was reachable only by typing `clipboard` in a shell. The
# duplication was original rather than drift; both landed in the squashed
# initial commit.
#
# The desktop's menu wins on merit as well as usage: fuzzel is a hard
# depend where fzf is an optdepend listed for zsh's ^R/^T, it needs no
# terminal, and it matches the idiom capture-ask.sh already names -
# "$clipboard and inhibit-idle use the same shape". The body lives here
# rather than in the sway variable because the Ctrl+S branch needs `case
# $?`, which a `set` line cannot express.
#
# No font or colours here: fuzzel reads them from ~/.config/fuzzel, which
# generate-fuzzel-config.sh writes from the theme.
set -uo pipefail

if [[ ${1:-} == --delete ]]; then
  cliphist list |
    fuzzel --dmenu --prompt "Delete: " |
    cliphist delete
  exit 0
fi

# Ctrl+S sends the entry to a Tailscale device instead of copying it.
# Offered only when tailscale is installed, so the hint never promises
# something that cannot happen. fuzzel's custom-1 leaves accept(0) and
# cancel(1) alone and returns 10; bound by --override for this menu only,
# since in fuzzel.ini it would be Ctrl+S in every menu. Ctrl+S is otherwise
# unbound in fuzzel, so nothing is shadowed.
prompt="Copy: "
custom=()
if command -v tailscale >/dev/null && command -v taildrop-send >/dev/null; then
  prompt="Copy (Ctrl+S sends): "
  custom=(--override=key-bindings.custom-1=Control+s)
fi

selection=$(cliphist list | fuzzel --dmenu "${custom[@]}" --prompt "$prompt")
case $? in
  0) printf '%s' "$selection" | cliphist decode | wl-copy ;;
  10) printf '%s' "$selection" | cliphist decode | taildrop-send ;;
  *) exit 0 ;;
esac
