#!/usr/bin/env bash
# One entry point for the settings that are otherwise commands you have to
# know: localectl, timedatectl, chwd, the kernel variants in the cachyos
# repository.
#
# A launcher, not a control panel. Every entry either runs an existing tool
# or collects input and runs one command; the menu owns no settings logic
# of its own. If an entry grows past that, it belongs in its own tool with
# its own issue - which is what way-displays got.
#
# gum and the padding conventions are the installer's (installer/
# configurator); this deliberately does not invent a second TUI style.
#
# Privileges are taken per action rather than by running the whole thing
# under sudo: a long-running root TUI on a desktop is a bigger blast radius
# than it needs, and the installed user is a sudoer, so a prompt is
# expected where one is due.
set -uo pipefail

# Who this actually is, asked of the kernel rather than the environment.
# $USER is just an exported string: `USER=root ashlaros-settings-tui` makes
# every enrolment below target an account this is not, and a face model
# enrolled against the wrong user is a PAM rule that never matches - or one
# that matches for somebody else.
ME=$(id -un)

export GUM_CHOOSE_CURSOR_FOREGROUND="7"
export GUM_CHOOSE_SELECTED_FOREGROUND="15"
export GUM_CONFIRM_SELECTED_BACKGROUND="8"
export GUM_CONFIRM_SELECTED_FOREGROUND="15"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="7"

PADDING_LEFT=2
padding() {
  local p="0 0 0 $PADDING_LEFT"
  export GUM_CHOOSE_PADDING="$p" GUM_INPUT_PADDING="$p" GUM_CONFIRM_PADDING="$p"
  export GUM_FILTER_PADDING="$p"
}
padding

say() { gum style --padding "0 0 0 $PADDING_LEFT" "$@"; }
warn() { gum style --foreground 3 --padding "0 0 0 $PADDING_LEFT" "$@"; }
oops() { gum style --foreground 1 --padding "0 0 0 $PADDING_LEFT" "$@"; }

screen() {
  printf '\033[H\033[2J'
  say "$1"
  echo
}

pause() {
  echo
  gum confirm --affirmative "Back" --negative "" "" >/dev/null 2>&1
}

# A username in a URL is an email address more often than not, and the @
# in it ends the userinfo component - so aerc parses the domain as part of
# the host and the account never connects. Percent-encoding is the fix the
# URL grammar already provides.
url_escape() {
  # LC_ALL=C so the loop walks bytes: percent-encoding is defined over
  # octets, and a character-wise loop encodes U+00FC as %FC rather than
  # the %C3%BC a server is expecting.
  local s=$1 out="" i c
  local LC_ALL=C
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c" && out+=$c ;;
    esac
  done
  printf '%s' "$out"
}

# Creates a config file private BEFORE anything is written into it.
#
# `{ ... } > file` creates it with the user's umask, which is 022 on a
# fresh install - so a file holding a password or a refresh token exists
# world-readable for as long as the block takes to write, and the chmod
# afterwards closes a door that was already open. Touching it first makes
# the private mode the mode it is created with.
private_file() {
  local path=$1
  mkdir -p "$(dirname "$path")"
  [[ -e $path ]] || : > "$path"
  chmod 600 "$path"
}

# Runs a command as root and reports rather than failing silently: a
# permission error that prints nothing is indistinguishable from a setting
# that did not take.
root_run() {
  local out
  if ! out=$(sudo "$@" 2>&1); then
    oops "That needed root and did not succeed:"
    say "${out:-no output}"
    return 1
  fi
  [[ -n $out ]] && say "$out"
  return 0
}

# 1. LOCALE AND KEYBOARD
#
# localectl is the mechanism #14 settled on: it writes
# /etc/X11/xorg.conf.d/00-keyboard.conf, which keyboard.sh reads at sway
# startup. Setting it here and re-running that script is what makes the
# change reach the session that is already running, rather than the next
# login.
keyboard_menu() {
  local layout
  screen "Keyboard layout"
  say "Current: $(localectl status | sed -n 's/.*X11 Layout: *//p' | head -1)"
  echo

  layout=$(localectl list-x11-keymap-layouts 2>/dev/null |
    gum filter --header "Layout" --placeholder "type to filter") || return 0
  [[ -n $layout ]] || return 0

  root_run localectl set-x11-keymap "$layout" || { pause; return 0; }

  # the running session, not just the next one
  if [[ -x /usr/share/sway/scripts/keyboard.sh ]] && [[ -n ${SWAYSOCK:-} ]]; then
    /usr/share/sway/scripts/keyboard.sh >/dev/null 2>&1
    say "Applied to this session too."
  fi

  # A user's own config.d wins by design - keyboard.sh leaves a layout it
  # finds there alone - so say so rather than letting the setting look
  # ignored.
  if grep -rqs 'xkb_layout' "$HOME/.config/sway/config.d/" 2>/dev/null; then
    warn "Your sway config.d sets xkb_layout, and that wins over this."
  fi
  pause
}

locale_menu() {
  local locale
  screen "System locale"
  say "Current: $(localectl status | sed -n 's/.*System Locale: *//p' | head -1)"
  echo
  locale=$(localectl list-locales 2>/dev/null |
    gum filter --header "Locale" --placeholder "type to filter") || return 0
  [[ -n $locale ]] || return 0
  root_run localectl set-locale "LANG=$locale"
  say "Takes effect for programs started after this."
  pause
}

# 2. DISPLAYS - dispatch, never a second display UI
displays_entry() {
  if command -v ashlaros-displays >/dev/null; then
    ashlaros-displays
  else
    screen "Displays"
    warn "ashlaros-displays is not installed."
    pause
  fi
}

# 3. KERNELS
#
# Install only. Which kernel boots is systemd-boot's own menu, which
# already lists every entry - and choosing there cannot leave a machine
# unbootable, while rewriting loader entries here could.
#
# The check after install is the point: a kernel package ships nothing in
# /boot, only usr/lib/modules/<kver>/vmlinuz, and mkinitcpio's alpm hook
# copies it only if a preset named for the pkgbase exists. Without one,
# nothing lands in /boot and the machine gains a silently unbootable entry.
kernel_menu() {
  local choice kernels
  screen "Kernels"
  say "Installed: $(pacman -Qq 2>/dev/null | grep -c '^linux-cachyos') cachyos kernel package(s)"
  echo
  say "This installs a kernel. Which one boots is chosen in the boot menu,"
  say "where every entry is already listed."
  echo

  # Headers are filtered from the LIST because they are not a kernel to
  # choose - but they are installed WITH whichever kernel is chosen, below.
  kernels=$(pacman -Sl cachyos 2>/dev/null |
    awk '$2 ~ /^linux-cachyos/ && $2 !~ /-(headers|dbg)$/ {print $2}' | sort -u)
  if [[ -z $kernels ]]; then
    warn "The cachyos repository is not reachable, so nothing can be listed."
    pause
    return 0
  fi

  # shellcheck disable=SC2086
  # word splitting is the point: one choice per kernel
  choice=$(gum choose --header "Install" $kernels "Cancel") || return 0
  [[ $choice == Cancel ]] && return 0

  if pacman -Qq "$choice" >/dev/null 2>&1; then
    say "$choice is already installed."
    pause
    return 0
  fi

  gum confirm --affirmative "Install" --negative "Cancel" \
    "Install $choice?" || return 0

  screen "Installing $choice"
  # Always with its headers. DKMS rebuilds every registered module when a
  # headers package lands - that is what the alpm hook triggers on - so a
  # kernel installed without them gets no ddcci module, makes no attempt,
  # and reports nothing. Brightness would simply stop working on that
  # kernel, which is the same class of silent breakage this entry's own
  # /boot check exists to catch.
  local headers="$choice-headers"
  if pacman -Si "$headers" >/dev/null 2>&1; then
    root_run pacman -S --noconfirm --needed "$choice" "$headers" ||
      { pause; return 0; }
  else
    warn "$headers is not in the repository; installing the kernel alone."
    warn "DKMS modules will not build for it."
    root_run pacman -S --noconfirm --needed "$choice" || { pause; return 0; }
  fi

  verify_kernel "$choice"
  pause
}

# The check that keeps this entry from leaving a machine with an entry that
# does not boot. Reported, never repaired: writing a preset for a kernel we
# did not package is guesswork, and a wrong one is worse than an absent one.
verify_kernel() {
  local pkgbase=$1 ok=1
  echo
  if [[ -f /etc/mkinitcpio.d/$pkgbase.preset ]]; then
    say "✓ /etc/mkinitcpio.d/$pkgbase.preset"
  else
    oops "✗ no /etc/mkinitcpio.d/$pkgbase.preset"
    oops "  without it mkinitcpio copies no kernel into /boot"
    ok=0
  fi

  if compgen -G "/boot/vmlinuz-$pkgbase*" >/dev/null; then
    say "✓ a kernel image is in /boot"
  else
    oops "✗ nothing matching /boot/vmlinuz-$pkgbase"
    ok=0
  fi

  if grep -rqs "$pkgbase" /boot/loader/entries/ 2>/dev/null; then
    say "✓ a loader entry names it"
  else
    warn "! no loader entry names $pkgbase yet"
    warn "  systemd-boot will not offer it until one exists"
    ok=0
  fi

  verify_dkms "$pkgbase"

  ((ok)) || oops "Do not reboot expecting this kernel until the above is fixed."
}

# Whether the out-of-tree modules exist for a kernel, reported beside the
# preset and vmlinuz checks because it is the same kind of failure: a DKMS
# build that fails is a warning inside a pacman transaction that scrolls
# past, and the user meets it later as "brightness stopped working" - a
# symptom that points nowhere near a kernel module.
#
# Reported, never repaired, like everything else here.
verify_dkms() {
  local pkgbase=$1 kver
  command -v dkms >/dev/null || return 0

  # dkms keys its status on the kernel VERSION, not the package name, and
  # the package is what was just installed - so the version comes from what
  # the package put on disk.
  kver=$(pacman -Ql "$pkgbase" 2>/dev/null |
    sed -n 's|.*/usr/lib/modules/\([^/]*\)/vmlinuz$|\1|p' | head -1)
  [[ -n $kver ]] || return 0

  local registered
  registered=$(dkms status 2>/dev/null | grep -c .) || true
  ((registered > 0)) || return 0

  if dkms status -k "$kver" 2>/dev/null | grep -q "installed"; then
    say "✓ dkms modules built for $kver"
  else
    oops "✗ no dkms module is installed for $kver"
    oops "  $(dkms status 2>/dev/null | head -1) is registered but did not build here"
    oops "  external monitor brightness will not work on this kernel"
  fi
}

# 4. PACKAGES - guarded and hidden rather than visible and broken
packages_entry() {
  xdg-terminal-exec pacseek
}

# 5. CHAT
#
# None of these is preinstalled and none should be: a chat client is a
# personal choice, three of these are 50-420 MB each, and pacseek already
# installs anything. What was missing is knowing they are there at all -
# so this is discoverability, which is what #42 concluded the real gap
# was.
#
# All four come from Arch's own extra rather than being vendored here:
# they are better maintained there than we would manage, and vendoring a
# proprietary binary raises a redistribution question we have no reason to
# take on. Slack is deliberately not listed for exactly that reason - its
# licence is its own EULA, and `yay -S slack-desktop` is one command away.
chat_entry() {
  screen "Chat"
  say "None of these is installed by default. Each is from Arch's own"
  say "repositories, and pacseek installs anything else."
  echo

  local -a options=()
  local pkg label
  # installed size, so a 419 MB choice is made knowingly
  for pkg in signal-desktop:Signal:419 telegram-desktop:Telegram:140 \
    element-desktop:Element:48 discord:Discord:7; do
    local name=${pkg%%:*} rest=${pkg#*:}
    label=${rest%%:*}
    local size=${rest#*:}
    if pacman -Qq "$name" >/dev/null 2>&1; then
      options+=("$label ($name) - installed")
      continue
    fi
    # Only what this machine can actually install: element-desktop and
    # discord are in Arch's extra but not in Arch Linux ARM, so on the Pi
    # image offering them would end in an opaque "target not found" after
    # the user chose one. Asking the repositories is also how a package
    # that is dropped or renamed stops being offered without an edit here.
    pacman -Si "$name" >/dev/null 2>&1 || continue
    options+=("$label ($name) - ${size} MB")
  done

  if ((${#options[@]} == 0)); then
    say "None of them are available for this machine's architecture."
    pause
    return 0
  fi
  options+=("Back")

  local choice
  choice=$(gum choose --header "Chat clients" "${options[@]}") || return 0
  [[ $choice == "Back" ]] && return 0
  [[ $choice == *"- installed" ]] && { say "Already installed."; pause; return 0; }

  # the package name is the parenthesised half, so the label can change
  # without breaking the install
  local target=${choice#*(}
  target=${target%%)*}
  root_run pacman -S --noconfirm --needed "$target" && say "Installed $target."
  pause
}

# 6. TIME AND DATE
time_menu() {
  local choice
  while true; do
    screen "Time and date"
    say "$(timedatectl status | sed -n '1,4p')"
    echo
    choice=$(gum choose --header "Change" \
      "Timezone" "Network time" "Set the clock by hand" "Back") || return 0
    case $choice in
      "Timezone")
        local zone
        zone=$(timedatectl list-timezones 2>/dev/null |
          gum filter --header "Timezone" --placeholder "type to filter") || continue
        [[ -n $zone ]] && root_run timedatectl set-timezone "$zone" && pause
        ;;
      "Network time")
        gum confirm --affirmative "Toggle NTP" --negative "Cancel" "" || continue
        if timedatectl status | grep -q "NTP service: active"; then
          root_run timedatectl set-ntp false
        else
          root_run timedatectl set-ntp true
        fi
        pause
        ;;
      "Set the clock by hand")
        screen "Set the clock"
        # NTP is on from the install, and it will correct a hand-set clock
        # within seconds - which reads as the setting being ignored rather
        # than as NTP doing its job.
        if timedatectl status | grep -q "NTP service: active"; then
          warn "Network time is on, so a time set here will be corrected."
          warn "Turn NTP off first if you mean this to stick."
          echo
        fi
        local stamp
        stamp=$(gum input --header "YYYY-MM-DD HH:MM:SS" \
          --value "$(date '+%Y-%m-%d %H:%M:%S')") || continue
        [[ -n $stamp ]] && root_run timedatectl set-time "$stamp" && pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 7. HARDWARE
#
# The installer runs chwd for graphics only, and deliberately takes the
# free driver. Non-free is the reason to come here.
hardware_menu() {
  local choice
  while true; do
    screen "Hardware profiles"
    choice=$(gum choose --header "chwd" \
      "List profiles" "Install the detected free profile" \
      "Install the detected non-free profile" "Back") || return 0
    case $choice in
      "List profiles")
        screen "Hardware profiles"
        chwd -l 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Install the detected free profile")
        root_run chwd -a 0300 && pause
        ;;
      "Install the detected non-free profile")
        gum confirm --affirmative "Install" --negative "Cancel" \
          "Non-free drivers are not covered by the distribution's licence." || continue
        root_run chwd -a 0300 --nonfree 2>/dev/null ||
          root_run chwd -a nonfree 0300
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 8. NOTES
#
# zk keeps plain Markdown files in a directory and an index beside them,
# so there is no format of ours to persist - `git init` in the notebook is
# the whole of "my notes are backed up".
#
# No notebook is created at install time and none ships in skel: an empty
# one in $HOME is clutter for everyone who never opens it. This is the
# door instead.
notes_entry() {
  screen "Notes"

  # xdg-user-dir rather than ~/Documents: the directory is localised
  local documents
  documents=$(xdg-user-dir DOCUMENTS 2>/dev/null || echo "$HOME/Documents")
  local notebook="${ZK_NOTEBOOK_DIR:-$documents/notes}"

  if [[ -d $notebook/.zk ]]; then
    say "Notebook: $notebook"
    say "$(zk list --format '{{title}}' --quiet "$notebook" 2>/dev/null | wc -l) note(s)"
    echo
    if [[ -d $notebook/.git ]]; then
      say "It is a git repository. Nothing is committed for you - that is"
      say "deliberate; a tool that commits notes by itself is one that can"
      say "push a private notebook somewhere you did not choose."
      echo
      say "$(git -C "$notebook" status --porcelain | wc -l) uncommitted change(s)"
    else
      gum confirm --affirmative "git init" --negative "Back" \
        "Make it a git repository?" || return 0
      git -C "$notebook" init -q
      write_zk_gitignore "$notebook"
      say "Initialised. Commit when you want to: git -C '$notebook' commit -a"
    fi
    pause
    return 0
  fi

  say "No notebook yet. One will be created at:"
  say "  $notebook"
  echo
  gum confirm --affirmative "Create" --negative "Back" "Create it?" || return 0

  mkdir -p "$notebook"
  zk init --no-input "$notebook" 2>&1 | sed 's/^/  /'

  if gum confirm --affirmative "Yes" --negative "No" \
    "Make it a git repository as well?"; then
    git -C "$notebook" init -q
    write_zk_gitignore "$notebook"
    say "Initialised, and nothing is committed automatically."
  fi
  echo
  say "Write one with: zk new '$notebook'"
  pause
}

# zk rebuilds its index from the notes themselves, so committing it is
# committing derived state - and it is a binary file that changes on
# every command, which makes each commit a conflict. Measured: without
# this, git add -A stages .zk/notebook.db.
write_zk_gitignore() {
  local notebook=$1
  [[ -f $notebook/.gitignore ]] && return 0
  cat > "$notebook/.gitignore" <<'EOF'
# zk rebuilds this from the notes with `zk index`, so it is derived state
# - and a binary that changes on every command makes every commit a
# conflict. The notes and .zk/config.toml are the things worth keeping.
.zk/notebook.db
EOF
}

# 9. MAIL
#
# aerc is an optdepend and this configures one account. IMAP/SMTP with a
# password only: the OAuth half needs an OAuth client registration this
# project does not have yet (#53), and aerc's +oauthbearer wants a
# client_id and token_endpoint we cannot supply. Offering a Google entry
# that cannot complete would be worse than saying where the line is.
#
# The password goes to the login keyring and the config reads it back with
# source-cred-cmd, so accounts.conf never holds a secret - the same shape
# as the calendar entry's PasswordCommand.
AERC_ACCOUNTS="${XDG_CONFIG_HOME:-$HOME/.config}/aerc/accounts.conf"

# Gmail over OAuth, with the user's own client. aerc takes the OAuth
# parameters in the source URL - token_endpoint, client_id, client_secret,
# scope - and treats the stored password as the refresh token, exchanging
# it for an access token on each connection. So nothing of ours is in the
# exchange, and the same Cloud project the calendar entry asks for covers
# mail too if the Gmail scope is added to it.
#
# The refresh token is what has to be obtained once, and Google only hands
# one back through the same authorization-code flow the calendar entry
# runs. calcurse-caldav already implements that flow, but for a different
# scope, so this asks for the token rather than pretending to fetch it -
# an entry that half-works is worse than one that says what it needs.
gmail_account() {
  local name=$1 email=$2

  screen "Gmail"
  say "Gmail needs OAuth, and Google does not let us ship credentials for"
  say "it, so this uses your own - the same Cloud project the calendar"
  say "entry asks for, with the Gmail scope added:"
  echo
  say "  1. console.cloud.google.com -> your project"
  say "  2. APIs & Services -> Library -> enable Gmail API"
  say "  3. Credentials -> OAuth client ID -> Desktop app"
  say "  4. Obtain a refresh token for scope https://mail.google.com/"
  echo
  # Named plainly: this is the step with no button to press, and finding
  # that out after typing a client ID would be worse than reading it here.
  warn "Step 4 needs an OAuth flow this entry does not run: Google's"
  warn "OAuth 2.0 Playground does it in a browser, or any tool that"
  warn "completes an authorization-code flow for that scope."
  echo
  gum confirm --affirmative "I have a refresh token" --negative "Back" \
    "Continue?" || return 1

  local client_id client_secret refresh_token
  client_id=$(gum input --prompt "Client ID: ") || return 1
  [[ -n $client_id ]] || return 1
  client_secret=$(gum input --password --prompt "Client secret: ") || return 1
  refresh_token=$(gum input --password --prompt "Refresh token: ") || return 1
  [[ -n $refresh_token ]] || return 1

  # The refresh token is the credential here, so it goes where passwords
  # go rather than into the URL: aerc runs the command and never stores it.
  local cred_cmd=""
  if command -v secret-tool >/dev/null &&
    gum confirm --affirmative "Keyring" --negative "Config file" \
      "Store the refresh token in the login keyring?"; then
    printf '%s' "$refresh_token" |
      secret-tool store --label="aerc $name" service aerc account "$name" || {
        oops "Could not store the refresh token in the keyring."
        pause
        return 1
      }
    cred_cmd="secret-tool lookup service aerc account $name"
  fi

  # token_endpoint present, so aerc treats the stored value as a refresh
  # token and exchanges it; without it the value would have to be a
  # short-lived access token instead
  local params="token_endpoint=https://oauth2.googleapis.com/token"
  params+="&client_id=$(url_escape "$client_id")"
  params+="&client_secret=$(url_escape "$client_secret")"
  params+="&scope=$(url_escape "https://mail.google.com/")"

  private_file "$AERC_ACCOUNTS"
  {
    echo
    echo "[$name]"
    echo "from = $email"
    if [[ -n $cred_cmd ]]; then
      echo "source = imaps+xoauth2://$(url_escape "$email")@imap.gmail.com:993?$params"
      echo "source-cred-cmd = $cred_cmd"
      echo "outgoing = smtps+xoauth2://$(url_escape "$email")@smtp.gmail.com:465?$params"
      echo "outgoing-cred-cmd = $cred_cmd"
      echo "outgoing-cred-cmd-cache = true"
    else
      echo "source = imaps+xoauth2://$(url_escape "$email"):$(url_escape "$refresh_token")@imap.gmail.com:993?$params"
      echo "outgoing = smtps+xoauth2://$(url_escape "$email"):$(url_escape "$refresh_token")@smtp.gmail.com:465?$params"
    fi
    # Gmail files sent mail itself, and a copy-to would leave two
    echo "copy-to = "
  } >> "$AERC_ACCOUNTS"
  chmod 600 "$AERC_ACCOUNTS"

  echo
  if [[ -n $cred_cmd ]]; then
    say "Written to $AERC_ACCOUNTS - the refresh token is in the keyring."
  else
    say "Written to $AERC_ACCOUNTS (mode 600), refresh token included."
  fi
  say "Run aerc to check it."
  pause
}

mail_entry() {
  screen "Mail"

  if [[ -f $AERC_ACCOUNTS ]]; then
    say "Configured accounts:"
    sed -n 's/^\[\(.*\)\]$/  \1/p' "$AERC_ACCOUNTS"
    echo
    gum confirm --affirmative "Add another" --negative "Back" "Add an account?" || return 0
  fi

  local name email imap_host imap_port smtp_host smtp_port user
  name=$(gum input --prompt "Account name: " --value "Personal") || return 0
  [[ -n $name ]] || return 0
  email=$(gum input --prompt "Email address: ") || return 0
  [[ -n $email ]] || return 0

  # The same providers the calendar entry offers, because someone with a
  # Fastmail calendar usually has Fastmail mail (#55). Every host and port
  # below answered with a protocol banner when probed - not copied from a
  # support page - and every field stays editable.
  #
  # Microsoft is absent: Outlook.com wants OAuth and an Entra app
  # registration, which is a separate account and a separate set of terms
  # from Google's (#55). Gmail is offered because aerc takes the OAuth
  # parameters in the URL, so the user's own client works with no code of
  # ours in the exchange.
  local provider
  provider=$(gum choose --header "Where is the mail?" \
    "Gmail" "Fastmail" "iCloud" "mailbox.org" "Posteo" "Zoho" \
    "Other IMAP server") || return 0

  if [[ $provider == Gmail ]]; then
    gmail_account "$name" "$email" || return 0
    return 0
  fi

  local domain=${email#*@}
  # smtp_scheme: aerc reads smtps:// as implicit TLS and smtp:// as
  # STARTTLS, which is the difference iCloud needs - it answers on 587
  # only, with 465 refusing the connection outright.
  local smtp_scheme=smtps note=""
  case $provider in
    "Fastmail")
      imap_host=imap.fastmail.com; smtp_host=smtp.fastmail.com
      note="Fastmail needs an app password: Settings -> Privacy & Security." ;;
    "iCloud")
      imap_host=imap.mail.me.com; smtp_host=smtp.mail.me.com
      smtp_port=587; smtp_scheme=smtp
      note="iCloud needs an app-specific password from appleid.apple.com." ;;
    "mailbox.org")
      imap_host=imap.mailbox.org; smtp_host=smtp.mailbox.org ;;
    "Posteo")
      imap_host=posteo.de; smtp_host=posteo.de ;;
    "Zoho")
      imap_host=imappro.zoho.com; smtp_host=smtppro.zoho.com
      note="Zoho hosts EU accounts separately: imap.zoho.eu and smtp.zoho.eu." ;;
    *)
      # the mail.<domain> convention, which is right often enough to be a
      # better starting point than an empty field
      imap_host=imap.$domain; smtp_host=smtp.$domain ;;
  esac

  imap_host=$(gum input --prompt "IMAP server: " --value "$imap_host") || return 0
  imap_port=$(gum input --prompt "IMAP port: " --value "993") || return 0
  smtp_host=$(gum input --prompt "SMTP server: " --value "$smtp_host") || return 0
  smtp_port=$(gum input --prompt "SMTP port: " --value "${smtp_port:-465}") || return 0
  user=$(gum input --prompt "Username: " --value "$email") || return 0

  # Said before the password prompt: an app password is something the user
  # has to go and create somewhere else first.
  if [[ -n $note ]]; then
    echo
    say "$note"
    echo
  fi

  local password
  password=$(gum input --password --prompt "Password: ") || return 0
  [[ -n $password ]] || return 0

  local cred_cmd=""
  if command -v secret-tool >/dev/null; then
    printf '%s' "$password" |
      secret-tool store --label="aerc $name" service aerc account "$name" || {
        oops "Could not store the password in the keyring."
        pause
        return 1
      }
    cred_cmd="secret-tool lookup service aerc account $name"
    password=""
  fi

  private_file "$AERC_ACCOUNTS"
  {
    echo
    echo "[$name]"
    echo "from = $email"
    if [[ -n $cred_cmd ]]; then
      # no credential in the file, and none on a command line either:
      # aerc runs the command itself rather than expanding it into a URL
      echo "source = imaps://$(url_escape "$user")@$imap_host:$imap_port"
      echo "source-cred-cmd = $cred_cmd"
      echo "outgoing = $smtp_scheme://$(url_escape "$user")@$smtp_host:$smtp_port"
      echo "outgoing-cred-cmd = $cred_cmd"
      # otherwise the keyring is queried once per message sent
      echo "outgoing-cred-cmd-cache = true"
    else
      echo "source = imaps://$(url_escape "$user"):$(url_escape "$password")@$imap_host:$imap_port"
      echo "outgoing = $smtp_scheme://$(url_escape "$user"):$(url_escape "$password")@$smtp_host:$smtp_port"
    fi
    echo "copy-to = Sent"
  } >> "$AERC_ACCOUNTS"
  chmod 600 "$AERC_ACCOUNTS"

  # The generated styleset follows the desktop theme; point aerc at it
  # here rather than making the theme script edit a config it does not own.
  local aerc_conf="${XDG_CONFIG_HOME:-$HOME/.config}/aerc/aerc.conf"
  if [[ ! -f $aerc_conf ]]; then
    printf '[ui]\nstyleset-name = ashlaros\n' > "$aerc_conf"
  elif ! grep -q '^styleset-name' "$aerc_conf"; then
    say "Set styleset-name = ashlaros under [ui] in aerc.conf for the desktop theme."
  fi

  echo
  if [[ -n $cred_cmd ]]; then
    say "Written to $AERC_ACCOUNTS - the password is in the keyring, not the file."
  else
    say "Written to $AERC_ACCOUNTS (mode 600). No keyring available, so the"
    say "password is in the file."
  fi
  say "Run aerc to check it."
  pause
}

# 10. CALENDAR
#
# calcurse is a hard dependency with a keybind, an autostarted daemon and
# a place in our screenshots, and we shipped no configuration for it at
# all: it opened onto an empty local calendar. This writes
# calcurse-caldav's config, which works today against Nextcloud,
# Fastmail, Radicale, Baikal and any other CalDAV server.
#
# Google is deliberately not offered as a preset. calcurse-caldav's OAuth
# path needs python-oauth2client, which Google archived years ago and
# which predates PKCE being standard; claiming support we have not proven
# would be worse than saying where the limit is.
CALDAV_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/calcurse/caldav/config"

# Google is the one provider that cannot be a row in the table above: it
# wants OAuth2 rather than a password, and the credentials are the user's
# own. We do not ship a client ID. vdirsyncer - a mature project that has
# read the same terms - makes every user register their own Cloud project
# because Google's ToS, section "Confidential Matters", is read as
# forbidding hardcoded credentials in open-source software (#55). Until
# that reading is settled with Google rather than guessed at, asking the
# user for their own is the only version of this that is certainly
# allowed, and it is also exactly the config a shipped client ID would
# later fill in.
#
# calcurse-caldav has a complete OAuth2 path of its own, so this stays on
# one sync engine. python-oauth2client is unmaintained upstream but is in
# Arch's repositories and the flow works; the alternative was vdirsyncer
# plus a manual import step, because calcurse can only import iCal
# one-way and would not see a vdir at all.
google_calendar() {
  screen "Google calendar"

  if ! pacman -Qq python-oauth2client >/dev/null 2>&1; then
    say "Google needs python-oauth2client for the OAuth2 flow."
    gum confirm --affirmative "Install" --negative "Back" "Install it?" || return 1
    root_run pacman -S --noconfirm --needed python-oauth2client || { pause; return 1; }
  fi

  screen "Google calendar"
  say "Google does not let us ship credentials for this, so the first step"
  say "is creating your own - once, free, about five minutes:"
  echo
  say "  1. console.cloud.google.com -> create a project"
  # The trap vdirsyncer documents: the Calendar API is a different API and
  # syncing silently gets nowhere with it enabled instead.
  say "  2. APIs & Services -> Library -> enable CalDAV API"
  say "     (the CalDAV API, not the Calendar API - they are different)"
  say "  3. Credentials -> Create credentials -> OAuth client ID"
  say "  4. Application type: Desktop app"
  echo
  gum confirm --affirmative "I have them" --negative "Back" \
    "Ready to paste the client ID and secret?" || return 1

  local client_id client_secret email
  client_id=$(gum input --prompt "Client ID: ") || return 1
  [[ -n $client_id ]] || return 1
  client_secret=$(gum input --password --prompt "Client secret: ") || return 1
  email=$(gum input --prompt "Google account (email): ") || return 1
  [[ -n $email ]] || return 1

  private_file "$CALDAV_CONFIG"
  {
    echo "# written by ashlaros-settings-tui"
    echo "[General]"
    echo "Binary = calcurse"
    echo "Hostname = apidata.googleusercontent.com"
    # the account's own CalDAV collection, percent-encoded: the @ would
    # otherwise end the path segment
    echo "Path = /caldav/v2/$(url_escape "$email")/events/"
    echo "HTTPS = Yes"
    echo "AuthMethod = oauth2"
    echo "DryRun = Yes"
    echo "SyncFilter = cal,todo"
    echo
    echo "[OAuth2]"
    echo "ClientID = $client_id"
    echo "ClientSecret = $client_secret"
    echo "Scope = https://www.googleapis.com/auth/calendar"
    # loopback, so nothing of ours is in the exchange; the code comes back
    # in the browser's address bar and the user pastes it
    echo "RedirectURI = http://127.0.0.1"
  } > "$CALDAV_CONFIG"
  chmod 600 "$CALDAV_CONFIG"

  screen "Google calendar"
  say "Written to $CALDAV_CONFIG"
  echo
  say "A browser will open for you to authorize this. Google then shows a"
  say "URL containing code=... - copy what follows code= and paste it here."
  echo
  pause

  # First run opens the browser and exits without a code by design, so its
  # failure is expected rather than an error worth showing.
  calcurse-caldav --init=two-way >/dev/null 2>&1

  local authcode
  authcode=$(gum input --prompt "Auth code: ") || return 1
  if [[ -z $authcode ]]; then
    warn "No code, so nothing was authorized. The config is written; this"
    warn "entry's \"Reconfigure\" picks it up again."
    pause
    return 1
  fi

  screen "Google calendar"
  say "Trial run - DryRun is still on, so nothing is written anywhere:"
  echo
  # still DryRun = Yes here, same as the password path.
  #
  # --authcode puts the code in this process's argv, where any user on the
  # machine can read it out of /proc for as long as the exchange runs.
  # calcurse-caldav offers no other way in - not stdin, not a file - so the
  # exposure is upstream's interface, not a choice here. It is bounded:
  # an authorization code is single-use and short-lived, it is spent by the
  # exchange on the next line, and it is worthless without the client
  # secret, which is in a 600 config rather than on a command line.
  calcurse-caldav --init=two-way --authcode "$authcode" 2>&1 |
    sed 's/^/  /' | head -40
  echo

  if gum confirm --affirmative "Sync for real" --negative "Leave it in dry-run mode" \
    "Does that look right?"; then
    sed -i 's/^DryRun = Yes/DryRun = No/' "$CALDAV_CONFIG"
    # the token is stored now, so no code is needed again
    calcurse-caldav 2>&1 | sed 's/^/  /' | head -40
    say "Synced. Later syncs are this entry's \"Sync now\"."
  else
    say "Left as DryRun = Yes. Nothing will be written until you change it."
  fi
  pause
}

calendar_entry() {
  screen "Calendar"

  if [[ -f $CALDAV_CONFIG ]]; then
    say "Configured: $(sed -n 's/^Hostname *= *//p' "$CALDAV_CONFIG" | head -1)"
    echo
    local existing
    existing=$(gum choose --header "calcurse CalDAV" \
      "Sync now (dry run)" "Sync now" "Reconfigure" "Back") || return 0
    case $existing in
      "Sync now (dry run)")
        # calcurse-caldav has no --dry-run flag: DryRun is a config key,
        # so a trial run means a temporary config with it turned back on
        local trial
        trial=$(mktemp)
        sed 's/^DryRun = No/DryRun = Yes/' "$CALDAV_CONFIG" > "$trial"
        calcurse-caldav --config "$trial" 2>&1 | sed 's/^/  /' | head -40
        rm -f "$trial"
        pause; return 0 ;;
      "Sync now")
        calcurse-caldav 2>&1 | sed 's/^/  /' | head -40
        pause; return 0 ;;
      "Reconfigure") ;;
      *) return 0 ;;
    esac
  fi

  local -a missing=()
  local pkg
  for pkg in python python-httplib2 python-pyparsing; do
    pacman -Qq "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    say "calcurse-caldav needs: ${missing[*]}"
    gum confirm --affirmative "Install" --negative "Back" "Install them?" || return 0
    root_run pacman -S --noconfirm --needed "${missing[@]}" || { pause; return 1; }
  fi

  # A table rather than a branch per provider: the common failure is not
  # knowing the CalDAV URL, and the URL is data. Every host and path below
  # was probed and answers 401 - the endpoint exists and wants credentials
  # - rather than being copied from documentation (#55).
  #
  # Outlook is deliberately absent: Microsoft retired CalDAV for
  # Outlook.com and the replacement is Graph, a REST API that nothing here
  # speaks. Listing it would promise something that cannot work.
  local provider
  provider=$(gum choose --header "Where is the calendar?" \
    "Nextcloud (self-hosted)" \
    "Google" \
    "Fastmail" \
    "iCloud" \
    "mailbox.org" \
    "Posteo" \
    "Zoho" \
    "Other CalDAV server") || return 0

  local host="" path="" note=""
  case $provider in
    "Fastmail")
      host=caldav.fastmail.com; path=/dav/calendars/user/USERNAME/CALENDAR/
      note="Fastmail needs an app password: Settings -> Privacy & Security -> Integrations." ;;
    "iCloud")
      host=caldav.icloud.com; path=/
      note="iCloud needs an app-specific password from appleid.apple.com, not your Apple ID password." ;;
    "mailbox.org")
      host=dav.mailbox.org; path=/caldav/ ;;
    "Posteo")
      host=posteo.de:8443; path=/calendars/USERNAME/default/ ;;
    "Zoho")
      host=calendar.zoho.com; path=/caldav/USERNAME/events/
      note="Zoho needs an application-specific password when two-factor is on." ;;
    "Nextcloud (self-hosted)")
      path=/remote.php/dav/calendars/USERNAME/personal/ ;;
  esac

  if [[ $provider == Google ]]; then
    google_calendar || return 0
    return 0
  fi

  local user
  host=$(gum input --prompt "Server: " --value "$host") || return 0
  [[ -n $host ]] || return 0
  path=$(gum input --prompt "Calendar path: " --value "$path") || return 0
  user=$(gum input --prompt "Username: ") || return 0

  # Said before the password prompt, not after a failure: an app password
  # is something the user has to go and create elsewhere.
  if [[ -n $note ]]; then
    echo
    say "$note"
    echo
  fi

  # PasswordCommand before Password: with gnome-keyring unlocked at login
  # (it is, since f0b5cc7) secret-tool needs no extra package and keeps
  # the password out of a plaintext config
  local secret_cmd="" password=""
  if command -v secret-tool >/dev/null &&
    gum confirm --affirmative "Keyring" --negative "Config file" \
      "Store the password in the login keyring?"; then
    password=$(gum input --password --prompt "Password: ") || return 0
    printf '%s' "$password" |
      secret-tool store --label="calcurse CalDAV" service calcurse-caldav username "$user" ||
      { oops "Could not store the password."; pause; return 1; }
    secret_cmd="secret-tool lookup service calcurse-caldav username $user"
    password=""
  else
    password=$(gum input --password --prompt "Password: ") || return 0
  fi

  private_file "$CALDAV_CONFIG"
  {
    echo "# written by ashlaros-settings-tui"
    echo "[General]"
    echo "Binary = calcurse"
    echo "Hostname = $host"
    echo "Path = $path"
    echo "HTTPS = Yes"
    echo "AuthMethod = basic"
    # calcurse ships DryRun = Yes and its own README calls the script
    # alpha software that wants backups. It stays on until a dry run has
    # been read and the user turns it off below.
    echo "DryRun = Yes"
    echo "SyncFilter = cal,todo"
    echo
    echo "[Auth]"
    echo "Username = $user"
    if [[ -n $secret_cmd ]]; then
      echo "PasswordCommand = $secret_cmd"
    else
      echo "Password = $password"
    fi
  } > "$CALDAV_CONFIG"
  chmod 600 "$CALDAV_CONFIG"

  screen "Calendar"
  say "Written to $CALDAV_CONFIG"
  echo
  say "First sync, as a dry run - nothing is written anywhere:"
  echo

  # --init is required on a first sync, and the three modes differ by what
  # they DELETE. Named by consequence, never by name alone.
  local mode init
  mode=$(gum choose --header "This calendar has never synced. What should happen?" \
    "Copy both ways, delete nothing" \
    "Take the server's copy, DELETE local calcurse items" \
    "Take the local copy, DELETE everything on the server") || return 0
  case $mode in
    "Copy both ways"*) init=two-way ;;
    "Take the server's"*) init=keep-remote ;;
    *) init=keep-local ;;
  esac

  # the config still carries DryRun = Yes at this point, which is what
  # makes this a trial rather than the flag calcurse-caldav does not have
  calcurse-caldav --init=$init 2>&1 | sed 's/^/  /' | head -40
  echo
  say "That was a dry run. Nothing changed."
  echo

  if gum confirm --affirmative "Sync for real" --negative "Leave it in dry-run mode" \
    "Does that look right?"; then
    sed -i 's/^DryRun = Yes/DryRun = No/' "$CALDAV_CONFIG"
    calcurse-caldav --init=$init 2>&1 | sed 's/^/  /' | head -40
    say "Synced. Later syncs are this entry's \"Sync now\"."
  else
    say "Left as DryRun = Yes. Nothing will be written until you change it."
  fi
  pause
}

# 11. BACKGROUND
#
# The wallpaper is generated, not chosen: generate-bg.sh recolours the
# ashlar mark from the active palette into ~/.config/sway/
# generated_background.svg, and every theme apply overwrites it
# (90-enable-theme.conf:12). So a picker that writes the user's JPEG into
# that file loses it at the next theme switch, and one that only calls
# swaymsg loses it at the next login.
#
# Both are avoided by writing `set $background` into definitions.d/, which
# is user-owned, documented as the override path in its own README, and
# untouched by the theme machinery. The generated background stays the
# default and is always offered back.
BACKGROUND_OVERRIDE="$HOME/.config/sway/definitions.d/50-background.conf"

background_entry() {
  screen "Background"

  local generated="$HOME/.config/sway/generated_background.svg"
  local -a paths=() labels=()

  paths+=("$generated")
  labels+=("The theme's background (recoloured on every theme switch)")

  # xdg-user-dir rather than ~/Pictures: the directory is localised, and
  # xdg-user-dirs is already a dependency
  local pictures
  pictures=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")

  local dir f
  for dir in /usr/share/backgrounds "$HOME/.local/share/backgrounds" "$pictures"; do
    [[ -d $dir ]] || continue
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      [[ $f == "$generated" ]] && continue
      paths+=("$f")
      labels+=("${f/#$HOME/\~}")
    done < <(find "$dir" -maxdepth 2 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
      -o -iname '*.svg' -o -iname '*.webp' \) 2>/dev/null | sort)
  done

  if [[ ${#paths[@]} -le 1 ]]; then
    say "No images found in /usr/share/backgrounds, ~/.local/share/backgrounds"
    say "or $pictures."
    pause
    return 0
  fi

  local choice
  choice=$(printf '%s\n' "${labels[@]}" | gum choose --header "Background") || return 0

  local index=-1 i
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$choice" ]] && index=$i && break
  done
  [[ $index -ge 0 ]] || return 0
  local picked=${paths[$index]}

  # fill is right for a photograph and wrong for a logo or a tile, which
  # is why the shipped config hardcoding it was worth exposing
  local mode
  mode=$(gum choose --header "How should it fit?" \
    "fill" "fit" "stretch" "center" "tile") || return 0

  # Applied before it is committed: a wallpaper picker you cannot see the
  # result of is not a picker.
  swaymsg output "*" bg "$picked" "$mode" >/dev/null 2>&1

  gum confirm --affirmative "Keep" --negative "Revert" "Keep this background?" || {
    # back to whatever the config says, without writing anything
    local previous=$generated
    [[ -f $BACKGROUND_OVERRIDE ]] &&
      previous=$(sed -n 's/^set \$background //p' "$BACKGROUND_OVERRIDE" | tr -d "'\"" | head -1)
    swaymsg output "*" bg "${previous:-$generated}" fill >/dev/null 2>&1
    say "Reverted."
    pause
    return 0
  }

  if [[ $picked == "$generated" ]]; then
    # the default is the absence of an override, so the theme's own
    # background keeps being regenerated rather than pinned to today's
    rm -f "$BACKGROUND_OVERRIDE"
    say "Using the theme's background again."
  else
    mkdir -p "$(dirname "$BACKGROUND_OVERRIDE")"
    # quoted: paths with spaces are ordinary in ~/Pictures
    {
      echo "# written by ashlaros-settings-tui"
      echo "# definitions.d survives theme switches; generated_background.svg does not"
      echo "set \$background '$picked'"
    } > "$BACKGROUND_OVERRIDE"
    say "Saved. It will still be there after a theme switch and a login."
  fi
  pause
}

# 12. WEB APPS
#
# The desktop ships no office suite, no viewer, not even a PDF reader, so
# a .docx that arrives has nothing to open it. LibreOffice is 147 MB and
# an optdepend for people who need real Office round-tripping; this is the
# lighter answer - Docs and Microsoft 365 as their own windows, in the
# launcher, signed in as the user.
#
# A user action rather than a postinstall: the runtime is ~300 MB and
# per-user, and nobody should have Google installed on their behalf.
webapps_entry() {
  screen "Web apps"
  echo "  Office documents, as web apps in their own windows."
  echo "  The first run downloads a ~300 MB browser runtime, once."
  echo

  local choice
  choice=$(gum choose --header "Install" \
    "Google Docs, Sheets and Slides" "Microsoft 365" "Back") || return 0

  case $choice in
    "Google Docs, Sheets and Slides") /usr/share/sway/scripts/webapps.sh docs ;;
    "Microsoft 365") /usr/share/sway/scripts/webapps.sh office ;;
    *) return 0 ;;
  esac
  pause
}

# 13. MODEL
#
# The Ask key (Print, then a) is the one capture action that leaves the
# machine, and aichat owns its own provider/model/key configuration. This
# does not build a second layer over that: it opens theirs and says where
# the keys go. Only shown when aichat is installed - it is an optdepend
# precisely because an LLM tool on every desktop is not a default this
# distribution should choose for anyone.
model_entry() {
  screen "Model"
  local config="${AICHAT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/aichat}/config.yaml"

  if [[ -f $config ]]; then
    echo "  Configured: $(aichat --info 2>/dev/null | sed -n 's/^model *//p' | head -1)"
  else
    echo "  No provider configured. Print then a does nothing until there is one."
  fi
  echo
  echo "  Config: $config"
  echo "  A local Ollama keeps screen regions on this machine;"
  echo "  a hosted provider sends them to that company."
  echo

  gum confirm --affirmative "Edit" --negative "Back" "Open the config?" || return 0
  mkdir -p "$(dirname "$config")"
  ${EDITOR:-vim} "$config"
}

# 14. ORPHANS
#
# The hook (95-ashlaros-orphans.hook) reports after every transaction and
# deliberately suggests nothing destructive. This is where the destructive
# half lives: one package at a time, named, behind a confirm.
#
# `pacman -Qtdq | pacman -Rns -` is the command the upstream hook prints
# and it is a footgun - it cascades, and on a desktop it takes things
# installed as a dependency of something since removed but still wanted.
# Removing one at a time is slower and is the point.
orphans_entry() {
  local choice orphans
  while true; do
    screen "Packages nothing needs"

    mapfile -t orphans < <(pacman -Qtdq 2>/dev/null)
    if ((${#orphans[@]} == 0)); then
      say "✓ nothing is installed that is no longer required"
      pause
      return 0
    fi

    say "${#orphans[@]} package(s) installed as dependencies that nothing"
    say "depends on any more:"
    echo
    printf "  %s\n" "${orphans[@]}"
    echo

    choice=$(gum choose --header "Orphans" \
      "Show what one is" "Keep one (mark explicit)" "Remove one" "Back") || return 0

    case $choice in
      "Show what one is")
        local pkg
        pkg=$(gum choose --header "Which" "${orphans[@]}") || continue
        screen "$pkg"
        pacman -Qi "$pkg" 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Keep one (mark explicit)")
        local pkg
        pkg=$(gum choose --header "Which" "${orphans[@]}") || continue
        # The safe half of the original advice, and the one nobody knows:
        # it says "I want this" without removing anything.
        root_run pacman -D --asexplicit "$pkg" && say "$pkg is now explicit."
        pause
        ;;
      "Remove one")
        local pkg
        pkg=$(gum choose --header "Which" "${orphans[@]}") || continue
        # -Rns on a single named package, never on a piped list. What it
        # would take with it is shown before the confirm, because that is
        # the part that surprises people.
        screen "Remove $pkg"
        say "This would remove:"
        echo
        pacman -Rns --print "$pkg" 2>&1 | sed "s/^/  /"
        echo
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Remove $pkg and what it pulls with it?" || continue
        root_run pacman -Rns --noconfirm "$pkg"
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 15. FACE
#
# Everything #39 settled about PAM applies here for a weaker factor, so
# this follows the fingerprint entry exactly: sufficient before the
# password line, sudo only, refused until a test has passed, and never on
# by default.
#
# What is different is worth saying rather than discovering. From
# howdy-next's own README: "Howdy is weaker than a password. Similar faces
# or photos may fool it." This is 2D infrared matching, not Windows Hello -
# Hello's anti-spoofing comes from a dot projector building a depth map,
# and Howdy reads a flat IR frame. IR defeats a phone screen and a printed
# photo; it does not make this what the hardware does under Windows.
#
# howdy-next is an optdepend and this entry is built only when it is
# installed: pacman resolves 182 packages for it, opencv 112.81 MiB and
# qt6-base 66.53 MiB, for hardware most machines do not have.
readonly FACE_LINE="auth       sufficient   pam_howdy.so"
readonly FACE_SUDO=/etc/pam.d/sudo

face_enabled() {
  grep -q "^auth .*pam_howdy.so" "$FACE_SUDO" 2>/dev/null
}

# Whether this user has a face model.
#
# Two things measured against the published package rather than assumed.
# It needs root: `howdy list` answers "This command requires root
# privileges" and exits before printing anything, and the models it would
# read live in /etc/howdy/models, which is 750 root. And it reports by
# exit status, not output - with no model it prints nothing at all and
# exits 1 - so an unprivileged run counting printed rows found none
# whether or not one existed, and the menu could never show an enrolled
# model.
#
# -n: this only draws a menu, so it must not stop to ask for a password.
# Without a cached credential it reports none, which is the answer the
# unprivileged call always gave and no worse than the state it replaces.
face_has_model() {
  sudo -n howdy --plain -U "$ME" list >/dev/null 2>&1
}

face_entry() {
  local choice
  while true; do
    screen "Face unlock"

    local models=0
    face_has_model && models=1
    if ((models > 0)); then
      say "✓ a face model exists for $ME"
    else
      warn "! no face model yet"
    fi

    if face_enabled; then
      say "✓ sudo accepts a face (password still works)"
    else
      say "  sudo is password only"
    fi

    echo
    # Stated every time the menu is drawn, not once behind a confirm: it
    # is the thing that decides whether anyone should turn this on.
    say "A face is weaker than a password. A similar face, or a photo,"
    say "may work. Infrared makes that harder, not impossible."
    say "This does not affect the disk passphrase at boot."
    echo

    local entries=()
    ((models == 0)) && entries+=("Add a face model")
    ((models > 0)) && entries+=("Test the camera" "Add another face model" "Remove every face model")
    if ((models > 0)) && ! face_enabled; then
      entries+=("Use it for sudo")
    fi
    face_enabled && entries+=("Stop using it for sudo")
    entries+=("Camera settings" "Back")

    choice=$(gum choose --header "Face unlock" "${entries[@]}") || return 0
    case $choice in
      "Add a face model" | "Add another face model")
        screen "Face unlock"
        # The models are an ONNX download howdy does not ship; running add
        # without them fails in a way that reads like a camera fault.
        say "Fetching the recognition models if they are missing…"
        root_run howdy download-models || { pause; continue; }
        echo
        say "Look at the camera."
        echo
        root_run howdy -U "$ME" add
        pause
        ;;
      "Test the camera")
        screen "Face unlock"
        root_run howdy -U "$ME" test
        pause
        ;;
      "Remove every face model")
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Remove every face model for $ME?" || continue
        root_run howdy -U "$ME" clear
        # PAM asking for a face that no longer exists is a delay before
        # every password and nothing else.
        face_enabled && root_run sed -i "/pam_howdy.so/d" "$FACE_SUDO"
        pause
        ;;
      "Use it for sudo")
        screen "Face unlock"
        # Refused until a test has passed. Enabling against a camera that
        # has never recognised anyone - a dark IR emitter is the usual
        # reason - adds a wait before every password and nothing more.
        say "Testing recognition first. Look at the camera."
        echo
        if ! root_run howdy -U "$ME" test; then
          echo
          oops "Recognition did not succeed, so this stays off."
          say "A dark infrared emitter is the usual cause: many laptops"
          say "leave it off until something turns it on."
          pause
          continue
        fi
        echo
        gum confirm --affirmative "Enable for sudo" --negative "Cancel" \
          "A photo of you may unlock sudo. Enable it anyway?" || continue

        # Same placement and idempotence as the fingerprint entry: PAM
        # takes the first sufficient match, so this goes before the line
        # that asks for a password, and any existing line is removed first
        # so enabling twice cannot stack two.
        root_run sed -i -e "/pam_howdy.so/d" \
          -e "0,/^auth/s//$FACE_LINE\nauth/" "$FACE_SUDO" || continue
        echo
        say "Enabled. Check it now, while this menu is still open:"
        say "  open another terminal and run: sudo -k true"
        say "A password must still work there. If it does not, choose Stop."
        pause
        ;;
      "Stop using it for sudo")
        root_run sed -i "/pam_howdy.so/d" "$FACE_SUDO" || continue
        say "Disabled. sudo is back to password only."
        pause
        ;;
      "Camera settings")
        screen "Face unlock"
        say "howdy config opens its own configuration file."
        pause
        root_run howdy config
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 16. FINGERPRINT
#
# Installed everywhere, enabled nowhere. A fresh machine behaves exactly
# as it did before; fingerprint auth turns on only when someone has
# enrolled a finger, proved it verifies, and asked for it.
#
# The danger here is specific and has no recovery from inside the
# session: a PAM stack that cannot fall back to a password turns a reader
# that stops enumerating after a suspend into a machine nobody can use.
# So `sufficient`, placed before the password line, never `required` - a
# finger that fails falls through to the prompt that always worked.
readonly FPRINT_LINE="auth       sufficient   pam_fprintd.so"
readonly FPRINT_SUDO=/etc/pam.d/sudo

fingerprint_enabled() {
  grep -q "^auth .*pam_fprintd.so" "$FPRINT_SUDO" 2>/dev/null
}

# Only the narrowest stack that pays for itself. sudo prompts many times a
# day; the lock screen is where a reader failing after suspend bites
# hardest, and greetd is a TUI greeter where the interaction is poor - so
# neither is offered here.
fingerprint_enable() {
  say "This changes sudo only. Your password keeps working:"
  say "  pam_fprintd is 'sufficient', so a finger that fails or a reader"
  say "  that has stopped responding falls through to the password."
  echo
  gum confirm --affirmative "Enable for sudo" --negative "Cancel" \
    "Use a fingerprint for sudo?" || return 0

  # Inserted before the first auth line, because PAM takes the first
  # sufficient match: after `auth include system-auth` the password has
  # already been asked for and the finger would never be reached.
  #
  # sed -i on a package-owned file edits it in place rather than replacing
  # it, so pacman still owns it and no .pacnew appears.
  #
  # Any existing line is deleted first, so enabling twice cannot stack two
  # of them. The menu already guards on fingerprint_enabled, but an edit
  # to an authentication file should be idempotent on its own terms.
  root_run sed -i -e "/pam_fprintd.so/d" \
    -e "0,/^auth/s//$FPRINT_LINE\nauth/" "$FPRINT_SUDO" || return 1

  # The safety rail: prove the password still authenticates before
  # leaving the user with a stack they cannot reach.
  echo
  say "Enabled. Check it now, while this menu is still open:"
  say "  open another terminal and run: sudo -k true"
  say "A password must still work there. If it does not, choose Disable."
  pause
}

fingerprint_disable() {
  root_run sed -i "/pam_fprintd.so/d" "$FPRINT_SUDO" || return 1
  say "Disabled. sudo is back to password only."
  pause
}

fingerprint_entry() {
  local choice
  while true; do
    screen "Fingerprint"

    # Enrolment is per user and needs no root; the PAM edit does. Taking
    # privilege per action rather than running the whole menu as root.
    local enrolled
    enrolled=$(fprintd-list "$ME" 2>/dev/null | grep -c "#" || true)
    if ((enrolled > 0)); then
      say "✓ $enrolled finger(s) enrolled"
    else
      warn "! no fingers enrolled yet"
    fi

    if fingerprint_enabled; then
      say "✓ sudo accepts a fingerprint (password still works)"
    else
      say "  sudo is password only"
    fi

    # Nothing here touches disk unlock: LUKS happens long before PAM
    # exists, and the installer enrols the TPM against PCR 7. Said out
    # loud so nobody waits for a reader at the passphrase prompt.
    echo
    say "This does not affect the disk passphrase at boot."
    echo

    local entries=("Enrol a finger")
    ((enrolled > 0)) && entries+=("Test it" "Delete enrolled fingers")
    if ((enrolled > 0)) && ! fingerprint_enabled; then
      entries+=("Use it for sudo")
    fi
    fingerprint_enabled && entries+=("Stop using it for sudo")
    entries+=("Back")

    choice=$(gum choose --header "Fingerprint" "${entries[@]}") || return 0
    case $choice in
      "Enrol a finger")
        screen "Fingerprint"
        say "Touch the reader repeatedly when asked."
        echo
        fprintd-enroll 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Test it")
        screen "Fingerprint"
        fprintd-verify 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Delete enrolled fingers")
        gum confirm --affirmative "Delete" --negative "Cancel" \
          "Remove every enrolled finger for $ME?" || continue
        fprintd-delete "$ME" 2>&1 | sed "s/^/  /"
        # Leaving PAM asking for a finger that no longer exists would
        # mean a pointless prompt before every password.
        fingerprint_enabled && root_run sed -i "/pam_fprintd.so/d" "$FPRINT_SUDO"
        pause
        ;;
      "Use it for sudo")
        screen "Fingerprint"
        # Refused until verification has actually succeeded: enabling on
        # a reader that has never read anything is how someone ends up
        # with an extra prompt and no working finger.
        say "Testing the reader first."
        echo
        if fprintd-verify 2>&1 | sed "s/^/  /" | grep -q "verify-match"; then
          echo
          fingerprint_enable
        else
          echo
          oops "That did not verify, so nothing was changed."
          oops "Enrol a finger and test it before enabling."
          pause
        fi
        ;;
      "Stop using it for sudo") fingerprint_disable ;;
      "Back") return 0 ;;
    esac
  done
}

# 17. NETWORK
#
# Only the QR code lives here: nmtui does everything else and is one
# click away on the bar. Rendering a live passphrase to the screen is an
# explicit action rather than something on display.
network_entry() {
  screen "Share this network"
  /usr/share/sway/scripts/wifi-qr.sh
}

# 18. ADAPTIVE BRIGHTNESS
#
# Report first, because the interesting failure is invisible: wluma
# auto-detects the light sensor, the backlight and the keyboard LED, and
# an explicit config section turns that detection OFF for whatever it
# names. We used to ship a config naming one specific ThinkPad, so every
# other machine got a dead webcam sensor and no backlight at all (#41).
#
# Nothing here writes /etc/xdg: that path is package-owned and a user edit
# there is a .pacnew conflict on the next upgrade. Overrides go to the
# user's own config, which replaces the shipped one wholesale.
# 12. POWER PROFILES
#
# power-profiles-daemon is installed and its service enabled, and until now
# nothing offered it: GNOME and KDE ship switchers, sway does not, so the
# only way in was powerprofilesctl from a shell (#67).
#
# The list is read from the daemon rather than hardcoded. Which profiles
# exist is hardware-dependent - `performance` is absent on some machines -
# and a profile can be present but degraded, with a reason like lap-detect
# or a thermal limit. That difference is the point: "unavailable" and
# "silently doing nothing" look identical from a menu that assumes three.
#
# No root_run anywhere here: switching goes over D-Bus through polkit,
# which the desktop session already satisfies.
power_entry() {
  local choice
  while true; do
    screen "Power"

    local active
    active=$(powerprofilesctl get 2>/dev/null)
    if [[ -z $active ]]; then
      oops "power-profiles-daemon is not answering."
      say "  systemctl status power-profiles-daemon"
      pause
      return 0
    fi
    say "Active: $active"

    # `powerprofilesctl list` prints a block per profile: the name ends
    # with a colon, the active one is marked with a leading *, and a
    # Degraded: line carries "no" or the reason. Parsed in one pass.
    local -a entries=()
    local name="" reason="" line
    while IFS= read -r line; do
      case $line in
        *:)
          # flush the previous block before starting another
          if [[ -n $name ]]; then
            if [[ -n $reason ]]; then
              entries+=("$name - degraded: $reason")
            else
              entries+=("$name")
            fi
          fi
          name=${line%:}
          name=${name#\*}
          name=${name// /}
          reason=""
          ;;
        *Degraded:*)
          # the value is separated by whitespace that is tabs as often as
          # spaces, so trimming one leading space left "  no" in place and
          # every healthy profile was labelled degraded
          reason=${line#*Degraded:}
          reason=${reason//[$' \t']/}
          [[ $reason == "no" ]] && reason=""
          ;;
      esac
    done < <(powerprofilesctl list 2>/dev/null)

    # the last block has no successor to flush it
    if [[ -n $name ]]; then
      if [[ -n $reason ]]; then
        entries+=("$name - degraded: $reason")
      else
        entries+=("$name")
      fi
    fi

    if ((${#entries[@]} == 0)); then
      oops "The daemon listed no profiles."
      pause
      return 0
    fi

    echo
    entries+=("Back")
    choice=$(gum choose --header "Power profile" "${entries[@]}") || return 0
    [[ $choice == "Back" ]] && return 0

    # the label may carry a degraded reason; the profile is the first word
    local target=${choice%% *}
    [[ $target == "$active" ]] && continue

    local out
    if out=$(powerprofilesctl set "$target" 2>&1); then
      # the bar reads the same daemon, so tell it to look now rather than
      # leaving the user watching a stale profile until the next poll
      waybar-signal power >/dev/null 2>&1 || true
    else
      oops "${out:-could not set $target}"
      pause
    fi
  done
}

wluma_entry() {
  local user_config="${XDG_CONFIG_HOME:-$HOME/.config}/wluma/config.toml"
  local choice

  while true; do
    screen "Adaptive brightness"

    if systemctl --user is-active wluma >/dev/null 2>&1; then
      say "✓ wluma is running"
    else
      warn "! wluma is not running"
      warn "  the waybar toggle starts it, or: systemctl --user enable --now wluma"
    fi

    # What it could possibly control, read from the machine rather than
    # assumed. A laptop with no backlight directory is a laptop where this
    # tool has nothing to do, and saying so beats an empty success.
    local backlights
    backlights=$(ls -A /sys/class/backlight 2>/dev/null | tr '\n' ' ')
    if [[ -n $backlights ]]; then
      say "  backlights: $backlights"
    else
      oops "  no /sys/class/backlight device - nothing to dim"
    fi

    # a glob rather than ls|grep: wluma matches on the same substring
    local leds=""
    for led in /sys/class/leds/*kbd_backlight*; do
      [[ -e $led ]] && leds+="${led##*/} "
    done
    [[ -n $leds ]] && say "  keyboard LEDs: $leds"

    # wluma discovers an IIO ambient light sensor when one exists and no
    # explicit [als.*] section overrides it. A real sensor beats inferring
    # room brightness from a webcam image, so it is worth naming.
    if [[ -d /sys/bus/iio/devices ]] &&
      compgen -G "/sys/bus/iio/devices/iio:device*" >/dev/null; then
      say "  ambient light sensor: present (IIO)"
    else
      say "  ambient light sensor: none found; wluma will use screen contents"
    fi

    echo
    if [[ -f $user_config ]]; then
      warn "Your own config overrides auto-detection:"
      say "  $user_config"
    else
      say "No user config: everything is auto-detected, which is usually right."
    fi

    echo
    choice=$(gum choose --header "Adaptive brightness" \
      "Show what wluma detected" "Edit my config" "Remove my config" "Back") || return 0

    case $choice in
      "Show what wluma detected")
        screen "Adaptive brightness"
        # The daemon logs what it discovered at debug level, which is the
        # only place the detected names appear. Reading its journal beats
        # reimplementing the detection and disagreeing with it.
        say "The last thing wluma logged:"
        echo
        journalctl --user -u wluma -n 25 --no-pager 2>&1 | sed "s/^/  /"
        echo
        say "Names and paths appear here with RUST_LOG=debug."
        pause
        ;;
      "Edit my config")
        # Seeded from the packaged example rather than from nothing: an
        # empty file is a valid config that changes no behaviour, and a
        # user who wanted to override something would have no idea what
        # the sections are called.
        mkdir -p "$(dirname "$user_config")"
        if [[ ! -f $user_config ]] && [[ -f /usr/share/wluma/examples/config.toml ]]; then
          {
            echo "# Everything below is OPTIONAL and every section you"
            echo "# uncomment turns OFF auto-detection for what it names."
            echo "# An empty file is the right config on most machines."
            echo
            sed "s/^/# /" /usr/share/wluma/examples/config.toml
          } > "$user_config"
        fi
        "${EDITOR:-vim}" "$user_config"
        systemctl --user restart wluma 2>/dev/null
        ;;
      "Remove my config")
        [[ -f $user_config ]] || { warn "There is no user config to remove."; pause; continue; }
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Delete $user_config and go back to auto-detection?" || continue
        rm -f "$user_config"
        systemctl --user restart wluma 2>/dev/null
        say "Removed. wluma will detect everything again."
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

main() {
  command -v gum >/dev/null || { echo "ashlaros-settings-tui: gum is not installed" >&2; exit 1; }

  while true; do
    screen "AshlarOS settings"

    # Entries are built rather than listed, so one pointing at a binary
    # that is not installed is absent rather than present and broken -
    # which is the rot #7 removed.
    local entries=("Keyboard layout" "System locale")
    command -v ashlaros-displays >/dev/null && entries+=("Displays")
    entries+=("Kernels")
    command -v pacseek >/dev/null && entries+=("Install packages")
    entries+=("Chat")
    entries+=("Time and date")
    command -v chwd >/dev/null && entries+=("Hardware profiles")
    command -v qrencode >/dev/null && command -v nmcli >/dev/null &&
      entries+=("Share this network")
    # a machine with no reader must not show the entry at all: fprintd is
    # installed everywhere, so the binary existing proves nothing
    if command -v fprintd-enroll >/dev/null &&
      fprintd-list "$ME" >/dev/null 2>&1; then
      entries+=("Fingerprint")
    fi
    # howdy-next is an optdepend, so the binary existing is already a
    # choice someone made - but a machine with no camera at all should
    # still not be offered face unlock. /dev/video0 is the weakest honest
    # test: whether the camera sees infrared is what the entry's own
    # recognition test decides, and it refuses to enable until it passes.
    if command -v howdy >/dev/null && compgen -G "/dev/video*" >/dev/null; then
      entries+=("Face unlock")
    fi
    # only where there is a backlight to adapt - the same predicate the
    # waybar toggle uses, so the bar and the menu agree about whether this
    # machine has the hardware at all
    if command -v wluma >/dev/null &&
      [[ -n $(ls -A /sys/class/backlight 2>/dev/null) ]]; then
      entries+=("Adaptive brightness")
    fi
    # Built only where the daemon answers. power-profiles-daemon is
    # installed on every desktop, so the binary existing proves nothing;
    # asking it is what distinguishes a machine it can drive from one it
    # cannot. Not gated on a backlight or a battery - profiles are neither
    # laptop- nor battery-specific, and a desktop can switch them too.
    if command -v powerprofilesctl >/dev/null &&
      powerprofilesctl get >/dev/null 2>&1; then
      entries+=("Power")
    fi
    # only when there is something to say - an entry that always reports
    # "nothing to do" is an entry people stop reading
    [[ -n $(pacman -Qtdq 2>/dev/null) ]] && entries+=("Unneeded packages")
    command -v zk >/dev/null && entries+=("Notes")
    command -v aerc >/dev/null && entries+=("Mail")
    command -v calcurse-caldav >/dev/null && entries+=("Calendar")
    entries+=("Background")
    command -v firefoxpwa >/dev/null && entries+=("Web apps")
    command -v aichat >/dev/null && entries+=("Model")
    entries+=("Quit")

    local choice
    choice=$(gum choose --header "Settings" "${entries[@]}") || exit 0

    case $choice in
      "Keyboard layout") keyboard_menu ;;
      "System locale") locale_menu ;;
      "Displays") displays_entry ;;
      "Kernels") kernel_menu ;;
      "Install packages") packages_entry ;;
      "Chat") chat_entry ;;
      "Time and date") time_menu ;;
      "Hardware profiles") hardware_menu ;;
      "Adaptive brightness") wluma_entry ;;
      "Power") power_entry ;;
      "Share this network") network_entry ;;
      "Fingerprint") fingerprint_entry ;;
      "Face unlock") face_entry ;;
      "Unneeded packages") orphans_entry ;;
      "Notes") notes_entry ;;
      "Mail") mail_entry ;;
      "Calendar") calendar_entry ;;
      "Background") background_entry ;;
      "Web apps") webapps_entry ;;
      "Model") model_entry ;;
      "Quit") exit 0 ;;
    esac
  done
}

main "$@"
