    # runs `$locking` at timeout 300, before-sleep and on `lock` - all three
    # reach lock.sh, which tries gtklock, waylock and swaylock in turn and
    # exits 0 having locked nothing when none is installed. Measured against
    # the real 594-package closure: none of the three was present, so the
    # screen has never locked on idle or on suspend. A lock that silently
    # does nothing is worse than one that is absent, because the lid closes
    # either way.
    'swaylock'
    # Credentials. The settings TUI offers to put mail and CalDAV passwords
    # in the login keyring, gated on `command -v secret-tool`; without it
    # the guard holds and it silently writes the password to a config file
    # in plaintext instead. A fallback nobody chose is not a fallback.
    'libsecret'
    # The media controls. waybar's custom/playerctl module and the
    # watch-playerctl unit both need it; absent, the bar module is dead and
    # the play/pause keys do nothing.
    'playerctl'
    # What the TUI's "Install packages" entry runs, and what CONTRIBUTING
    # names as the way applications are installed. The entry is gated on
    # `command -v pacseek`, so without it the row never appears at all.
    'pacseek'
    # The clipboard history. wl-clip-persist is already a hard dependency
    # above, and its whole job is keeping a selection alive after the app
    # that offered it exits - which is pointless with nothing storing the
    # history. Everything that consumes it ships here and is dead without
    # it: Super+Shift+p, /usr/bin/clipboard, waybar's custom/clipboard
    # module, cliphist-store.service, cliphist-watch.service, and the
    # shutdown mode's purge. capture-qr.sh's comment says "we ship
    # cliphist and wl-clip-persist" to justify marking a QR --sensitive,
    # which was only half true.
    'cliphist'
)
optdepends=(
    'gtklock: lockscreen based on gtkgreet'
    'wlsunset: time & place based light temperature'
    'swaycwd: open here helper'
    'poweralertd: battery and power notifications'
    'wluma: adaptive brightness based on screen contents and ALS'
    # the installer puts this on every x86_64 desktop; it stays optional
    # here because this package is arch=any and yay is not built for ARM
    'yay: AUR helper, for packages outside the repositories'
    'pcmanfm-qt: file manager'
    # never a hard dependency: the Ask key sends a picture of your screen
    # to whichever provider you configure, and an LLM tool on every
    # desktop by default is a statement this distribution should not make
    # on the user's behalf
    'aichat: ask a model about a screen region (Print, then a)'
    # mail is personal and aerc does nothing until it has an account, so
    # an unconfigured client in the launcher would be worse than none
    'aerc: terminal mail client, configured from the settings TUI'
    # never a hard dependency: pacman resolves 182 packages for it -
    # opencv is 112.81 MiB and qt6-base 66.53 MiB, measured - for an
    # infrared camera most machines do not have. And it is weaker than a
    # password: a similar face or a photo may work.
    'howdy-next: infrared face unlock for sudo, from the settings TUI'
    # switches on an infrared emitter the laptop leaves off - the usual
    # reason face unlock sees only darkness; set up from the same entry
    'linux-enable-ir-emitter: turn on the infrared emitter face unlock needs'
    # the desktop otherwise cannot open a .docx at all: this installs
    # Docs and Microsoft 365 as their own windows, from the settings TUI
    'firefoxpwa: Google Docs and Microsoft 365 as web apps'
    # 147 MB, and the only thing that faithfully round-trips Office
    # formats - which is why it is here rather than absent or default
    'libreoffice-still: full office suite, for real .docx round-tripping'
    # mounts Drive and OneDrive as a directory, which is the version of
    # "open it from the cloud" that does not publish the document first
    'rclone: mount Drive and OneDrive as local directories'
)
# generated_background.svg is rewritten on every theme apply, and the
# per-user theme.conf is the file the theme switcher edits
backup=()
install=ashlaros-settings.install

package() {
    local payload="${startdir}/payload"

    install -d "${pkgdir}/etc" "${pkgdir}/usr"
    cp -a "${payload}/etc/." "${pkgdir}/etc/"
    cp -a "${payload}/usr/." "${pkgdir}/usr/"

    # A __pycache__ left in a checkout is git-ignored but cp -a copies it
    # anyway, so a stale .pyc of a script we deleted can ship. Found exactly
    # that with weather.cpython-312.pyc after weather.py became weather.sh.
    find "${pkgdir}" -name __pycache__ -type d -prune -exec rm -rf {} +

    # cp -a keeps the source tree's modes; the scripts must be executable
    # whatever the checkout looked like
    # -type f under scripts/ reaches hw/ too, which is the point: a
    # predicate that is not executable answers nothing
    find "${pkgdir}/usr/bin" "${pkgdir}/usr/local/bin" \
        "${pkgdir}/usr/share/sway/scripts" \
        "${pkgdir}/usr/share/ashlaros/migrations" -type f -exec chmod 755 {} +

    write_google_oauth_client "${pkgdir}"
}

# The OAuth client AshlarOS is registered as with Google, written at build
# time from the environment rather than committed.
#
# GNOME ships the equivalent values compiled into gnome-online-accounts and
# every distribution packages them unchanged, so shipping ours is the
# ordinary thing to do - but a credential in git cannot be rotated without
# rewriting history, and GitHub's push protection rejects it besides. The
# release workflow supplies GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from
# repository secrets; rotating is then editing a secret and rebuilding.
#
# A build without them is not an error. The package ships no default client
# and the settings entry falls back to the one a user puts in
# ~/.config/ashlaros/google-oauth-client, which is the path anyone building
# from a clean checkout takes.
write_google_oauth_client() {
    local pkgdir="$1"
    local target="${pkgdir}/usr/share/ashlaros/google-oauth-client"

    if [[ -z ${GOOGLE_CLIENT_ID:-} || -z ${GOOGLE_CLIENT_SECRET:-} ]]; then
        echo "==> no GOOGLE_CLIENT_ID/SECRET in the environment;" \
             "shipping no default OAuth client" >&2
        return 0
    fi

    install -d "${pkgdir}/usr/share/ashlaros"
    cat > "${target}" <<EOF
# Generated by the ashlaros-settings PKGBUILD. Not a secret in the usual
# sense: for a native application Google documents the client secret as
# optional under PKCE, and it is public by construction once the client
# runs on a user's machine. It identifies the application, not the user -
# signing in happens in the user's browser against their own account, and
# the token that comes back stays on their disk.
#
# Override it in ~/.config/ashlaros/google-oauth-client.
GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}"
GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET}"
EOF
    chmod 644 "${target}"
}
