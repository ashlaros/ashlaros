#!/usr/bin/env python3
"""Gesture reactions on a virtual camera.

Reads the real camera, recognises hand gestures, draws the reaction they
ask for, and writes the result to the "AshlarOS Camera" loopback device -
the camera a call or the browser is pointed at instead of the real one.

The real camera is open only while something reads the virtual one:
v4l2loopback says when readers come and go, and between them this holds
the device with one black frame and nothing else. So the camera light
means what it always meant.

Which real camera is a priority list: the first one plugged in wins, a
better one plugged in mid-call takes over, and unplugging it falls back
to the next - the call keeps the same virtual camera throughout.

    ashlaros-reactions            run, as ashlaros-reactions.service does
    ashlaros-reactions IMAGE...   print the gestures found in still images
"""

import os
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/ashlaros-reactions")

import cv2
import effects
import gestures
import hands
import loopback
import numpy as np

MODELS = Path("/usr/share/ashlaros-reactions/models")
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "ashlaros-reactions"
WIDTH, HEIGHT, FPS = 1280, 720, 30
# how often a running stream looks for a camera it would rather be using
RECHECK = 1.0
# a camera that would not open is not tried again for this long, or a
# preferred camera busy in another application would have the stream
# hop to it and back every RECHECK
COOLDOWN = 15.0
# what stream() returns when a better camera has turned up
SWITCH = "switch"

# How long a gesture has to be held before it counts, and how confidently.
# Half a second is long enough that a hand passing through a thumbs-up on
# its way somewhere else does not set off fireworks mid-sentence.
HOLD = 0.5
MIN_SCORE = 0.6
# After a reaction, the same gesture must be let go of for this long
# before it can fire again: holding a thumb up is one thumbs-up.
RELEASE = 0.6


def log(message: str):
    print(message, file=sys.stderr, flush=True)


def _external(path: Path) -> bool:
    """Whether the camera is a plug-in one. The USB device's `removable`
    comes from the firmware's description of the port: a laptop's own
    camera sits on a port marked fixed, anything plugged in does not."""
    node = Path("/sys/class/video4linux") / path.resolve().name / "device"
    try:
        removable = (node.resolve().parent / "removable").read_text().strip()
    except OSError:
        return True
    return removable != "fixed"


def cameras() -> list[str]:
    """The colour cameras plugged in now, best first.

    ASHLAROS_REACTIONS_CAMERAS lists by-id paths in the order Settings was
    given; cameras it does not name follow, plug-in ones before built-in,
    so with nothing configured an external camera is preferred while it
    is there. An infrared camera is never used: it sees in grey, and a
    call would get a ghost."""
    present = [p for p in sorted(Path("/dev/v4l/by-id").glob("*-video-index0"))
               if "ir_camera" not in p.name.lower() and "_ir_" not in p.name.lower()]
    order = os.environ.get("ASHLAROS_REACTIONS_CAMERAS", "").split()
    present.sort(key=lambda p: (str(p) not in order,
                                order.index(str(p)) if str(p) in order else 0,
                                not _external(p)))
    return [str(p) for p in present]


def fit(frame: np.ndarray) -> np.ndarray:
    """Cropped to 16:9 and scaled to the output size: a 4:3 camera keeps
    its proportions rather than being stretched."""
    h, w = frame.shape[:2]
    if w * HEIGHT > h * WIDTH:
        cut = (w - h * WIDTH // HEIGHT) // 2
        frame = frame[:, cut:w - cut]
    elif w * HEIGHT < h * WIDTH:
        cut = (h - w * HEIGHT // WIDTH) // 2
        frame = frame[cut:h - cut]
    if frame.shape[:2] != (HEIGHT, WIDTH):
        frame = cv2.resize(frame, (WIDTH, HEIGHT), interpolation=cv2.INTER_AREA)
    return frame


def notice(text: str) -> np.ndarray:
    """A dark frame with a line of text, for when there is no picture to
    show: better a reason on the call than a frozen face."""
    frame = np.full((HEIGHT, WIDTH, 3), 24, np.uint8)
    font, scale, weight = cv2.FONT_HERSHEY_SIMPLEX, 1.1, 2
    (tw, th), _ = cv2.getTextSize(text, font, scale, weight)
    cv2.putText(frame, text, ((WIDTH - tw) // 2, (HEIGHT + th) // 2), font, scale,
                (200, 200, 200), weight, cv2.LINE_AA)
    return frame


def yuyv(frame: np.ndarray) -> bytes:
    return cv2.cvtColor(frame, cv2.COLOR_BGR2YUV_YUY2).tobytes()


class Recogniser(threading.Thread):
    """Runs the models on the newest frame whenever it is free. Frames that
    arrive while it is busy are skipped rather than queued, so the picture
    never waits on recognition: on a slow machine the reactions get slower
    to notice, and the video does not stutter."""

    def __init__(self):
        super().__init__(daemon=True)
        self.hands = hands.Hands(MODELS)
        self.lock = threading.Condition()
        self.frame = None
        self.result: tuple[float, list[hands.Hand]] = (0.0, [])

    def offer(self, frame: np.ndarray):
        with self.lock:
            self.frame = frame
            self.lock.notify()

    def reset(self):
        with self.lock:
            self.frame = None
            self.result = (0.0, [])
        self.hands.tracked = []

    def run(self):
        while True:
            with self.lock:
                while self.frame is None:
                    self.lock.wait()
                frame, self.frame = self.frame, None
            found = self.hands.process(frame)
            with self.lock:
                self.result = (time.monotonic(), found)


class Trigger:
    """Turns a stream of recognised hands into reactions: a pose held for
    HOLD seconds fires once, and fires again only after it was let go."""

    def __init__(self):
        self.candidate = None
        self.since = 0.0
        self.spent: dict[str, float] = {}

    def pose(self, found: list[hands.Hand]) -> tuple[str | None, list[hands.Hand]]:
        """The reaction the hands ask for this frame, and the hands asking."""
        together = gestures.both(found) if len(found) == 2 else None
        if together:
            return effects.DOUBLE[together], found
        named = [(gestures.single(h, MIN_SCORE), h) for h in found]
        if len(named) == 2 and named[0][0] and named[0][0] == named[1][0]:
            return effects.DOUBLE[named[0][0]], found
        # one hand making a gesture, whatever the other is doing
        for name, hand in named:
            if name:
                return effects.SINGLE[name], [hand]
        return None, []

    def update(self, found: list[hands.Hand], now: float):
        name, asking = self.pose(found)
        for spent, last_seen in list(self.spent.items()):
            if spent == name:
                self.spent[spent] = now
            elif now - last_seen > RELEASE:
                del self.spent[spent]

        if name != self.candidate:
            self.candidate, self.since = name, now
            return None
        if name is None or name in self.spent or now - self.since < HOLD:
            return None
        self.spent[name] = now
        x, y = np.concatenate([h.pixels for h in asking]).mean(0)
        return name, x, y


def stream(camera_path: str, out: loopback.Loopback, recogniser: Recogniser,
           library: effects.Library, preferred) -> str | None:
    """One reading session: the camera is open from here to the return.
    Returns None when the last reader left, SWITCH when preferred() names
    a better camera than this one, or why the camera failed."""
    camera = cv2.VideoCapture(camera_path, cv2.CAP_V4L2)
    if not camera.isOpened():
        return f"{camera_path} could not be opened"
    try:
        # MJPG: on UVC cameras the uncompressed modes top out at a few
        # frames a second at this size
        camera.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter.fourcc(*"MJPG"))
        camera.set(cv2.CAP_PROP_FRAME_WIDTH, WIDTH)
        camera.set(cv2.CAP_PROP_FRAME_HEIGHT, HEIGHT)
        camera.set(cv2.CAP_PROP_FPS, FPS)

        trigger = Trigger()
        playing: list[tuple[effects.Effect, float]] = []
        handled = 0.0
        checked = time.monotonic()
        log(f"streaming from {camera_path}")
        while out.wait(0):
            ok, frame = camera.read()
            if not ok:
                return f"{camera_path} stopped delivering frames"
            frame = fit(frame)
            recogniser.offer(frame.copy())

            now = time.monotonic()
            if now - checked > RECHECK:
                checked = now
                best = preferred()
                if best and best != camera_path:
                    log(f"{best} is preferred; switching to it")
                    return SWITCH
            with recogniser.lock:
                stamp, found = recogniser.result
            if stamp > handled:
                handled = stamp
                # one reaction at a time, as on a call two at once is noise
                fired = None if playing else trigger.update(found, now)
                if fired:
                    name, x, y = fired
                    log(f"reaction: {name}")
                    playing.append((library.make(name, WIDTH, HEIGHT, x, y), now))

            for effect, start in playing:
                effect.draw(frame, now - start)
            playing = [(e, s) for e, s in playing if now - s < e.length]
            out.write(yuyv(frame))
        return None
    finally:
        camera.release()
        recogniser.reset()


def run() -> int:
    device = loopback.find_device()
    if device is None:
        log(f'no "{loopback.CARD_LABEL}" device: is v4l2loopback loaded with '
            "/etc/modprobe.d/ashlaros-reactions.conf's options?")
        return 1
    out = loopback.Loopback(device, WIDTH, HEIGHT, FPS)
    idle = yuyv(np.zeros((HEIGHT, WIDTH, 3), np.uint8))
    # one frame makes the device a capture device that applications list;
    # until then it advertises itself as an output and nothing offers it
    out.write(idle)
    log(f"waiting for a reader on {device}")

    recogniser = Recogniser()
    recogniser.start()
    library = effects.Library(CACHE, HEIGHT)
    failed: dict[str, float] = {}

    def usable() -> list[str]:
        now = time.monotonic()
        return [c for c in cameras() if now - failed.get(c, -COOLDOWN) >= COOLDOWN]

    def preferred() -> str | None:
        return next(iter(usable()), None)

    while True:
        # wait(0) first: blocking would sleep through a reader who is
        # already there, waiting for one to arrive
        if not (out.wait(0) or out.wait(None)):
            continue
        problem = "no camera found"
        # down the list until one streams: an unplugged or busy camera
        # falls through to the next without the reader seeing a gap
        for camera in usable():
            outcome = stream(camera, out, recogniser, library, preferred)
            if outcome in (None, SWITCH):
                break
            problem = outcome
            failed[camera] = time.monotonic()
            log(problem)
        else:
            out.write(yuyv(notice(problem)))
            # tried again while someone is still watching: a camera may be
            # busy in another application, or about to be plugged in
            time.sleep(2)
            continue
        if outcome is None:
            log("no readers left; camera closed")
            # the last thing written is what the next reader sees first,
            # and it must not be a frame of whoever was on the last call
            out.write(idle)


def describe(paths: list[str]) -> int:
    recogniser = hands.Hands(MODELS)
    for path in paths:
        image = cv2.imread(path)
        if image is None:
            log(f"{path}: not an image")
            return 1
        recogniser.tracked = []
        found = recogniser.process(image)
        reaction, _ = Trigger().pose(found)
        summary = ", ".join(f"{gestures.single(h, MIN_SCORE) or h.gesture} {h.score:.2f}"
                            for h in found) or "no hands"
        print(f"{path}: {summary}{f' -> {reaction}' if reaction else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(describe(sys.argv[1:]) if len(sys.argv) > 1 else run())
