[Unit]
# Taildrop receives are pull-based and Arch ships no unit for it: without
# something running, files sit in an invisible inbox and the sender sees a
# successful send. This is what makes "send a photo to the laptop" arrive.
#
# --conflict=rename rather than the `skip` default: silently dropping the
# second copy of a filename is the worst failure mode here, because both
# ends report success.
#
# There is no default receive directory on generic Linux - tailscale's
# paths.go special-cases only Synology, TrueNAS, QNAP and Unraid - so the
# XDG download dir is named explicitly.
Description=Receive Taildrop files
PartOf=sway-session.target
After=sway-session-pre.target

[Service]
# Only for the tailnet operator. tailscaled answers every other account's
# `file get` with "Access denied" and --loop retries that every few seconds
# for the life of the session - thousands of journal lines a day from a
# receiver that can never receive. The operator is set from Settings ->
# Tailscale, which starts this once it has.
ExecCondition=/bin/sh -c '[ "$(tailscale debug prefs 2>/dev/null | jq -r .OperatorUser)" = "$(id -un)" ]'
ExecStart=/bin/sh -c 'exec /usr/bin/tailscale file get --loop --conflict=rename "$(xdg-user-dir DOWNLOAD)"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sway-session.target
