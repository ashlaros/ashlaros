# Maintainer: AshlarOS <build@ashlaros.download>

# Rebuilt once when source_hash began covering the executable bit. A
# retry at the same version cannot work here: cargo --release is not
# byte-reproducible, so the guard sees different bytes at a published
# name and refuses. The version is derived from this directory's
# commit count, so a commit here is what gives a retry its own name.
pkgname=ashlaros-arcade
pkgver=20260914
pkgrel=1
pkgdesc="The AshlarOS games, natively: Courses and Quarry"
arch=('x86_64' 'aarch64')
url="https://github.com/ashlaros/ashlaros"
license=('GPL-3.0-or-later')
# raylib rather than a vendored copy: 6.0 is in extra on both
# architectures, and a package that bundles its own would ship a second,
# unpatched copy of a library the distribution already carries.
#
# libx11 is named here because Arch's raylib declares no dependencies at
# all while linking libX11.so.6 - installing this package without it
# yields a binary that cannot start. Depending on what we actually load
# is right regardless of whether that is ever fixed upstream.
depends=('raylib' 'libx11' 'glibc' 'gcc-libs')
# clang, because raylib-sys generates its bindings with bindgen at build
# time and bindgen loads libclang to parse raylib.h
#
# nodejs, because the cues are synthesized rather than shipped as
# tracked binary files - the same script the web page runs at
# development time runs here, so both the site and the package always
# carry the current mix rather than a WAV someone forgot to regenerate.
makedepends=('cargo' 'clang' 'nodejs')
options=('!lto')  # the crate sets its own in the release profile

prepare() {
    # The sources are the checkout, not a tarball: the simulation this
    # links is the same crate the worker compiles to wasm, and pulling a
    # released copy of it would let the two drift.
    rm -rf "${srcdir}/build"
    mkdir -p "${srcdir}/build"
    cp -a "${startdir}/../../core" "${startdir}/../../client" "${srcdir}/build/"
    # the generator script, not the audio directory it writes: the
    # WAVs it produces are gitignored, so a checkout has the recipe and
    # never the bytes
    install -Dm644 "${startdir}/../../scripts/game-sfx.mjs" "${srcdir}/build/game-sfx.mjs"

    cd "${srcdir}/build/client"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/build/client"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release

    node "${srcdir}/build/game-sfx.mjs" "${srcdir}/build/audio"
}

check() {
    # The determinism tests, run where the package is built: a binary
    # whose arithmetic disagrees with the server's would score its
    # player's runs into rejection, and that is worth catching here
    # rather than on a leaderboard.
    cd "${srcdir}/build/core"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release
}

package() {
    cd "${srcdir}/build/client"
    install -Dm0755 target/release/ashlaros-arcade "${pkgdir}/usr/bin/ashlaros-arcade"
    install -Dm644 "${startdir}/ashlaros-arcade.desktop" \
        "${pkgdir}/usr/share/applications/ashlaros-arcade.desktop"
    install -d "${pkgdir}/usr/share/ashlaros-arcade/audio"
    install -m644 "${srcdir}/build/audio/"*.wav \
        -t "${pkgdir}/usr/share/ashlaros-arcade/audio"
}
