#!/usr/bin/env bash
# One entry point for the settings that are otherwise commands you have to
# know: localectl, timedatectl, chwd, the kernel variants in the cachyos
# repository.
#
# A launcher, not a control panel. Every entry either runs an existing tool
# or collects input and runs one command; the menu owns no settings logic
# of its own. If an entry grows past that, it belongs in its own tool with
# its own issue - which is what way-displays got.
#
# gum and the padding conventions are the installer's (installer/
# configurator); this deliberately does not invent a second TUI style.
#
# Privileges are taken per action rather than by running the whole thing
# under sudo: a long-running root TUI on a desktop is a bigger blast radius
# than it needs, and the installed user is a sudoer, so a prompt is
# expected where one is due.
set -uo pipefail

# Who this actually is, asked of the kernel rather than the environment.
# $USER is just an exported string: `USER=root ashlaros-settings-tui` makes
# every enrolment below target an account this is not, and a face model
# enrolled against the wrong user is a PAM rule that never matches - or one
# that matches for somebody else.
ME=$(id -un)

# The accent is the theme's own $accent-color, resolved from the sway
# theme.conf the theme switcher writes - the colour the prompt, the bar and
# the lock screen are generated from. Not a palette slot: themes disagree
# about what slot 4 is, and on some it is a grey that reads as disabled.
# Palette 4 only where there is no theme.conf, outside an AshlarOS session.
theme_accent() {
  local conf=$HOME/.config/sway/definitions.d/theme.conf
  [[ -r $conf ]] || return 1
  # Follows the reference chain: ashlaros names $color12, catppuccin names
  # $blue, which is itself a hex. Bounded, so a cycle cannot hang the menu.
  awk '$1 == "set" { v[$2] = $3 }
    END {
      c = v["$accent-color"]
      for (i = 0; i < 5 && c ~ /^\$/; i++) c = v[c]
      if (c ~ /^#[0-9A-Fa-f]{6}$/) { print c; exit 0 }
      exit 1
    }' "$conf"
}
C_ACCENT=$(theme_accent) || C_ACCENT=4
readonly C_ACCENT C_DIM=8 C_OK=2 C_WARN=3 C_ERR=1

# gum decides on colour per call, from whether its own stdout is a
# terminal. Almost every styled string here is built inside $( ), where it
# is not, so without this every header, mark and hint came out plain.
# Forced only when this script itself is on a terminal: piped or logged,
# it stays plain text.
[[ -t 1 ]] && export CLICOLOR_FORCE=1

export GUM_CHOOSE_CURSOR="▌ "
export GUM_CHOOSE_CURSOR_FOREGROUND="$C_ACCENT"
export GUM_CHOOSE_HEADER_FOREGROUND="$C_DIM"
export GUM_CHOOSE_SELECTED_FOREGROUND="15"
export GUM_FILTER_INDICATOR="▌"
export GUM_FILTER_INDICATOR_FOREGROUND="$C_ACCENT"
export GUM_FILTER_MATCH_FOREGROUND="$C_ACCENT"
export GUM_FILTER_HEADER_FOREGROUND="$C_DIM"
export GUM_FILTER_PROMPT_FOREGROUND="$C_ACCENT"
export GUM_INPUT_CURSOR_FOREGROUND="$C_ACCENT"
export GUM_INPUT_PROMPT_FOREGROUND="$C_ACCENT"
export GUM_INPUT_HEADER_FOREGROUND="$C_DIM"
export GUM_CONFIRM_PROMPT_FOREGROUND="15"
export GUM_CONFIRM_SELECTED_BACKGROUND="$C_ACCENT"
export GUM_CONFIRM_SELECTED_FOREGROUND="0"
export GUM_CONFIRM_UNSELECTED_BACKGROUND="$C_DIM"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="7"
export GUM_SPIN_SPINNER="dot"
export GUM_SPIN_SPINNER_FOREGROUND="$C_ACCENT"

PADDING_LEFT=2
padding() {
  local p="0 0 0 $PADDING_LEFT"
  export GUM_CHOOSE_PADDING="$p" GUM_INPUT_PADDING="$p" GUM_CONFIRM_PADDING="$p"
  export GUM_FILTER_PADDING="$p"
}
padding

# Status lines are written as `say "✓ ..."` and `warn "! ..."` throughout;
# the mark is coloured here rather than at 50 call sites. Plain ANSI, not
# gum style, for the mark: nested gum styling resets the colour of the
# text after it.
say() {
  if [[ $# -eq 1 && $1 == "✓ "* ]]; then
    gum style --padding "0 0 0 $PADDING_LEFT" $'\e[3'"$C_OK"$'m✓\e[0m'"${1#✓}"
  else
    gum style --padding "0 0 0 $PADDING_LEFT" "$@"
  fi
}
warn() {
  if [[ $# -eq 1 && $1 == "! "* ]]; then
    gum style --foreground "$C_WARN" --padding "0 0 0 $PADDING_LEFT" "▲${1#!}"
  else
    gum style --foreground "$C_WARN" --padding "0 0 0 $PADDING_LEFT" "$@"
  fi
}
oops() { gum style --foreground "$C_ERR" --padding "0 0 0 $PADDING_LEFT" "$@"; }
# --faint rather than palette 8: 8 is "bright black", which several themes
# set within a shade of the background, and a hint nobody can read is not
# a hint
hint() { gum style --faint --padding "0 0 0 $PADDING_LEFT" "$@"; }

# The mark, AshlarOS Symbols' U+F8FE, which the prompt and the bar's menu
# button use too: this is the same desktop, not a separate tool.
readonly MARK=$'\xef\xa3\xbe'

# One header for every screen: the mark and "Settings" in the accent, then
# the screen's own title - so where you are is always the first line, and
# the way back is always the same distance up.
screen() {
  printf '\033[H\033[2J'
  echo
  local crumb
  # the mark unbolded: AshlarOS Symbols has no bold face, and asking for
  # one gets the missing-glyph box instead
  crumb=$(gum style --foreground "$C_ACCENT" "$MARK")"  "$(gum style --foreground "$C_ACCENT" --bold "Settings")
  if [[ ${1-} && $1 != Settings ]]; then
    crumb+=$(gum style --faint "  ›  ")$(gum style --bold "$1")
  fi
  gum style --padding "0 0 0 $PADDING_LEFT" "$crumb"
  echo
}

pause() {
  echo
  gum confirm --affirmative "Back" --negative "" "" >/dev/null 2>&1
}

# A username in a URL is an email address more often than not, and the @
# in it ends the userinfo component - so aerc parses the domain as part of
# the host and the account never connects. Percent-encoding is the fix the
# URL grammar already provides.
url_escape() {
  # LC_ALL=C so the loop walks bytes: percent-encoding is defined over
  # octets, and a character-wise loop encodes U+00FC as %FC rather than
  # the %C3%BC a server is expecting.
  local s=$1 out="" i c
  local LC_ALL=C
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c" && out+=$c ;;
    esac
  done
  printf '%s' "$out"
}

# Creates a config file private BEFORE anything is written into it.
#
# `{ ... } > file` creates it with the user's umask, which is 022 on a
# fresh install - so a file holding a password or a refresh token exists
# world-readable for as long as the block takes to write, and the chmod
# afterwards closes a door that was already open. Touching it first makes
# the private mode the mode it is created with.
private_file() {
  local path=$1
  mkdir -p "$(dirname "$path")"
  [[ -e $path ]] || : > "$path"
  chmod 600 "$path"
}

# Runs a command as root and reports rather than failing silently: a
# permission error that prints nothing is indistinguishable from a setting
# that did not take.
root_run() {
  local out
  if ! out=$(sudo "$@" 2>&1); then
    oops "That needed root and did not succeed:"
    say "${out:-no output}"
    return 1
  fi
  [[ -n $out ]] && say "$out"
  return 0
}

# One setting from a file of `key = value`, `key=value` or `key value`
# lines - weather.cfg, wlsunset's config, the location file, a systemd
# EnvironmentFile and a sway `set $name value` alike. The key is text, as
# in conf_line. Empty when the file or the key is absent.
conf_get() {
  K=$2 awk '
    { s = $0; sub(/^[ \t]+/, "", s) }
    substr(s, 1, length(ENVIRON["K"])) == ENVIRON["K"] {
      rest = substr(s, length(ENVIRON["K"]) + 1)
      if (rest !~ /^[ \t]*=/ && rest !~ /^[ \t]/) next
      sub(/^[ \t]*=?[ \t]*/, "", rest); sub(/[ \t]+$/, "", rest)
      print rest; exit
    }' "$1" 2>/dev/null
}

# Sets one line of such a file and keeps every other: the first line that
# starts with the key $2 - after leading blanks, and followed by a blank or
# "=" - becomes $3, later ones go, and $3 is appended when none did. So a
# file someone edited by hand keeps their lines, and one this wrote keeps
# the others it wrote. The key is compared as text, not as a pattern:
# `set $gaps` and `input type:touchpad tap` are keys too.
conf_line() {
  local file=$1 key=$2 line=$3 tmp
  mkdir -p "$(dirname "$file")"
  [[ -e $file ]] || echo "# written by ashlaros-settings-tui" > "$file"
  tmp=$(mktemp "$file.XXXXXX") || return 1
  # ENVIRON rather than -v: awk -v processes escapes, and would read
  # `set \$gaps` back as something else
  K=$key L=$line awk '
    function is_key(s,  rest) {
      sub(/^[ \t]+/, "", s)
      if (substr(s, 1, length(ENVIRON["K"])) != ENVIRON["K"]) return 0
      rest = substr(s, length(ENVIRON["K"]) + 1)
      return rest ~ /^[ \t]*=/ || rest ~ /^[ \t]/
    }
    is_key($0) { if (!done) print ENVIRON["L"]; done = 1; next }
    { print }
    END { if (!done) print ENVIRON["L"] }' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod --reference="$file" "$tmp" 2>/dev/null
  mv -- "$tmp" "$file"
}

# On and off for a user unit that etc/sway/autostart enables at every
# login. Off is a mask, not a disable: the next login's `enable --now`
# undoes a disable, while it fails against a mask - loudly, and harmlessly.
# A comparison, not `| grep -q`: grep quits at the match, systemctl dies of
# SIGPIPE, and under pipefail that reads as "not masked" exactly when it is.
unit_masked() { [[ $(systemctl --user is-enabled "$1" 2>/dev/null) == masked ]]; }
unit_switch() {
  if [[ $2 == on ]]; then
    systemctl --user unmask "$1" >/dev/null 2>&1
    systemctl --user enable --now "$1" >/dev/null 2>&1
  else
    systemctl --user mask --now "$1" >/dev/null 2>&1
  fi
}

# 1. LOCALE AND KEYBOARD
#
# localectl is the mechanism #14 settled on: it writes
# /etc/X11/xorg.conf.d/00-keyboard.conf, which keyboard.sh reads at sway
# startup. Setting it here and re-running that script is what makes the
# change reach the session that is already running, rather than the next
# login.
#
# localectl lists only xkeyboard-config's main registry. EurKEY (`eu`) ships
# symbols but is registered in the extras alone, so it is added back here,
# as the installer's configurator does.
XKB_SYMBOLS_DIR=/usr/share/X11/xkb/symbols
XKB_UNREGISTERED=(eu)

xkb_layouts() {
  {
    localectl list-x11-keymap-layouts 2>/dev/null
    local name
    for name in "${XKB_UNREGISTERED[@]}"; do
      [[ -f $XKB_SYMBOLS_DIR/$name ]] && echo "$name"
    done
  } | sort -u
}

# The X11 keymap as localectl has it. Layout and Variant are comma lists
# in step with each other; the first layout is the one a session starts in.
x11_field() { localectl status | sed -n "s/^ *X11 $1: *//p" | head -1; }

# The key that switches layouts is an xkb option like any other: grp:
# picks the key, grp_led: the light that shows you are off the first one.
# Super+Space is not offered - it is sway's focus toggle.
KEYMAP_SWITCHES=(
  "grp:caps_toggle,grp_led:caps|Caps Lock (Shift+Caps Lock for capitals)"
  "grp:alt_shift_toggle|Alt+Shift"
  "grp:ctrl_shift_toggle|Ctrl+Shift"
  "grp:shifts_toggle|Both Shift keys"
)

join_commas() { local IFS=,; printf '%s' "$*"; }

keymap_options_without_switch() {
  tr ',' '\n' <<<"$1" | grep -v -E '^grp(_led)?:' | paste -sd,
}

keymap_switch_name() {
  local entry
  for entry in "${KEYMAP_SWITCHES[@]}"; do
    [[ ,$1, == *,"${entry%%[,|]*}",* ]] && { printf '%s' "${entry#*|}"; return; }
  done
  printf 'nothing - no switch key is set'
}

# One call for the whole keymap, so localectl never holds a layout list
# paired with the previous variants. Model is kept as it was.
keymap_apply() {
  local layouts=$1 variants=$2 options=$3
  [[ $variants =~ ^,*$ ]] && variants=""
  options=$(sed 's/^,*//; s/,*$//; s/,,*/,/g' <<<"$options")
  root_run localectl set-x11-keymap "$layouts" "$(x11_field Model)" \
    "$variants" "$options" || return 1
  # The running session, not just the next one - on the same condition
  # autostart has: a layout pinned in config.d is left where it is.
  if [[ -x /usr/share/sway/scripts/keyboard.sh ]] && [[ -n ${SWAYSOCK:-} ]] &&
    ! grep -qs 'xkb_layout' "$HOME"/.config/sway/config.d/*.conf; then
    /usr/share/sway/scripts/keyboard.sh >/dev/null 2>&1
  fi
  return 0
}

# A layout and, where it has any, one of its variants: "layout<TAB>variant".
keymap_pick_new() {
  local layout variant variants
  layout=$(xkb_layouts |
    gum filter --header "Layout" --placeholder "type to filter") || return 1
  [[ -n $layout ]] || return 1
  variants=$(localectl list-x11-keymap-variants "$layout" 2>/dev/null)
  if [[ -n $variants ]]; then
    variant=$({ echo "(standard)"; echo "$variants"; } |
      gum filter --header "Variant of $layout" --placeholder "type to filter") ||
      return 1
    [[ $variant == "(standard)" ]] && variant=""
  fi
  printf '%s\t%s' "$layout" "${variant-}"
}

keyboard_menu() {
  local -a layouts variants
  local options choice pick i n
  while true; do
    screen "Keyboard layout"
    IFS=, read -ra layouts <<<"$(x11_field Layout)"
    IFS=, read -ra variants <<<"$(x11_field Variant)"
    options=$(x11_field Options)
    n=${#layouts[@]}
    for ((i = 0; i < n; i++)); do variants[i]=${variants[i]-}; done

    local -a labels=()
    for ((i = 0; i < n; i++)); do
      labels+=("${layouts[i]}${variants[i]:+ (${variants[i]})}")
    done
    if ((n == 0)); then
      say "No layout is set, so the desktop uses English (US)."
    elif ((n == 1)); then
      say "Layout: ${labels[0]}"
    else
      say "Layouts, the first is the one a session starts in:"
      for ((i = 0; i < n; i++)); do say "  $((i + 1)). ${labels[i]}"; done
      echo
      say "Switch with: $(keymap_switch_name "$options")"
    fi
    echo

    local -a entries
    if ((n <= 1)); then
      entries=("Change the layout" "Add another layout" "Back")
    else
      entries=("Add another layout" "Remove one" "Make one the first"
        "Switch key" "Back")
    fi
    choice=$(gum choose --header "Keyboard layout" "${entries[@]}") || return 0

    case $choice in
      "Change the layout")
        pick=$(keymap_pick_new) || continue
        keymap_apply "${pick%%$'\t'*}" "${pick#*$'\t'}" \
          "$(keymap_options_without_switch "$options")" &&
          say "✓ Layout set to ${pick%%$'\t'*}."
        ;;
      "Add another layout")
        pick=$(keymap_pick_new) || continue
        local label="${pick%%$'\t'*}"
        [[ -n ${pick#*$'\t'} ]] && label+=" (${pick#*$'\t'})"
        if printf '%s\n' "${labels[@]}" | grep -qxF "$label"; then
          warn "! $label is already one of them."
          pause
          continue
        fi
        layouts+=("${pick%%$'\t'*}")
        variants+=("${pick#*$'\t'}")
        # Caps Lock unless a switch key is already chosen: the one the
        # shipped config.d example uses, and the one key most people never
        # hold down deliberately. Only from two layouts on - with one there
        # is nothing to switch to and Caps Lock would just stop working.
        ((${#layouts[@]} >= 2)) && [[ $options != *grp:* ]] &&
          options+=",grp:caps_toggle,grp_led:caps"
        if keymap_apply "$(join_commas "${layouts[@]}")" \
          "$(join_commas "${variants[@]}")" "$options"; then
          say "✓ Added $label."
          ((${#layouts[@]} >= 2)) &&
            say "$(keymap_switch_name "$options" | sed 's/ (.*//') switches between them."
        fi
        ;;
      "Remove one")
        i=$(for ((i = 0; i < n; i++)); do printf '%s|%s\n' "${labels[i]}" "$i"; done |
          gum choose --label-delimiter="|" --header "Remove") || continue
        local gone=${labels[i]}
        unset 'layouts[i]' 'variants[i]'
        layouts=("${layouts[@]}") variants=("${variants[@]}")
        # With one layout, grp:caps_toggle does not fall back to Caps Lock -
        # the key just stops doing anything. So the switch goes with it.
        ((${#layouts[@]} == 1)) && options=$(keymap_options_without_switch "$options")
        keymap_apply "$(join_commas "${layouts[@]}")" \
          "$(join_commas "${variants[@]}")" "$options" &&
          say "✓ Removed $gone."
        ;;
      "Make one the first")
        i=$(for ((i = 1; i < n; i++)); do printf '%s|%s\n' "${labels[i]}" "$i"; done |
          gum choose --label-delimiter="|" --header "First") || continue
        layouts=("${layouts[i]}" "${layouts[@]:0:i}" "${layouts[@]:i+1}")
        variants=("${variants[i]}" "${variants[@]:0:i}" "${variants[@]:i+1}")
        keymap_apply "$(join_commas "${layouts[@]}")" \
          "$(join_commas "${variants[@]}")" "$options" &&
          say "✓ ${labels[i]} is now the first."
        ;;
      "Switch key")
        local key
        key=$(printf '%s\n' "${KEYMAP_SWITCHES[@]}" |
          awk -F'|' '{ print $2 "|" $1 }' |
          gum choose --label-delimiter="|" --header "Switch layouts with") || continue
        keymap_apply "$(join_commas "${layouts[@]}")" \
          "$(join_commas "${variants[@]}")" \
          "$(keymap_options_without_switch "$options"),$key" &&
          say "✓ $(keymap_switch_name "$key") switches layouts."
        ;;
      "Back") return 0 ;;
    esac

    # A user's own config.d wins by design - keyboard.sh leaves a layout it
    # finds there alone - so say so rather than letting the setting look
    # ignored. *.conf only, as sway includes: the shipped .example is not.
    if grep -qs 'xkb_layout' "$HOME"/.config/sway/config.d/*.conf; then
      warn "Your sway config.d sets xkb_layout, and that wins over this."
    fi
    pause
  done
}

locale_menu() {
  local locale
  screen "System locale"
  say "Current: $(localectl status | sed -n 's/.*System Locale: *//p' | head -1)"
  echo
  locale=$(localectl list-locales 2>/dev/null |
    gum filter --header "Locale" --placeholder "type to filter") || return 0
  [[ -n $locale ]] || return 0
  root_run localectl set-locale "LANG=$locale"
  say "Takes effect for programs started after this."
  pause
}

# 2. DISPLAYS - dispatch, never a second display UI
displays_entry() {
  if command -v ashlaros-displays >/dev/null; then
    ashlaros-displays
  else
    screen "Displays"
    warn "ashlaros-displays is not installed."
    pause
  fi
}

# 2b. SPEAKERS - dispatch, as displays does: the measuring and the fitting
# are ashlaros-speakers' own (#92)
speakers_entry() {
  ashlaros-speakers
}

# 3. KERNELS
#
# Install only. Which kernel boots is systemd-boot's own menu, which
# already lists every entry - and choosing there cannot leave a machine
# unbootable, while rewriting loader entries here could.
#
# The check after install is the point: a kernel package ships nothing in
# /boot, only usr/lib/modules/<kver>/vmlinuz, and mkinitcpio's alpm hook
# copies it only if a preset named for the pkgbase exists. Without one,
# nothing lands in /boot and the machine gains a silently unbootable entry.
kernel_menu() {
  local choice kernels
  screen "Kernels"
  say "Installed: $(pacman -Qq 2>/dev/null | grep -c '^linux-cachyos') cachyos kernel package(s)"
  echo
  say "This installs a kernel. Which one boots is chosen in the boot menu,"
  say "where every entry is already listed."
  echo

  # Headers are filtered from the LIST because they are not a kernel to
  # choose - but they are installed WITH whichever kernel is chosen, below.
  kernels=$(pacman -Sl cachyos 2>/dev/null |
    awk '$2 ~ /^linux-cachyos/ && $2 !~ /-(headers|dbg)$/ {print $2}' | sort -u)
  if [[ -z $kernels ]]; then
    warn "The cachyos repository is not reachable, so nothing can be listed."
    pause
    return 0
  fi

  # shellcheck disable=SC2086
  # word splitting is the point: one choice per kernel
  choice=$(gum choose --header "Install" $kernels "Cancel") || return 0
  [[ $choice == Cancel ]] && return 0

  if pacman -Qq "$choice" >/dev/null 2>&1; then
    say "$choice is already installed."
    pause
    return 0
  fi

  gum confirm --affirmative "Install" --negative "Cancel" \
    "Install $choice?" || return 0

  screen "Installing $choice"
  # Always with its headers. DKMS rebuilds every registered module when a
  # headers package lands - that is what the alpm hook triggers on - so a
  # kernel installed without them gets no ddcci module, makes no attempt,
  # and reports nothing. Brightness would simply stop working on that
  # kernel, which is the same class of silent breakage this entry's own
  # /boot check exists to catch.
  local headers="$choice-headers"
  if pacman -Si "$headers" >/dev/null 2>&1; then
    root_run pacman -S --noconfirm --needed "$choice" "$headers" ||
      { pause; return 0; }
  else
    warn "$headers is not in the repository; installing the kernel alone."
    warn "DKMS modules will not build for it."
    root_run pacman -S --noconfirm --needed "$choice" || { pause; return 0; }
  fi

  verify_kernel "$choice"
  pause
}

# The check that keeps this entry from leaving a machine with an entry that
# does not boot. Reported, never repaired: writing a preset for a kernel we
# did not package is guesswork, and a wrong one is worse than an absent one.
verify_kernel() {
  local pkgbase=$1 ok=1
  echo
  if [[ -f /etc/mkinitcpio.d/$pkgbase.preset ]]; then
    say "✓ /etc/mkinitcpio.d/$pkgbase.preset"
  else
    oops "✗ no /etc/mkinitcpio.d/$pkgbase.preset"
    oops "  without it mkinitcpio copies no kernel into /boot"
    ok=0
  fi

  if compgen -G "/boot/vmlinuz-$pkgbase*" >/dev/null; then
    say "✓ a kernel image is in /boot"
  else
    oops "✗ nothing matching /boot/vmlinuz-$pkgbase"
    ok=0
  fi

  if grep -rqs "$pkgbase" /boot/loader/entries/ 2>/dev/null; then
    say "✓ a loader entry names it"
  else
    warn "! no loader entry names $pkgbase yet"
    warn "  systemd-boot will not offer it until one exists"
    ok=0
  fi

  verify_dkms "$pkgbase"

  ((ok)) || oops "Do not reboot expecting this kernel until the above is fixed."
}

# Whether the out-of-tree modules exist for a kernel, reported beside the
# preset and vmlinuz checks because it is the same kind of failure: a DKMS
# build that fails is a warning inside a pacman transaction that scrolls
# past, and the user meets it later as "brightness stopped working" - a
# symptom that points nowhere near a kernel module.
#
# Reported, never repaired, like everything else here.
verify_dkms() {
  local pkgbase=$1 kver
  command -v dkms >/dev/null || return 0

  # dkms keys its status on the kernel VERSION, not the package name, and
  # the package is what was just installed - so the version comes from what
  # the package put on disk.
  kver=$(pacman -Ql "$pkgbase" 2>/dev/null |
    sed -n 's|.*/usr/lib/modules/\([^/]*\)/vmlinuz$|\1|p' | head -1)
  [[ -n $kver ]] || return 0

  local registered
  registered=$(dkms status 2>/dev/null | grep -c .) || true
  ((registered > 0)) || return 0

  if dkms status -k "$kver" 2>/dev/null | grep -q "installed"; then
    say "✓ dkms modules built for $kver"
  else
    oops "✗ no dkms module is installed for $kver"
    oops "  $(dkms status 2>/dev/null | head -1) is registered but did not build here"
    oops "  external monitor brightness will not work on this kernel"
  fi
}

# 4. PACKAGES - guarded and hidden rather than visible and broken
packages_entry() {
  xdg-terminal-exec pacseek
}

# 5. TIME AND DATE
time_menu() {
  local choice
  while true; do
    screen "Time and date"
    say "$(timedatectl status | sed -n '1,4p')"
    echo
    choice=$(gum choose --header "Change" \
      "Timezone" "Network time" "Set the clock by hand" "Back") || return 0
    case $choice in
      "Timezone")
        local zone
        zone=$(timedatectl list-timezones 2>/dev/null |
          gum filter --header "Timezone" --placeholder "type to filter") || continue
        [[ -n $zone ]] && root_run timedatectl set-timezone "$zone" && pause
        ;;
      "Network time")
        gum confirm --affirmative "Toggle NTP" --negative "Cancel" "" || continue
        if timedatectl status | grep -q "NTP service: active"; then
          root_run timedatectl set-ntp false
        else
          root_run timedatectl set-ntp true
        fi
        pause
        ;;
      "Set the clock by hand")
        screen "Set the clock"
        # NTP is on from the install, and it will correct a hand-set clock
        # within seconds - which reads as the setting being ignored rather
        # than as NTP doing its job.
        if timedatectl status | grep -q "NTP service: active"; then
          warn "Network time is on, so a time set here will be corrected."
          warn "Turn NTP off first if you mean this to stick."
          echo
        fi
        local stamp
        stamp=$(gum input --header "YYYY-MM-DD HH:MM:SS" \
          --value "$(date '+%Y-%m-%d %H:%M:%S')") || continue
        [[ -n $stamp ]] && root_run timedatectl set-time "$stamp" && pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 6. HARDWARE
#
# chwd is the re-detect mechanism, not something to build one beside:
# upstream lists "reinstalling drivers when swapping GPUs" as a feature,
# and it verifies hardware presence through libpci before applying
# anything. This is a front-end over its own listing and install modes.
#
# Every action here was checked against the shipped chwd 1.24.1. The
# previous version of this menu called `chwd -l`, `chwd -a 0300 --nonfree`
# and `chwd -a nonfree 0300`; all three are rejected outright by that
# release, so every entry in it failed (#66). The flags that exist are
# --list, --list-installed, --list-all, -i, -r, -d and -a.
# Profile names out of a chwd listing.
#
# chwd draws a box table - "│ amd      ┆ 4        │" - not a bare list, so
# the name is the first cell. Read off the real 1.24.1 output rather than
# guessed: a sed written for bare names returned nothing at all, which
# would have made "install a specific profile" claim this machine supports
# none.
chwd_names() {
  # Two different box characters: │ frames the row and ┆ separates the
  # cells. Splitting on the frame alone left "amd┆4" as one field, so both
  # are separators here.
  chwd "$@" 2>/dev/null |
    awk -F'[│┆]' '/│/ && !/Name/ { gsub(/[ \t]/, "", $2); if ($2 != "") print $2 }' |
    sort -u
}

hardware_menu() {
  local choice
  while true; do
    screen "Hardware profiles"

    # What is applied now, before offering to change it. chwd prints
    # nothing when no profile is installed, which is a real answer rather
    # than an error - most machines run on in-kernel drivers.
    local installed
    installed=$(chwd_names --list-installed | head -8)
    if [[ -n $installed ]]; then
      say "Installed:"
      printf '%s\n' "$installed" | sed 's/^/    /'
    else
      say "No chwd profile is installed; the kernel's own drivers are in use."
    fi
    echo

    choice=$(gum choose --header "chwd" \
      "What this hardware supports" \
      "Everything chwd knows about" \
      "Re-detect and install" \
      "Install a specific profile" \
      "Remove a profile" \
      "Back") || return 0

    case $choice in
      "What this hardware supports")
        screen "Hardware profiles"
        say "Profiles matching the devices in this machine:"
        echo
        chwd --list --detail 2>&1 | sed "s/^/  /" | head -40
        pause
        ;;
      "Everything chwd knows about")
        screen "Hardware profiles"
        chwd --list-all 2>&1 | sed "s/^/  /" | head -40
        pause
        ;;
      "Re-detect and install")
        screen "Hardware profiles"
        # Bare -a, not -a 0300: the class id is optional and omitting it
        # means "any", which covers network, T2, power management,
        # handhelds and the USB fingerprint profiles as well as graphics.
        # This is the same call the installer makes, so a machine that
        # gained hardware gets what a fresh install would have given it.
        say "Asking chwd what this machine needs now."
        say "Useful after swapping a GPU, or adding a card or a dock."
        echo
        root_run chwd -a
        pause
        ;;
      "Install a specific profile")
        local available profile
        available=$(chwd_names --list)
        if [[ -z $available ]]; then
          screen "Hardware profiles"
          warn "chwd lists no profile for this hardware."
          pause
          continue
        fi
        # shellcheck disable=SC2086
        # word splitting is the point: one choice per profile
        profile=$(gum choose --header "Install" $available "Cancel") || continue
        [[ $profile == Cancel ]] && continue
        screen "Hardware profiles"
        root_run chwd -i "$profile"
        pause
        ;;
      "Remove a profile")
        local present profile
        present=$(chwd_names --list-installed)
        if [[ -z $present ]]; then
          screen "Hardware profiles"
          say "Nothing to remove: no chwd profile is installed."
          pause
          continue
        fi
        # shellcheck disable=SC2086
        profile=$(gum choose --header "Remove" $present "Cancel") || continue
        [[ $profile == Cancel ]] && continue
        # A profile's post_remove undoes what its post_install did - a
        # module blacklist, an initramfs rebuild - so removing one is a
        # real change to how the machine boots, not just a package.
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Remove $profile? This reverses its driver and initramfs changes." || continue
        screen "Hardware profiles"
        root_run chwd -r "$profile"
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 7. NOTES
#
# zk keeps plain Markdown files in a directory and an index beside them,
# so there is no format of ours to persist - `git init` in the notebook is
# the whole of "my notes are backed up".
#
# No notebook is created at install time and none ships in skel: an empty
# one in $HOME is clutter for everyone who never opens it. This is the
# door instead.
notes_entry() {
  screen "Notes"

  # xdg-user-dir rather than ~/Documents: the directory is localised
  local documents
  documents=$(xdg-user-dir DOCUMENTS 2>/dev/null || echo "$HOME/Documents")
  local notebook="${ZK_NOTEBOOK_DIR:-$documents/notes}"

  if [[ -d $notebook/.zk ]]; then
    say "Notebook: $notebook"
    say "$(zk list --format '{{title}}' --quiet "$notebook" 2>/dev/null | wc -l) note(s)"
    echo
    if [[ -d $notebook/.git ]]; then
      say "It is a git repository. Nothing is committed for you - that is"
      say "deliberate; a tool that commits notes by itself is one that can"
      say "push a private notebook somewhere you did not choose."
      echo
      say "$(git -C "$notebook" status --porcelain | wc -l) uncommitted change(s)"
    else
      gum confirm --affirmative "git init" --negative "Back" \
        "Make it a git repository?" || return 0
      git -C "$notebook" init -q
      write_zk_gitignore "$notebook"
      say "Initialised. Commit when you want to: git -C '$notebook' commit -a"
    fi
    pause
    return 0
  fi

  say "No notebook yet. One will be created at:"
  say "  $notebook"
  echo
  gum confirm --affirmative "Create" --negative "Back" "Create it?" || return 0

  mkdir -p "$notebook"
  zk init --no-input "$notebook" 2>&1 | sed 's/^/  /'

  if gum confirm --affirmative "Yes" --negative "No" \
    "Make it a git repository as well?"; then
    git -C "$notebook" init -q
    write_zk_gitignore "$notebook"
    say "Initialised, and nothing is committed automatically."
  fi
  echo
  say "Write one with: zk new '$notebook'"
  pause
}

# zk rebuilds its index from the notes themselves, so committing it is
# committing derived state - and it is a binary file that changes on
# every command, which makes each commit a conflict. Measured: without
# this, git add -A stages .zk/notebook.db.
write_zk_gitignore() {
  local notebook=$1
  [[ -f $notebook/.gitignore ]] && return 0
  cat > "$notebook/.gitignore" <<'EOF'
# zk rebuilds this from the notes with `zk index`, so it is derived state
# - and a binary that changes on every command makes every commit a
# conflict. The notes and .zk/config.toml are the things worth keeping.
.zk/notebook.db
EOF
}

# 8. MAIL
#
# aerc is an optdepend and this configures one account. IMAP/SMTP with a
# password only: the OAuth half needs an OAuth client registration this
# project does not have yet (#53), and aerc's +oauthbearer wants a
# client_id and token_endpoint we cannot supply. Offering a Google entry
# that cannot complete would be worse than saying where the line is.
#
# The password goes to the login keyring and the config reads it back with
# source-cred-cmd, so accounts.conf never holds a secret - the same shape
# as the calendar entry's PasswordCommand.
AERC_ACCOUNTS="${XDG_CONFIG_HOME:-$HOME/.config}/aerc/accounts.conf"

# Gmail over OAuth, with the user's own client. aerc takes the OAuth
# parameters in the source URL - token_endpoint, client_id, client_secret,
# scope - and treats the stored password as the refresh token, exchanging
# it for an access token on each connection. So nothing of ours is in the
# exchange, and the same Cloud project the calendar entry asks for covers
# mail too if the Gmail scope is added to it.
#
# The refresh token is what has to be obtained once, and Google only hands
# one back through an authorization-code flow. Nothing we ship implements
# that flow for this scope, so this asks for the token rather than
# pretending to fetch it - an entry that half-works is worse than one that
# says what it needs.
gmail_account() {
  local name=$1 email=$2

  screen "Gmail"
  say "Gmail needs OAuth, and Google does not let us ship credentials for"
  say "it, so this uses your own - the same Cloud project the calendar"
  say "entry asks for, with the Gmail scope added:"
  echo
  say "  1. console.cloud.google.com -> your project"
  say "  2. APIs & Services -> Library -> enable Gmail API"
  say "  3. Credentials -> OAuth client ID -> Desktop app"
  say "  4. Obtain a refresh token for scope https://mail.google.com/"
  echo
  # Named plainly: this is the step with no button to press, and finding
  # that out after typing a client ID would be worse than reading it here.
  warn "Step 4 needs an OAuth flow this entry does not run: Google's"
  warn "OAuth 2.0 Playground does it in a browser, or any tool that"
  warn "completes an authorization-code flow for that scope."
  echo
  gum confirm --affirmative "I have a refresh token" --negative "Back" \
    "Continue?" || return 1

  local client_id client_secret refresh_token
  client_id=$(gum input --prompt "Client ID: ") || return 1
  [[ -n $client_id ]] || return 1
  client_secret=$(gum input --password --prompt "Client secret: ") || return 1
  refresh_token=$(gum input --password --prompt "Refresh token: ") || return 1
  [[ -n $refresh_token ]] || return 1

  # The refresh token is the credential here, so it goes where passwords
  # go rather than into the URL: aerc runs the command and never stores it.
  local cred_cmd=""
  if command -v secret-tool >/dev/null &&
    gum confirm --affirmative "Keyring" --negative "Config file" \
      "Store the refresh token in the login keyring?"; then
    printf '%s' "$refresh_token" |
      secret-tool store --label="aerc $name" service aerc account "$name" || {
        oops "Could not store the refresh token in the keyring."
        pause
        return 1
      }
    cred_cmd="secret-tool lookup service aerc account $name"
  fi

  # token_endpoint present, so aerc treats the stored value as a refresh
  # token and exchanges it; without it the value would have to be a
  # short-lived access token instead
  local params="token_endpoint=https://oauth2.googleapis.com/token"
  params+="&client_id=$(url_escape "$client_id")"
  params+="&client_secret=$(url_escape "$client_secret")"
  params+="&scope=$(url_escape "https://mail.google.com/")"

  private_file "$AERC_ACCOUNTS"
  {
    echo
    echo "[$name]"
    echo "from = $email"
    if [[ -n $cred_cmd ]]; then
      echo "source = imaps+xoauth2://$(url_escape "$email")@imap.gmail.com:993?$params"
      echo "source-cred-cmd = $cred_cmd"
      echo "outgoing = smtps+xoauth2://$(url_escape "$email")@smtp.gmail.com:465?$params"
      echo "outgoing-cred-cmd = $cred_cmd"
      echo "outgoing-cred-cmd-cache = true"
    else
      echo "source = imaps+xoauth2://$(url_escape "$email"):$(url_escape "$refresh_token")@imap.gmail.com:993?$params"
      echo "outgoing = smtps+xoauth2://$(url_escape "$email"):$(url_escape "$refresh_token")@smtp.gmail.com:465?$params"
    fi
    # Gmail files sent mail itself, and a copy-to would leave two
    echo "copy-to = "
  } >> "$AERC_ACCOUNTS"
  chmod 600 "$AERC_ACCOUNTS"

  echo
  if [[ -n $cred_cmd ]]; then
    say "Written to $AERC_ACCOUNTS - the refresh token is in the keyring."
  else
    say "Written to $AERC_ACCOUNTS (mode 600), refresh token included."
  fi
  say "Run aerc to check it."
  pause
}

mail_entry() {
  screen "Mail"

  if [[ -f $AERC_ACCOUNTS ]]; then
    say "Configured accounts:"
    sed -n 's/^\[\(.*\)\]$/  \1/p' "$AERC_ACCOUNTS"
    echo
    gum confirm --affirmative "Add another" --negative "Back" "Add an account?" || return 0
  fi

  local name email imap_host imap_port smtp_host smtp_port user
  name=$(gum input --prompt "Account name: " --value "Personal") || return 0
  [[ -n $name ]] || return 0
  email=$(gum input --prompt "Email address: ") || return 0
  [[ -n $email ]] || return 0

  # The same providers the calendar entry offers, because someone with a
  # Fastmail calendar usually has Fastmail mail (#55). Every host and port
  # below answered with a protocol banner when probed - not copied from a
  # support page - and every field stays editable.
  #
  # Microsoft is absent: Outlook.com wants OAuth and an Entra app
  # registration, which is a separate account and a separate set of terms
  # from Google's (#55). Gmail is offered because aerc takes the OAuth
  # parameters in the URL, so the user's own client works with no code of
  # ours in the exchange.
  local provider
  provider=$(gum choose --header "Where is the mail?" \
    "Gmail" "Fastmail" "iCloud" "mailbox.org" "Posteo" "Zoho" \
    "Other IMAP server") || return 0

  if [[ $provider == Gmail ]]; then
    gmail_account "$name" "$email" || return 0
    return 0
  fi

  local domain=${email#*@}
  # smtp_scheme: aerc reads smtps:// as implicit TLS and smtp:// as
  # STARTTLS, which is the difference iCloud needs - it answers on 587
  # only, with 465 refusing the connection outright.
  local smtp_scheme=smtps note=""
  case $provider in
    "Fastmail")
      imap_host=imap.fastmail.com; smtp_host=smtp.fastmail.com
      note="Fastmail needs an app password: Settings -> Privacy & Security." ;;
    "iCloud")
      imap_host=imap.mail.me.com; smtp_host=smtp.mail.me.com
      smtp_port=587; smtp_scheme=smtp
      note="iCloud needs an app-specific password from appleid.apple.com." ;;
    "mailbox.org")
      imap_host=imap.mailbox.org; smtp_host=smtp.mailbox.org ;;
    "Posteo")
      imap_host=posteo.de; smtp_host=posteo.de ;;
    "Zoho")
      imap_host=imappro.zoho.com; smtp_host=smtppro.zoho.com
      note="Zoho hosts EU accounts separately: imap.zoho.eu and smtp.zoho.eu." ;;
    *)
      # the mail.<domain> convention, which is right often enough to be a
      # better starting point than an empty field
      imap_host=imap.$domain; smtp_host=smtp.$domain ;;
  esac

  imap_host=$(gum input --prompt "IMAP server: " --value "$imap_host") || return 0
  imap_port=$(gum input --prompt "IMAP port: " --value "993") || return 0
  smtp_host=$(gum input --prompt "SMTP server: " --value "$smtp_host") || return 0
  smtp_port=$(gum input --prompt "SMTP port: " --value "${smtp_port:-465}") || return 0
  user=$(gum input --prompt "Username: " --value "$email") || return 0

  # Said before the password prompt: an app password is something the user
  # has to go and create somewhere else first.
  if [[ -n $note ]]; then
    echo
    say "$note"
    echo
  fi

  local password
  password=$(gum input --password --prompt "Password: ") || return 0
  [[ -n $password ]] || return 0

  local cred_cmd=""
  if command -v secret-tool >/dev/null; then
    printf '%s' "$password" |
      secret-tool store --label="aerc $name" service aerc account "$name" || {
        oops "Could not store the password in the keyring."
        pause
        return 1
      }
    cred_cmd="secret-tool lookup service aerc account $name"
    password=""
  fi

  private_file "$AERC_ACCOUNTS"
  {
    echo
    echo "[$name]"
    echo "from = $email"
    if [[ -n $cred_cmd ]]; then
      # no credential in the file, and none on a command line either:
      # aerc runs the command itself rather than expanding it into a URL
      echo "source = imaps://$(url_escape "$user")@$imap_host:$imap_port"
      echo "source-cred-cmd = $cred_cmd"
      echo "outgoing = $smtp_scheme://$(url_escape "$user")@$smtp_host:$smtp_port"
      echo "outgoing-cred-cmd = $cred_cmd"
      # otherwise the keyring is queried once per message sent
      echo "outgoing-cred-cmd-cache = true"
    else
      echo "source = imaps://$(url_escape "$user"):$(url_escape "$password")@$imap_host:$imap_port"
      echo "outgoing = $smtp_scheme://$(url_escape "$user"):$(url_escape "$password")@$smtp_host:$smtp_port"
    fi
    echo "copy-to = Sent"
  } >> "$AERC_ACCOUNTS"
  chmod 600 "$AERC_ACCOUNTS"

  # The generated styleset follows the desktop theme; point aerc at it
  # here rather than making the theme script edit a config it does not own.
  local aerc_conf="${XDG_CONFIG_HOME:-$HOME/.config}/aerc/aerc.conf"
  if [[ ! -f $aerc_conf ]]; then
    printf '[ui]\nstyleset-name = ashlaros\n' > "$aerc_conf"
  elif ! grep -q '^styleset-name' "$aerc_conf"; then
    say "Set styleset-name = ashlaros under [ui] in aerc.conf for the desktop theme."
  fi

  echo
  if [[ -n $cred_cmd ]]; then
    say "Written to $AERC_ACCOUNTS - the password is in the keyring, not the file."
  else
    say "Written to $AERC_ACCOUNTS (mode 600). No keyring available, so the"
    say "password is in the file."
  fi
  say "Run aerc to check it."
  pause
}

# 9. CALENDAR
#
# khal views a directory of .ics files; vdirsyncer fills that directory
# from a CalDAV server. This writes vdirsyncer's config.
#
# Replaced calcurse, which is still a fine calendar but could not reach
# Google: calcurse-caldav's OAuth path imports python-oauth2client, which
# Google archived years ago, sends no PKCE, and requires a client secret
# in a config file. vdirsyncer's Google support lives in a maintained
# library instead (#53). Measured before switching: vdirsyncer discovers a
# real Radicale collection, pushes an event to it, and khal renders what
# lands.
#
VDIRSYNCER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vdirsyncer/config"
VDIR_ROOT="$HOME/.calendars/synced"

# Google is not a row in the provider table above: it wants OAuth rather
# than a password, and vdirsyncer has a storage type of its own for it.
#
# The client AshlarOS is registered as ships in the package
# (/usr/share/ashlaros/google-oauth-client). A user who would rather run
# under their own Cloud project drops the same two names in
# ~/.config/ashlaros/google-oauth-client and that wins - which is also the
# way out if our registration is ever suspended or rate-limited.
GOOGLE_CLIENT_SHIPPED=/usr/share/ashlaros/google-oauth-client
GOOGLE_CLIENT_USER="${XDG_CONFIG_HOME:-$HOME/.config}/ashlaros/google-oauth-client"

google_calendar() {
  screen "Google calendar"

  command -v vdirsyncer >/dev/null || {
    oops "vdirsyncer is not installed."
    pause
    return 1
  }

  # vdirsyncer names aiohttp-oauthlib an optdepend and raises
  # "aiohttp-oauthlib not installed" at SYNC time without it, which is
  # after the account is configured and the wrong moment to find out.
  if ! python3 -c "import aiohttp_oauthlib" 2>/dev/null; then
    say "Google support needs python-aiohttp-oauthlib."
    gum confirm --affirmative "Install" --negative "Back" "Install it?" || return 0
    root_run pacman -S --noconfirm --needed python-aiohttp-oauthlib || { pause; return 1; }
  fi

  local client_id="" client_secret=""
  # the user's own file wins over the shipped one
  local source
  for source in "$GOOGLE_CLIENT_SHIPPED" "$GOOGLE_CLIENT_USER"; do
    # shellcheck disable=SC1090
    [[ -r $source ]] && . "$source"
  done
  client_id="${GOOGLE_CLIENT_ID:-}"
  client_secret="${GOOGLE_CLIENT_SECRET:-}"

  if [[ -r $GOOGLE_CLIENT_USER ]]; then
    say "Using the OAuth client in $GOOGLE_CLIENT_USER."
  elif [[ -n $client_id ]]; then
    say "Signing in through the AshlarOS application."
    say --foreground 8 "Your calendar is read by this machine only; the token stays here."
  else
    oops "No OAuth client is configured and none ships with this package."
    say "Register one at console.cloud.google.com (enable the CalDAV API,"
    say "not the Calendar API) and write client_id and client_secret to"
    say "$GOOGLE_CLIENT_USER."
    pause
    return 1
  fi
  echo

  say "A browser will open for you to sign in to Google."
  say "vdirsyncer catches the answer on this machine and stores a token in"
  # shellcheck disable=SC2088
  # prose in a message, not a path to expand
  say "~/.local/share/vdirsyncer/."
  echo
  gum confirm --affirmative "Sign in" --negative "Back" "Continue?" || return 0

  # What happens when the same event differs on both sides, asked in the
  # same words as the password providers rather than vdirsyncer's own.
  local conflict resolution
  conflict=$(gum choose --header "If the same event was changed in both places, which wins?" \
    "The server's copy" \
    "This machine's copy") || return 0
  case $conflict in
    "The server's"*) resolution='"b wins"' ;;
    *) resolution='"a wins"' ;;
  esac

  mkdir -p "$VDIR_ROOT"
  private_file "$VDIRSYNCER_CONFIG"
  {
    echo "# written by ashlaros-settings-tui"
    echo "[general]"
    echo "status_path = \"~/.local/share/vdirsyncer/status/\""
    echo
    echo "[pair calendar]"
    echo "a = \"local\""
    echo "b = \"remote\""
    echo "collections = [\"from a\", \"from b\"]"
    echo "conflict_resolution = $resolution"
    echo
    echo "[storage local]"
    echo "type = \"filesystem\""
    echo "path = \"$VDIR_ROOT\""
    echo "fileext = \".ics\""
    echo
    echo "[storage remote]"
    echo "type = \"google_calendar\""
    echo "token_file = \"~/.local/share/vdirsyncer/google_token\""
    echo "client_id = \"$client_id\""
    echo "client_secret = \"$client_secret\""
  } > "$VDIRSYNCER_CONFIG"
  chmod 600 "$VDIRSYNCER_CONFIG"

  screen "Google calendar"
  say "Written to $VDIRSYNCER_CONFIG"
  echo

  # discover is where the browser opens: the token does not exist yet, so
  # this is the step that fetches it.
  say "Signing in and looking for calendars:"
  echo
  yes | vdirsyncer discover 2>&1 | sed 's/^/  /' | head -30
  echo

  if gum confirm --affirmative "Sync now" --negative "Later" \
    "Sync these calendars?"; then
    vdirsyncer sync 2>&1 | sed 's/^/  /' | head -40
    echo
    say "Synced. khal reads these; the timer syncs every 15 minutes."
  else
    say "Nothing synced yet. This entry's \"Sync now\" does it."
  fi
  pause
}

# Subscribed calendars: a published .ics link, fetched read-only.
#
# Any calendar that hands out a link - Proton, a university timetable, a
# football fixture list, a shared Google calendar - can be read this way,
# so this is one generic entry rather than a row per provider. It is how
# Proton Calendar is reachable at all: Proton speaks no CalDAV (dav. and
# caldav. do not resolve, and the web app answers 405 to PROPFIND), and
# Proton Bridge is IMAP/SMTP only.
#
# Read-only, and that is vdirsyncer's own property rather than a choice
# here: HttpStorage sets read_only = True. Events show up in khal and get
# reminders; editing them stays in whatever app owns the calendar.
#
# One [pair] per feed, named by the user. That is what makes them
# removable: dropping a feed is deleting its pair, its storages and its
# directory, and nothing else in the file is touched - the CalDAV account
# configured by the entry above keeps working either way.
FEEDS_DIR="$VDIR_ROOT"

# The pairs in the config that are subscribed feeds. Marked with a comment
# rather than inferred from the storage type: a user who hand-edits the
# file keeps whatever they wrote, and only what this entry created is
# offered for removal.
feed_names() {
  [[ -f $VDIRSYNCER_CONFIG ]] || return 0
  sed -n 's/^# ashlaros-feed: \(.*\)$/\1/p' "$VDIRSYNCER_CONFIG"
}

# A pair name vdirsyncer accepts, derived from what the user typed. The
# display name is kept in the marker comment above, so "Uni timetable" can
# stay readable while the pair is uni_timetable.
feed_slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '_' |
    sed 's/^_//; s/_$//'
}

feeds_entry() {
  local choice
  while true; do
    screen "Subscribed calendars"

    local names
    names=$(feed_names)
    if [[ -n $names ]]; then
      say "Subscribed:"
      local n
      while read -r n; do [[ -n $n ]] && say "  $n"; done <<<"$names"
    else
      say "No subscribed calendars yet."
      echo
      say "A published .ics link - Proton Calendar's \"share via link\", a"
      say "timetable, a fixture list - is read into your calendar here."
    fi
    echo

    local entries=("Add a calendar")
    [[ -n $names ]] && entries+=("Refresh now" "Remove one")
    entries+=("Back")

    choice=$(gum choose --header "Subscribed calendars" "${entries[@]}") || return 0
    case $choice in
      "Add a calendar") feed_add ;;
      "Refresh now") feed_refresh ;;
      "Remove one") feed_remove ;;
      *) return 0 ;;
    esac
  done
}

feed_add() {
  screen "Add a calendar"

  local name slug url
  name=$(gum input --prompt "Name: " --placeholder "Proton, timetable, fixtures") || return 0
  [[ -n $name ]] || return 0
  slug=$(feed_slug "$name")
  [[ -n $slug ]] || { oops "That name has no letters or digits in it."; pause; return 0; }

  if feed_names | grep -qxF "$name"; then
    oops "A calendar called $name is already subscribed."
    pause
    return 0
  fi

  say "The link ends in .ics, or starts with webcal://"
  echo
  url=$(gum input --prompt "Link: " --placeholder "https://…/calendar.ics") || return 0
  [[ -n $url ]] || return 0
  # webcal:// is http(s) with a scheme that tells a browser to subscribe;
  # vdirsyncer speaks neither, so it is rewritten rather than refused
  case $url in
    webcal://*) url="https://${url#webcal://}" ;;
  esac

  echo
  say "This is read-only: events appear in your calendar and you get"
  say "reminders, but edits happen wherever the calendar lives."
  echo
  # Worth saying once, at the moment someone pastes one in: a published
  # link is a capability. It carries no password, so whoever has the URL
  # can read that calendar - including, for an end-to-end encrypted
  # provider, a server that could not read it before it was published.
  say --foreground 3 "! Anyone with this link can read the calendar; it has no password."
  echo
  gum confirm --affirmative "Add" --negative "Cancel" "Add $name?" || return 0

  mkdir -p "$FEEDS_DIR/$slug"

  # appended, so the CalDAV account and any other feed are untouched
  [[ -f $VDIRSYNCER_CONFIG ]] || feed_config_header
  {
    echo
    echo "# ashlaros-feed: $name"
    echo "[pair $slug]"
    echo "a = \"${slug}_local\""
    echo "b = \"${slug}_remote\""
    # null rather than a list: an .ics URL is one calendar, not a server
    # with collections to discover
    echo "collections = null"
    echo
    echo "[storage ${slug}_local]"
    echo "type = \"filesystem\""
    echo "path = \"$FEEDS_DIR/$slug\""
    echo "fileext = \".ics\""
    echo
    echo "[storage ${slug}_remote]"
    echo "type = \"http\""
    echo "url = \"$url\""
  } >> "$VDIRSYNCER_CONFIG"
  chmod 600 "$VDIRSYNCER_CONFIG"

  screen "Add a calendar"
  say "Fetching $name:"
  echo
  # one pair, so a broken feed cannot fail the CalDAV sync beside it
  yes | vdirsyncer discover "$slug" 2>&1 | sed 's/^/  /' | head -20
  vdirsyncer sync "$slug" 2>&1 | sed 's/^/  /' | head -20
  echo

  local count
  count=$(find "$FEEDS_DIR/$slug" -name '*.ics' 2>/dev/null | wc -l)
  if ((count > 0)); then
    say "$count event(s) from $name. khal shows them; the timer refreshes"
    say "every 15 minutes."
  else
    warn "Nothing arrived. The link may be wrong, or may not be public."
    say "\"Remove one\" takes it out again."
  fi
  pause
}

feed_refresh() {
  screen "Subscribed calendars"
  local slug
  while read -r name; do
    [[ -n $name ]] || continue
    slug=$(feed_slug "$name")
    say "$name:"
    vdirsyncer sync "$slug" 2>&1 | sed 's/^/  /' | head -10
  done <<<"$(feed_names)"
  pause
}

feed_remove() {
  local name slug
  name=$(feed_names | gum choose --header "Remove which?") || return 0
  [[ -n $name ]] || return 0
  slug=$(feed_slug "$name")

  gum confirm --affirmative "Remove" --negative "Keep" \
    "Remove $name and its events from this machine?" || return 0

  # The block runs from the marker to the line before the next marker or
  # the end. awk rather than sed: the range has to end at whichever comes
  # first, and a trailing block has no terminator to match on.
  local trimmed
  trimmed=$(mktemp)
  awk -v marker="# ashlaros-feed: $name" '
    $0 == marker { skipping = 1; next }
    /^# ashlaros-feed: / { skipping = 0 }
    !skipping { print }
  ' "$VDIRSYNCER_CONFIG" > "$trimmed"
  cat "$trimmed" > "$VDIRSYNCER_CONFIG"
  rm -f "$trimmed"
  chmod 600 "$VDIRSYNCER_CONFIG"

  rm -rf "${FEEDS_DIR:?}/$slug"
  # the status directory remembers what was synced; leaving it behind
  # makes a re-added feed look like a conflict rather than a fresh fetch
  rm -rf "${HOME:?}/.local/share/vdirsyncer/status/$slug"* 2>/dev/null

  screen "Subscribed calendars"
  say "Removed $name."
  pause
}

# Only when there is no config at all: a feed must be addable before any
# CalDAV account exists.
feed_config_header() {
  private_file "$VDIRSYNCER_CONFIG"
  {
    echo "# written by ashlaros-settings-tui"
    echo "[general]"
    echo "status_path = \"~/.local/share/vdirsyncer/status/\""
  } > "$VDIRSYNCER_CONFIG"
  chmod 600 "$VDIRSYNCER_CONFIG"
}

calendar_entry() {
  # An account and subscribed links are independent: either can exist
  # without the other, so this is a menu rather than a straight line into
  # the account wizard.
  local choice
  while true; do
    screen "Calendar"

    if [[ -f $VDIRSYNCER_CONFIG ]] && grep -q '^\[pair calendar\]' "$VDIRSYNCER_CONFIG"; then
      local server
      server=$(sed -n 's/^ *url *= *"\(.*\)"/\1/p' "$VDIRSYNCER_CONFIG" | head -1)
      say "Account: ${server:-a CalDAV server}"
    else
      say "No account configured."
    fi
    local subscribed
    subscribed=$(feed_names | grep -c . || true)
    ((subscribed > 0)) && say "Subscribed calendars: $subscribed"
    echo

    local entries=()
    if [[ -f $VDIRSYNCER_CONFIG ]]; then
      entries+=("Sync now" "Open the calendar")
    fi
    entries+=("Set up an account" "Subscribed calendars" "Back")

    choice=$(gum choose --header "Calendar" "${entries[@]}") || return 0
    case $choice in
      "Sync now")
        screen "Calendar"
        # --force-delete is deliberately absent: without it vdirsyncer
        # aborts rather than emptying both sides, which is the accident
        # worth refusing
        vdirsyncer sync 2>&1 | sed 's/^/  /' | head -40
        pause ;;
      "Open the calendar") khal interactive ;;
      "Subscribed calendars") feeds_entry ;;
      "Set up an account") calendar_account; return 0 ;;
      *) return 0 ;;
    esac
  done
}

calendar_account() {
  screen "Calendar"

  # A table rather than a branch per provider: the common failure is not
  # knowing the CalDAV URL, and the URL is data. Every host below was
  # probed and answers 401 - the endpoint exists and wants credentials -
  # rather than being copied from documentation (#55).
  #
  # Outlook is deliberately absent: Microsoft retired CalDAV for
  # Outlook.com and the replacement is Graph, a REST API that nothing here
  # speaks. Listing it would promise something that cannot work.
  local provider
  provider=$(gum choose --header "Where is the calendar?" \
    "Nextcloud (self-hosted)" \
    "Google" \
    "Fastmail" \
    "iCloud" \
    "mailbox.org" \
    "Posteo" \
    "Zoho" \
    "Other CalDAV server") || return 0

  local url="" note=""
  case $provider in
    "Fastmail")
      url=https://caldav.fastmail.com/dav/calendars
      note="Fastmail needs an app password: Settings -> Privacy & Security -> Integrations." ;;
    "iCloud")
      url=https://caldav.icloud.com/
      note="iCloud needs an app-specific password from appleid.apple.com, not your Apple ID password." ;;
    "mailbox.org")
      url=https://dav.mailbox.org/caldav/ ;;
    "Posteo")
      url=https://posteo.de:8443/calendars/ ;;
    "Zoho")
      url=https://calendar.zoho.com/caldav/
      note="Zoho needs an application-specific password when two-factor is on." ;;
    "Nextcloud (self-hosted)")
      note="The URL is your server plus /remote.php/dav/, e.g. https://cloud.example.org/remote.php/dav/" ;;
  esac

  if [[ $provider == Google ]]; then
    google_calendar || return 0
    return 0
  fi

  local user
  url=$(gum input --prompt "CalDAV URL: " --value "$url") || return 0
  [[ -n $url ]] || return 0
  user=$(gum input --prompt "Username: ") || return 0

  # Said before the password prompt, not after a failure: an app password
  # is something the user has to go and create elsewhere.
  if [[ -n $note ]]; then
    echo
    say "$note"
    echo
  fi

  # password.fetch before a plaintext password: with gnome-keyring
  # unlocked at login (since f0b5cc7) secret-tool needs no extra package
  # and keeps the credential out of the config file
  local secret_cmd="" password=""
  if command -v secret-tool >/dev/null &&
    gum confirm --affirmative "Keyring" --negative "Config file" \
      "Store the password in the login keyring?"; then
    password=$(gum input --password --prompt "Password: ") || return 0
    printf '%s' "$password" |
      secret-tool store --label="CalDAV" service vdirsyncer username "$user" ||
      { oops "Could not store the password."; pause; return 1; }
    secret_cmd="secret-tool lookup service vdirsyncer username $user"
    password=""
  else
    password=$(gum input --password --prompt "Password: ") || return 0
  fi

  # What happens when the same event differs on both sides. Named by
  # consequence: "a wins" and "b wins" are vdirsyncer's words and say
  # nothing about which is the server.
  local conflict resolution
  conflict=$(gum choose --header "If the same event was changed in both places, which wins?" \
    "The server's copy" \
    "This machine's copy") || return 0
  case $conflict in
    "The server's"*) resolution='"b wins"' ;;
    *) resolution='"a wins"' ;;
  esac

  mkdir -p "$VDIR_ROOT"
  private_file "$VDIRSYNCER_CONFIG"
  {
    echo "# written by ashlaros-settings-tui"
    echo "[general]"
    echo "status_path = \"~/.local/share/vdirsyncer/status/\""
    echo
    echo "[pair calendar]"
    echo "a = \"local\""
    echo "b = \"remote\""
    echo "collections = [\"from a\", \"from b\"]"
    echo "conflict_resolution = $resolution"
    echo
    echo "[storage local]"
    echo "type = \"filesystem\""
    echo "path = \"$VDIR_ROOT\""
    echo "fileext = \".ics\""
    echo
    echo "[storage remote]"
    echo "type = \"caldav\""
    echo "url = \"$url\""
    echo "username = \"$user\""
    if [[ -n $secret_cmd ]]; then
      echo "password.fetch = [\"command\", \"sh\", \"-c\", \"$secret_cmd\"]"
    else
      echo "password = \"$password\""
    fi
  } > "$VDIRSYNCER_CONFIG"
  chmod 600 "$VDIRSYNCER_CONFIG"

  screen "Calendar"
  say "Written to $VDIRSYNCER_CONFIG"
  echo

  # discover asks before creating anything, and its questions are about
  # collections rather than deletions; sync is where data moves.
  say "Looking for calendars on the server:"
  echo
  yes | vdirsyncer discover 2>&1 | sed 's/^/  /' | head -30
  echo

  if gum confirm --affirmative "Sync now" --negative "Later" \
    "Sync these calendars?"; then
    # no --force-delete: vdirsyncer refuses a sync that would empty both
    # sides rather than doing it, which is the protection calcurse's
    # DryRun flag was standing in for
    vdirsyncer sync 2>&1 | sed 's/^/  /' | head -40
    echo
    say "Synced. khal reads these; the timer syncs every 15 minutes."
  else
    say "Nothing synced yet. This entry's \"Sync now\" does it."
  fi
  pause
}

# 10. BACKGROUND
#
# The wallpaper is generated, not chosen: generate-bg.sh recolours the
# ashlar mark from the active palette into ~/.config/sway/
# generated_background.svg, and every theme apply overwrites it
# (90-enable-theme.conf:12). So a picker that writes the user's JPEG into
# that file loses it at the next theme switch, and one that only calls
# swaymsg loses it at the next login.
#
# Both are avoided by writing `set $background` into definitions.d/, which
# is user-owned, documented as the override path in its own README, and
# untouched by the theme machinery. The generated background stays the
# default and is always offered back.
BACKGROUND_OVERRIDE="$HOME/.config/sway/definitions.d/50-background.conf"

background_entry() {
  screen "Background"

  local generated="$HOME/.config/sway/generated_background.svg"
  local -a paths=() labels=()

  paths+=("$generated")
  labels+=("The theme's background (recoloured on every theme switch)")

  # xdg-user-dir rather than ~/Pictures: the directory is localised, and
  # xdg-user-dirs is already a dependency
  local pictures
  pictures=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")

  local dir f
  for dir in /usr/share/backgrounds "$HOME/.local/share/backgrounds" "$pictures"; do
    [[ -d $dir ]] || continue
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      [[ $f == "$generated" ]] && continue
      paths+=("$f")
      labels+=("${f/#$HOME/\~}")
    done < <(find "$dir" -maxdepth 2 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
      -o -iname '*.svg' -o -iname '*.webp' \) 2>/dev/null | sort)
  done

  if [[ ${#paths[@]} -le 1 ]]; then
    say "No images found in /usr/share/backgrounds, ~/.local/share/backgrounds"
    say "or $pictures."
    pause
    return 0
  fi

  local choice
  choice=$(printf '%s\n' "${labels[@]}" | gum choose --header "Background") || return 0

  local index=-1 i
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$choice" ]] && index=$i && break
  done
  [[ $index -ge 0 ]] || return 0
  local picked=${paths[$index]}

  # fill is right for a photograph and wrong for a logo or a tile, which
  # is why the shipped config hardcoding it was worth exposing
  local mode
  mode=$(gum choose --header "How should it fit?" \
    "fill" "fit" "stretch" "center" "tile") || return 0

  # Applied before it is committed: a wallpaper picker you cannot see the
  # result of is not a picker.
  swaymsg output "*" bg "$picked" "$mode" >/dev/null 2>&1

  gum confirm --affirmative "Keep" --negative "Revert" "Keep this background?" || {
    # back to whatever the config says, without writing anything
    local previous=$generated
    [[ -f $BACKGROUND_OVERRIDE ]] &&
      previous=$(sed -n 's/^set \$background //p' "$BACKGROUND_OVERRIDE" | tr -d "'\"" | head -1)
    swaymsg output "*" bg "${previous:-$generated}" fill >/dev/null 2>&1
    say "Reverted."
    pause
    return 0
  }

  if [[ $picked == "$generated" ]]; then
    # the default is the absence of an override, so the theme's own
    # background keeps being regenerated rather than pinned to today's
    rm -f "$BACKGROUND_OVERRIDE"
    say "Using the theme's background again."
  else
    mkdir -p "$(dirname "$BACKGROUND_OVERRIDE")"
    # quoted: paths with spaces are ordinary in ~/Pictures
    {
      echo "# written by ashlaros-settings-tui"
      echo "# definitions.d survives theme switches; generated_background.svg does not"
      echo "set \$background '$picked'"
    } > "$BACKGROUND_OVERRIDE"
    say "Saved. It will still be there after a theme switch and a login."
  fi
  pause
}

# 11. WEB APPS
#
# The desktop ships no office suite, no viewer, not even a PDF reader, so
# a .docx that arrives has nothing to open it. LibreOffice is 147 MB and
# an optdepend for people who need real Office round-tripping; this is the
# lighter answer - Docs and Microsoft 365 as their own windows, in the
# launcher, signed in as the user.
#
# A user action rather than a postinstall: the runtime is ~300 MB and
# per-user, and nobody should have Google installed on their behalf.
webapps_entry() {
  screen "Web apps"
  echo "  Office documents, as web apps in their own windows."
  echo "  The first run downloads a ~300 MB browser runtime, once."
  echo

  local choice
  choice=$(gum choose --header "Install" \
    "Google Docs, Sheets and Slides" "Microsoft 365" "Back") || return 0

  case $choice in
    "Google Docs, Sheets and Slides") /usr/share/sway/scripts/webapps.sh docs ;;
    "Microsoft 365") /usr/share/sway/scripts/webapps.sh office ;;
    *) return 0 ;;
  esac
  pause
}

# 12. MODEL
#
# The Ask key (Print, then a) is the one capture action that leaves the
# machine, and aichat owns its own provider/model/key configuration. This
# does not build a second layer over that: it opens theirs and says where
# the keys go. Only shown when aichat is installed - it is an optdepend
# precisely because an LLM tool on every desktop is not a default this
# distribution should choose for anyone.
model_entry() {
  screen "Model"
  local config="${AICHAT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/aichat}/config.yaml"

  if [[ -f $config ]]; then
    echo "  Configured: $(aichat --info 2>/dev/null | sed -n 's/^model *//p' | head -1)"
  else
    echo "  No provider configured. Print then a does nothing until there is one."
  fi
  echo
  echo "  Config: $config"
  echo "  A local Ollama keeps screen regions on this machine;"
  echo "  a hosted provider sends them to that company."
  echo

  gum confirm --affirmative "Edit" --negative "Back" "Open the config?" || return 0
  mkdir -p "$(dirname "$config")"
  ${EDITOR:-vim} "$config"
}

# 13. ORPHANS
#
# The hook (95-ashlaros-orphans.hook) reports after every transaction and
# deliberately suggests nothing destructive. This is where the destructive
# half lives: a checklist of the orphans, all ticked, and the full list of
# what pacman would take shown before a confirm.
#
# `pacman -Qtdq | pacman -Rns -` is the command the upstream hook prints
# and it is a footgun - not because it removes several at once, but
# because it removes blind: it cascades, and on a desktop it takes things
# installed as a dependency of something since removed but still wanted.
# Unticking is how one of those stays, and the preview is where the
# cascade becomes visible.
orphans_entry() {
  local choice orphans
  while true; do
    screen "Packages nothing needs"

    mapfile -t orphans < <(pacman -Qtdq 2>/dev/null)
    if ((${#orphans[@]} == 0)); then
      say "✓ nothing is installed that is no longer required"
      pause
      return 0
    fi

    say "${#orphans[@]} package(s) installed as dependencies that nothing"
    say "depends on any more:"
    echo
    printf "  %s\n" "${orphans[@]}"
    echo

    choice=$(gum choose --header "Orphans" \
      "Remove them" "Show what one is" "Keep one (mark explicit)" "Back") || return 0

    case $choice in
      "Show what one is")
        local pkg
        pkg=$(gum choose --header "Which" "${orphans[@]}") || continue
        screen "$pkg"
        pacman -Qi "$pkg" 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Keep one (mark explicit)")
        local pkg
        pkg=$(gum choose --header "Which" "${orphans[@]}") || continue
        # The safe half of the original advice, and the one nobody knows:
        # it says "I want this" without removing anything.
        root_run pacman -D --asexplicit "$pkg" && say "$pkg is now explicit."
        pause
        ;;
      "Remove them")
        local -a pkgs
        mapfile -t pkgs < <(printf '%s\n' "${orphans[@]}" |
          gum choose --no-limit --selected='*' \
            --header "Untick any to keep, then enter")
        ((${#pkgs[@]})) || continue
        # What -Rns would take is shown before the confirm, because that
        # is the part that surprises people: -s follows each one's own
        # dependencies too.
        screen "Remove ${#pkgs[@]} package(s)"
        say "This would remove:"
        echo
        pacman -Rns --print "${pkgs[@]}" 2>&1 | sed "s/^/  /"
        echo
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Remove these?" || continue
        root_run pacman -Rns --noconfirm "${pkgs[@]}"
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 14. TAILSCALE
#
# Login, logout and the operator pref only. Connect/disconnect and exit
# nodes belong to `tailscale systray`, which the bar already hosts - two
# UIs for one toggle is the rot #95 removed from this menu.
#
# The operator pref is what makes the tray usable without root. tailscaled
# authorises its socket by SO_PEERCRED: uid 0 and the daemon's own uid get
# read-write, anyone else gets read-only, and `wheel` grants nothing at all
# on Linux - isLocalAdmin() finds no system admin group. Without the pref
# the tray renders but every menu item sits behind "No permission to manage
# Tailscale", and Taildrop lists devices happily and then fails on send,
# because serveFileTargets needs only PermitRead while serveFilePut needs
# PermitWrite.
#
# Login before operator, in that order: tailscale#18294 reports
# `set --operator` not sticking on a logged-out node, so this checks that
# the pref survived rather than assuming it.
tailscale_entry() {
  local choice
  while true; do
    screen "Tailscale"

    local state
    state=$(tailscale status --json 2>/dev/null | sed -n 's/.*"BackendState": *"\([^"]*\)".*/\1/p' | head -1)
    if [[ -z $state ]]; then
      oops "tailscaled is not answering."
      say "  systemctl status tailscaled"
      pause
      return 0
    fi

    local operator
    operator=$(tailscale debug prefs 2>/dev/null | sed -n 's/.*"OperatorUser": *"\([^"]*\)".*/\1/p' | head -1)

    case $state in
      Running) say "Connected." ;;
      NeedsLogin) say "Not logged in. This machine is on no tailnet yet." ;;
      Stopped) say "Logged in, but disconnected. The tray icon reconnects." ;;
      *) say "State: $state" ;;
    esac

    if [[ $operator == "$USER" ]]; then
      say "The tray can manage Tailscale without asking for a password."
    else
      say "The tray is read-only until you are set as the operator."
    fi
    echo

    local -a entries=()
    [[ $state == NeedsLogin ]] && entries+=("Log in")
    [[ $state != NeedsLogin ]] && entries+=("Log out")
    [[ $operator == "$USER" ]] || entries+=("Let this account manage Tailscale")
    entries+=("Back")

    choice=$(gum choose --header "Tailscale" "${entries[@]}") || return 0
    case $choice in
      "Log in")
        # interactive by nature: `tailscale up` prints a URL a human has to
        # open, so this hands the terminal over rather than capturing it
        say "A browser link follows. Open it to finish."
        echo
        sudo tailscale up || oops "Login did not complete."
        pause
        ;;
      "Log out")
        root_run tailscale logout && say "Logged out."
        pause
        ;;
      "Let this account manage Tailscale")
        if [[ $state == NeedsLogin ]]; then
          # the pref does not stick on a logged-out node (tailscale#18294)
          oops "Log in first: the setting does not survive on a node that has never logged in."
          pause
          continue
        fi
        root_run tailscale set --operator="$USER" || { pause; continue; }
        local now
        now=$(tailscale debug prefs 2>/dev/null | sed -n 's/.*"OperatorUser": *"\([^"]*\)".*/\1/p' | head -1)
        if [[ $now == "$USER" ]]; then
          say "Done. The tray can manage Tailscale now."
          # the Taildrop receiver is skipped for anyone but the operator,
          # so this is the moment it can start - not the next login
          systemctl --user restart taildrop-receive.service 2>/dev/null &&
            say "Files sent with Taildrop now arrive in $(xdg-user-dir DOWNLOAD)."
        else
          oops "The setting did not stick (tailscale#18294). Try again after a reconnect."
        fi
        pause
        ;;
      *) return 0 ;;
    esac
  done
}

# 15. FACE
#
# Everything #39 settled about PAM applies here for a weaker factor, so
# this follows the fingerprint entry exactly: sufficient before the
# password line, sudo only, refused until a test has passed, and never on
# by default.
#
# What is different is worth saying rather than discovering. From
# howdy-next's own README: "Howdy is weaker than a password. Similar faces
# or photos may fool it." This is 2D infrared matching, not Windows Hello -
# Hello's anti-spoofing comes from a dot projector building a depth map,
# and Howdy reads a flat IR frame. IR defeats a phone screen and a printed
# photo; it does not make this what the hardware does under Windows.
#
# howdy-next is an optdepend and this entry is built only when it is
# installed: pacman resolves 182 packages for it, opencv 112.81 MiB and
# qt6-base 66.53 MiB, for hardware most machines do not have.
# workaround=native: howdy-next's own recommendation for sudo, in
# pam_howdy(8) and in the package's install message. Without it the face
# scan runs first and the password prompt only appears once it gives up;
# with it the scan runs while the prompt is already showing, and a
# recognised face ends the prompt. It needs a real terminal and quietly
# does nothing without one, which sudo from a shell always has.
readonly FACE_LINE="auth       sufficient   pam_howdy.so workaround=native"
readonly FACE_SUDO=/etc/pam.d/sudo
readonly FACE_COMPARE=/usr/lib/howdy/howdy-compare

face_enabled() {
  grep -q "^auth .*pam_howdy.so" "$FACE_SUDO" 2>/dev/null
}

# The camera howdy uses, read from its config. howdy ships with
# device_path = none, and every command that needs a camera fails with
# "Camera is not configured" until one is chosen - so nothing in this
# entry worked on a fresh install. Needs root: /etc/howdy is 750 root.
face_camera() {
  sudo -n awk -F= '
    /^\[/ { video = ($0 ~ /^\[video\]/) }
    video && $1 ~ /^[[:space:]]*device_path[[:space:]]*$/ {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit
    }' /etc/howdy/config.ini 2>/dev/null
}

face_paused() {
  sudo -n grep -qiE '^[[:space:]]*disabled[[:space:]]*=[[:space:]]*(true|1|yes|on)' \
    /etc/howdy/config.ini 2>/dev/null
}

# Whether this user has a face model. Needs root (/etc/howdy/models is 750
# root) and reports by exit status: with no model it prints nothing and
# exits 1.
face_has_model() {
  sudo -n howdy --plain -U "$ME" list >/dev/null 2>&1
}

# Stable names, not /dev/videoN: the numbers follow enumeration order and
# can swap between boots, and howdy's own schema recommends by-id. Only
# index0 - each camera's second node is metadata, not frames.
face_pick_camera() {
  local -a cams=()
  local c
  for c in /dev/v4l/by-id/*-video-index0; do
    [[ -e $c ]] && cams+=("$c")
  done
  if ((${#cams[@]} == 0)); then
    oops "No camera found under /dev/v4l/by-id."
    pause
    return 1
  fi

  # An IR camera first: a colour webcam matches a photograph of you as
  # readily as you, and IR is the whole of howdy's defence against that.
  local -a labels=() ir=() rest=()
  for c in "${cams[@]}"; do
    if [[ ${c,,} == *ir* ]]; then ir+=("$c"); else rest+=("$c"); fi
  done
  cams=("${ir[@]}" "${rest[@]}")
  for c in "${cams[@]}"; do
    local name=${c##*/usb-}
    name=${name%-video-index0}
    [[ ${c,,} == *ir* ]] && name="$name  (infrared)"
    labels+=("$name")
  done

  if ((${#ir[@]} == 0)); then
    warn "No infrared camera found. A colour webcam works, but a photo of"
    warn "you is then as good as your face."
    echo
  fi

  local choice i picked=""
  choice=$(printf '%s\n' "${labels[@]}" | gum choose --header "Which camera?") || return 1
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$choice" ]] && picked=${cams[$i]} && break
  done
  # nothing matched: write nothing, rather than whichever camera the loop
  # happened to end on
  [[ -n $picked ]] || return 1
  # `howdy set` rather than `howdy config`: it edits the one key, checks
  # the value against howdy's schema, and needs no editor
  root_run howdy set device_path "$picked"
}

# Recognition, pass or fail, the way PAM will do it. `howdy test` is not
# this: it opens a camera preview window and exits 0 whenever the camera
# opened, whether or not the face matched. howdy-compare is what
# pam_howdy runs, and says why it failed in its exit status.
face_verify() {
  say "Look at the camera."
  echo
  sudo "$FACE_COMPARE" "$ME"
  local status=$?
  echo
  case $status in
    0) say "✓ Recognised." ;;
    10) oops "No face model for $ME. Add one first." ;;
    11) oops "Not recognised before the timeout." ;;
    13)
      oops "The camera only saw darkness."
      say "An infrared camera whose emitter is off looks exactly like this;"
      say "many laptops leave it off until something turns it on."
      if command -v linux-enable-ir-emitter >/dev/null; then
        say "\"Set up the infrared emitter\" below can switch it on."
      else
        say "Install linux-enable-ir-emitter, then \"Set up the infrared"
        say "emitter\" appears here and can switch it on."
      fi
      ;;
    14) oops "The configured camera could not be opened. Choose it again." ;;
    *) oops "Recognition was aborted (howdy-compare exit $status)." ;;
  esac
  return "$status"
}

# Where the line goes: directly before the password, so after anything
# placed ahead of it. chwd puts pam_fprintd first on machines with a
# reader, and a face line above that would hold sudo in a face scan
# before the finger is even asked for. Before the `include system-auth`
# the password comes from, so a password typed during the scan is taken
# up by pam_unix's try_first_pass rather than asked for twice.
face_enable_pam() {
  root_run sed -i -e "/pam_howdy.so/d" \
    -e "0,/^auth[[:space:]]\+include[[:space:]]\+system-auth/s//$FACE_LINE\n&/" \
    "$FACE_SUDO" || return 1
  # a sudo stack without that include is not one this knows how to edit
  face_enabled && return 0
  oops "$FACE_SUDO has no 'auth include system-auth' line; nothing was changed."
  return 1
}

face_entry() {
  local choice
  # Status below needs root, and asking without a prompt would say "no"
  # to everything whenever the sudo timestamp has expired. Asked once
  # here, with the reason, instead of silently getting the menu wrong.
  screen "Face unlock"
  say "Reading howdy's settings needs root."
  echo
  sudo -v || return 0

  while true; do
    screen "Face unlock"

    local camera models=0 paused=0
    camera=$(face_camera)
    face_has_model && models=1
    face_paused && paused=1

    if [[ -z $camera || $camera == none ]]; then
      warn "! no camera chosen yet"
    else
      say "✓ camera: ${camera##*/}"
    fi
    if ((models > 0)); then
      say "✓ a face model exists for $ME"
    else
      warn "! no face model yet"
    fi
    if face_enabled && ((paused)); then
      warn "! sudo would accept a face, but face unlock is paused"
    elif face_enabled; then
      say "✓ sudo accepts a face (password still works)"
    else
      say "  sudo is password only"
    fi

    echo
    # Stated every time the menu is drawn, not once behind a confirm: it
    # is the thing that decides whether anyone should turn this on.
    say "A face is weaker than a password. A similar face, or a photo,"
    say "may work. Infrared makes that harder, not impossible."
    say "This does not affect the disk passphrase at boot."
    echo

    local has_camera=0
    [[ -n $camera && $camera != none ]] && has_camera=1

    local entries=("Choose the camera")
    if ((has_camera)); then
      if ((models == 0)); then
        entries+=("Add a face model")
      else
        entries+=("Test recognition" "Add another face model" "Remove every face model")
        face_enabled || entries+=("Use it for sudo")
      fi
      entries+=("Show the camera preview")
      command -v linux-enable-ir-emitter >/dev/null && entries+=("Set up the infrared emitter")
    fi
    if face_enabled; then
      if ((paused)); then entries+=("Resume face unlock"); else entries+=("Pause face unlock"); fi
      entries+=("Stop using it for sudo")
    fi
    entries+=("Edit howdy's config file" "Back")

    choice=$(gum choose --header "Face unlock" "${entries[@]}") || return 0
    case $choice in
      "Choose the camera")
        screen "Face unlock"
        face_pick_camera
        pause
        ;;
      "Add a face model" | "Add another face model")
        screen "Face unlock"
        # The recognition models are an ONNX download howdy does not ship;
        # without them add fails in a way that reads like a camera fault.
        say "Fetching the recognition models if they are missing…"
        root_run howdy download-models || { pause; continue; }
        echo
        say "Look at the camera."
        echo
        # On the terminal, not through root_run: add reports progress as it
        # scans, and captured output would only show once it had finished.
        sudo howdy -U "$ME" add
        pause
        ;;
      "Test recognition")
        screen "Face unlock"
        face_verify
        pause
        ;;
      "Show the camera preview")
        screen "Face unlock"
        # A window, not a check: shows what the camera sees and whether a
        # face is found, which is what to look at when recognition fails.
        say "A preview window opens. Close it to come back here."
        echo
        sudo howdy -U "$ME" test
        pause
        ;;
      "Set up the infrared emitter")
        screen "Face unlock"
        # An emitter many laptops leave off is the usual reason recognition
        # sees only darkness. configure finds the UVC control that turns it
        # on by trying candidates and asking, in a window, whether the
        # emitter lit - so it runs on the terminal, and must not be cut
        # short: upstream warns an interrupted search can leave the camera
        # in a bad state.
        say "Sit close to the camera, in a well lit room."
        say "A window opens and asks whether the infrared emitter flashed:"
        say "answer with Y or N inside that window. This can take minutes;"
        say "do not interrupt it."
        echo
        gum confirm --affirmative "Start" --negative "Cancel" "Search for the emitter now?" || continue
        echo
        # the IR camera howdy uses, so the search does not guess a camera
        local dev=$camera
        if sudo linux-enable-ir-emitter --device "$dev" configure; then
          echo
          # run turns the emitter on; the shipped unit does it at boot and
          # after every resume, which is when an emitter resets to off
          root_run systemctl enable --now linux-enable-ir-emitter.service &&
            say "Enabled at boot and after resume. Now try \"Test recognition\"."
        else
          echo
          oops "The search did not find the emitter."
          say "Upstream's next steps are a shutdown (not a reboot) and a"
          say "retry, then --manual; see /usr/share/doc/linux-enable-ir-emitter."
        fi
        pause
        ;;
      "Remove every face model")
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Remove every face model for $ME?" || continue
        root_run howdy -y -U "$ME" clear
        # PAM asking for a face that no longer exists is a delay before
        # every password and nothing else.
        face_enabled && root_run sed -i "/pam_howdy.so/d" "$FACE_SUDO"
        pause
        ;;
      "Use it for sudo")
        screen "Face unlock"
        # Refused until recognition has actually succeeded. Enabling
        # against a camera that has never recognised anyone adds a wait
        # before every password and nothing more.
        if ! face_verify; then
          echo
          oops "So this stays off."
          pause
          continue
        fi
        echo
        gum confirm --affirmative "Enable for sudo" --negative "Cancel" \
          "A photo of you may unlock sudo. Enable it anyway?" || continue
        face_enable_pam || { pause; continue; }
        # a pause left over from before would make this look broken
        root_run howdy disable false
        echo
        say "Enabled. Check it now, while this menu is still open:"
        say "  open another terminal and run: sudo -k true"
        say "A password must still work there. If it does not, choose Stop."
        pause
        ;;
      "Pause face unlock")
        # howdy's own switch: models and the PAM line stay, so resuming
        # needs no re-enrolment and no second test
        root_run howdy disable true && say "Paused. sudo asks for a password only."
        pause
        ;;
      "Resume face unlock")
        root_run howdy disable false && say "Resumed."
        pause
        ;;
      "Stop using it for sudo")
        root_run sed -i "/pam_howdy.so/d" "$FACE_SUDO" || continue
        say "Disabled. sudo is back to password only."
        pause
        ;;
      "Edit howdy's config file")
        # On the terminal: howdy config opens an editor. Through root_run
        # its screen was captured and the editor could not be used.
        sudo howdy config
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 16. FINGERPRINT
#
# Installed everywhere, enabled nowhere. A fresh machine behaves exactly
# as it did before; fingerprint auth turns on only when someone has
# enrolled a finger, proved it verifies, and asked for it.
#
# The danger here is specific and has no recovery from inside the
# session: a PAM stack that cannot fall back to a password turns a reader
# that stops enumerating after a suspend into a machine nobody can use.
# So `sufficient`, placed before the password line, never `required` - a
# finger that fails falls through to the prompt that always worked.
readonly FPRINT_LINE="auth       sufficient   pam_fprintd.so"
readonly FPRINT_SUDO=/etc/pam.d/sudo

fingerprint_enabled() {
  grep -q "^auth .*pam_fprintd.so" "$FPRINT_SUDO" 2>/dev/null
}

# Only the narrowest stack that pays for itself. sudo prompts many times a
# day; the lock screen is where a reader failing after suspend bites
# hardest, and greetd is a TUI greeter where the interaction is poor - so
# neither is offered here.
fingerprint_enable() {
  say "This changes sudo only. Your password keeps working:"
  say "  pam_fprintd is 'sufficient', so a finger that fails or a reader"
  say "  that has stopped responding falls through to the password."
  echo
  gum confirm --affirmative "Enable for sudo" --negative "Cancel" \
    "Use a fingerprint for sudo?" || return 0

  # Inserted before the first auth line, because PAM takes the first
  # sufficient match: after `auth include system-auth` the password has
  # already been asked for and the finger would never be reached.
  #
  # sed -i on a package-owned file edits it in place rather than replacing
  # it, so pacman still owns it and no .pacnew appears.
  #
  # Any existing line is deleted first, so enabling twice cannot stack two
  # of them. The menu already guards on fingerprint_enabled, but an edit
  # to an authentication file should be idempotent on its own terms.
  root_run sed -i -e "/pam_fprintd.so/d" \
    -e "0,/^auth/s//$FPRINT_LINE\nauth/" "$FPRINT_SUDO" || return 1

  # The safety rail: prove the password still authenticates before
  # leaving the user with a stack they cannot reach.
  echo
  say "Enabled. Check it now, while this menu is still open:"
  say "  open another terminal and run: sudo -k true"
  say "A password must still work there. If it does not, choose Disable."
  pause
}

fingerprint_disable() {
  root_run sed -i "/pam_fprintd.so/d" "$FPRINT_SUDO" || return 1
  say "Disabled. sudo is back to password only."
  pause
}

fingerprint_entry() {
  local choice
  while true; do
    screen "Fingerprint"

    # Enrolment is per user and needs no root; the PAM edit does. Taking
    # privilege per action rather than running the whole menu as root.
    local enrolled
    enrolled=$(fprintd-list "$ME" 2>/dev/null | grep -c "#" || true)
    if ((enrolled > 0)); then
      say "✓ $enrolled finger(s) enrolled"
    else
      warn "! no fingers enrolled yet"
    fi

    if fingerprint_enabled; then
      say "✓ sudo accepts a fingerprint (password still works)"
    else
      say "  sudo is password only"
    fi

    # Nothing here touches disk unlock: LUKS happens long before PAM
    # exists, and the installer enrols the TPM against PCR 7. Said out
    # loud so nobody waits for a reader at the passphrase prompt.
    echo
    say "This does not affect the disk passphrase at boot."
    echo

    local entries=("Enrol a finger")
    ((enrolled > 0)) && entries+=("Test it" "Delete enrolled fingers")
    if ((enrolled > 0)) && ! fingerprint_enabled; then
      entries+=("Use it for sudo")
    fi
    fingerprint_enabled && entries+=("Stop using it for sudo")
    entries+=("Back")

    choice=$(gum choose --header "Fingerprint" "${entries[@]}") || return 0
    case $choice in
      "Enrol a finger")
        screen "Fingerprint"
        say "Touch the reader repeatedly when asked."
        echo
        fprintd-enroll 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Test it")
        screen "Fingerprint"
        fprintd-verify 2>&1 | sed "s/^/  /"
        pause
        ;;
      "Delete enrolled fingers")
        gum confirm --affirmative "Delete" --negative "Cancel" \
          "Remove every enrolled finger for $ME?" || continue
        fprintd-delete "$ME" 2>&1 | sed "s/^/  /"
        # Leaving PAM asking for a finger that no longer exists would
        # mean a pointless prompt before every password.
        fingerprint_enabled && root_run sed -i "/pam_fprintd.so/d" "$FPRINT_SUDO"
        pause
        ;;
      "Use it for sudo")
        screen "Fingerprint"
        # Refused until verification has actually succeeded: enabling on
        # a reader that has never read anything is how someone ends up
        # with an extra prompt and no working finger.
        say "Testing the reader first."
        echo
        if fprintd-verify 2>&1 | sed "s/^/  /" | grep -q "verify-match"; then
          echo
          fingerprint_enable
        else
          echo
          oops "That did not verify, so nothing was changed."
          oops "Enrol a finger and test it before enabling."
          pause
        fi
        ;;
      "Stop using it for sudo") fingerprint_disable ;;
      "Back") return 0 ;;
    esac
  done
}

# 17. ADAPTIVE BRIGHTNESS
#
# Report first, because the interesting failure is invisible: wluma
# auto-detects the light sensor, the backlight and the keyboard LED, and
# an explicit config section turns that detection OFF for whatever it
# names. We used to ship a config naming one specific ThinkPad, so every
# other machine got a dead webcam sensor and no backlight at all (#41).
#
# Nothing here writes /etc/xdg: that path is package-owned and a user edit
# there is a .pacnew conflict on the next upgrade. Overrides go to the
# user's own config, which replaces the shipped one wholesale.

# 18. POWER PROFILES
#
# power-profiles-daemon is installed and its service enabled, and until now
# nothing offered it: GNOME and KDE ship switchers, sway does not, so the
# only way in was powerprofilesctl from a shell (#67).
#
# The list is read from the daemon rather than hardcoded. Which profiles
# exist is hardware-dependent - `performance` is absent on some machines -
# and a profile can be present but degraded, with a reason like lap-detect
# or a thermal limit. That difference is the point: "unavailable" and
# "silently doing nothing" look identical from a menu that assumes three.
#
# No root_run anywhere here: switching goes over D-Bus through polkit,
# which the desktop session already satisfies.
power_entry() {
  local choice
  while true; do
    screen "Power"

    local active
    active=$(powerprofilesctl get 2>/dev/null)
    if [[ -z $active ]]; then
      oops "power-profiles-daemon is not answering."
      say "  systemctl status power-profiles-daemon"
      pause
      return 0
    fi
    say "Active: $active"

    # `powerprofilesctl list` prints a block per profile: the name ends
    # with a colon, the active one is marked with a leading *, and a
    # Degraded: line carries "no" or the reason. Parsed in one pass.
    local -a entries=()
    local name="" reason="" line
    while IFS= read -r line; do
      case $line in
        *:)
          # flush the previous block before starting another
          if [[ -n $name ]]; then
            if [[ -n $reason ]]; then
              entries+=("$name - degraded: $reason")
            else
              entries+=("$name")
            fi
          fi
          name=${line%:}
          name=${name#\*}
          name=${name// /}
          reason=""
          ;;
        *Degraded:*)
          # the value is separated by whitespace that is tabs as often as
          # spaces, so trimming one leading space left "  no" in place and
          # every healthy profile was labelled degraded
          reason=${line#*Degraded:}
          reason=${reason//[$' \t']/}
          [[ $reason == "no" ]] && reason=""
          ;;
      esac
    done < <(powerprofilesctl list 2>/dev/null)

    # the last block has no successor to flush it
    if [[ -n $name ]]; then
      if [[ -n $reason ]]; then
        entries+=("$name - degraded: $reason")
      else
        entries+=("$name")
      fi
    fi

    if ((${#entries[@]} == 0)); then
      oops "The daemon listed no profiles."
      pause
      return 0
    fi

    echo
    entries+=("Back")
    choice=$(gum choose --header "Power profile" "${entries[@]}") || return 0
    [[ $choice == "Back" ]] && return 0

    # the label may carry a degraded reason; the profile is the first word
    local target=${choice%% *}
    [[ $target == "$active" ]] && continue

    local out
    if out=$(powerprofilesctl set "$target" 2>&1); then
      # the bar reads the same daemon, so tell it to look now rather than
      # leaving the user watching a stale profile until the next poll
      waybar-signal power >/dev/null 2>&1 || true
    else
      oops "${out:-could not set $target}"
      pause
    fi
  done
}

# 19. SNAPSHOTS
#
# snap-pac brackets every pacman transaction and configure_snapshots bounds
# the retention, so snapshots happen without anyone asking. What was
# missing is any way to look at them, take one deliberately before doing
# something risky, or see what they cost (#62).
#
# The limine half of that issue is deliberately not here: boot-menu
# rollback means replacing systemd-boot and vendoring two single-maintainer
# AUR packages into the boot path, one of which builds against a ~300 MB
# GraalVM. Rollback is `ashlaros-snapshot rollback` from the ISO (#60).
#
# Deleting is offered but never of the snapshot the running system came
# from, and never the whole set: the point of this entry is to make
# snapshots legible, not to give someone a fast way to have none.
snapshots_entry() {
  local choice
  while true; do
    screen "Snapshots"

    if [[ $(findmnt -no FSTYPE / 2>/dev/null) != btrfs ]]; then
      # names what it found rather than asserting ext4: the installer
      # offers ext4, but a root can be something else again and telling
      # someone their filesystem is a thing it is not helps nobody
      say "The root filesystem is $(findmnt -no FSTYPE / 2>/dev/null), not btrfs,"
      say "so there are no snapshots. snapper needs btrfs subvolumes."
      pause
      return 0
    fi
    if [[ ! -f /etc/snapper/configs/root ]]; then
      warn "snapper has no 'root' config, so nothing is being captured."
      say "  sudo snapper -c root create-config /"
      pause
      return 0
    fi

    local count
    count=$(snapper -c root list --columns number 2>/dev/null | grep -c '^ *[0-9]')
    say "$count snapshot(s)"

    # What they cost, which is the question that sends people looking for
    # this entry. btrfs accounts shared extents once, so this is the real
    # figure rather than the sum of the subvolume sizes.
    local used
    used=$(btrfs filesystem usage -h / 2>/dev/null |
      awk '/Used:/ { print $2; exit }')
    [[ -n $used ]] && say "Filesystem used: $used"
    echo

    choice=$(gum choose --header "Snapshots" \
      "List them" \
      "Take one now" \
      "What changed in one" \
      "Delete one" \
      "Rollback (needs the ISO)" \
      "Back") || return 0

    case $choice in
      "List them")
        screen "Snapshots"
        snapper -c root list 2>&1 | sed "s/^/  /" | head -40
        pause
        ;;
      "Take one now")
        screen "Snapshots"
        local description
        description=$(gum input --prompt "What is this for: " \
          --value "before manual changes") || continue
        [[ -n $description ]] || continue
        # the same tool the update path uses, so one code path takes
        # snapshots however they are asked for
        ashlaros-snapshot create "$description" 2>&1 | sed "s/^/  /"
        pause
        ;;
      "What changed in one")
        local number
        number=$(snapshot_pick "Show the changes in") || continue
        screen "Snapshots"
        say "Files that differ between $number and now:"
        echo
        # status needs a range; N..0 is "that snapshot against the live
        # system", which is the comparison someone asking this wants
        snapper -c root status "$number..0" 2>&1 | sed "s/^/  /" | head -40
        pause
        ;;
      "Delete one")
        local number
        number=$(snapshot_pick "Delete") || continue
        # The snapshot the running system was rolled back to is the one
        # thing here that must not go: deleting it is deleting the root
        # this machine is currently using.
        if [[ $number == "$(current_snapshot)" ]]; then
          screen "Snapshots"
          oops "That is the snapshot this system is running from."
          say "Deleting it would remove the root filesystem in use."
          pause
          continue
        fi
        gum confirm --affirmative "Delete" --negative "Cancel" \
          "Delete snapshot $number? This cannot be undone." || continue
        root_run snapper -c root delete "$number" && say "Deleted $number."
        pause
        ;;
      "Rollback (needs the ISO)")
        screen "Snapshots"
        say "Rollback replaces the root subvolume, which cannot happen"
        say "while it is mounted - so it is a rescue-media procedure."
        echo
        say "  Boot the AshlarOS ISO, then:"
        say "    cryptsetup open /dev/<disk> root"
        say "    mount -o subvolid=5 /dev/mapper/root /mnt"
        say "    ashlaros-snapshot rollback --top-level /mnt"
        echo
        say "The command lists the snapshots and asks before changing anything."
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# The snapshot the running root came from, or nothing.
#
# After a rollback, @ is a snapshot of one - snapper records the source in
# the new subvolume's own info. A machine that has never rolled back has
# no such number, and then nothing here is protected because nothing needs
# to be.
current_snapshot() {
  btrfs subvolume show / 2>/dev/null |
    awk -F'/' '/Snapshot\(s\)|Parent UUID/ { next } /\.snapshots\/[0-9]+/ {
      for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+$/) { print $i; exit }
    }'
}

# One snapshot, chosen by number and description rather than number alone.
# snapper draws a box table, and the number is right-aligned hard against
# the U+2502 separator with no space - so on a real listing $1 is "0│" and
# not "0". Measured against real snapshots in the VM: the whitespace-field
# version matched nothing at all, which made every action here select
# nothing and silently do nothing. The column separator is what the fields
# are split on for that reason.
SNAPSHOT_NUMBER='BEGIN { FS = "\u2502" } { n = $1; gsub(/[[:space:]]/, "", n) }'

snapshot_pick() {
  local header=$1 rows choice
  rows=$(snapper -c root list --columns number,date,description 2>/dev/null |
    awk "$SNAPSHOT_NUMBER"' NR > 2 && n ~ /^[0-9]+$/ { print }' | tail -30)
  [[ -n $rows ]] || { screen "Snapshots"; warn "No snapshots yet."; pause; return 1; }
  choice=$(printf '%s\n' "$rows" | gum choose --header "$header") || return 1
  [[ -n $choice ]] || return 1
  awk "$SNAPSHOT_NUMBER"' { print n }' <<<"$choice"
}

# 20. DISK UNLOCK
#
# The installer enrols the LUKS passphrase into the TPM against PCR 7
# whenever a TPM is present, and the machine then unlocks silently on
# every boot. That is a choice about a personal tradeoff, made by
# hardware detection, and this is where the user makes it instead (#64).
#
# Three modes, all legitimate, and the entry says what each defends
# rather than ranking them. TPM-only is the right answer for a desktop
# that never leaves the house; it is the wrong answer for a laptop, and
# the difference is the user's to know.
#
# systemd-cryptenroll does all of it on a running system, so nothing here
# needs a reinstall.

# The encrypted device the root sits on, or empty when the root is not
# encrypted. Asked of the kernel rather than of crypttab: a machine can
# have a crypttab entry for something that is not the root.
root_crypt_device() {
  local source
  source=$(findmnt -no SOURCE / 2>/dev/null) || return 1
  # /dev/mapper/name -> the holder underneath it. lsblk walks the stack
  # so this works through LVM as well as a plain dm-crypt.
  local name
  name=$(lsblk -nso NAME,TYPE "$source" 2>/dev/null |
    awk '$2 == "crypt" { found = 1; next } found && $2 == "part" { print $1; exit }')
  [[ -n $name ]] || return 1
  echo "/dev/$name"
}

# What is actually enrolled, from the device rather than from crypttab.
# Real format, measured: a "SLOT TYPE" header then one row per slot, so
# the types are the second column from line two on.
enrolled_types() {
  local device=$1
  root_run systemd-cryptenroll "$device" 2>/dev/null |
    awk 'NR > 1 { print $2 }' | sort -u
}

# Whether the TPM enrolment carries a PIN. systemd-cryptenroll's listing
# says "tpm2" either way, so the distinction lives in the LUKS token.
#
# Read from the exported token rather than from luksDump: measured
# against a real enrolment on a machine with a TPM, the flag is JSON
# inside the token - {"type":"systemd-tpm2",...,"tpm2-pin":true,...} -
# and luksDump's text rendering does not carry it at all. Grepping
# luksDump for it reports "no PIN" on a device that has one, which is
# exactly the wrong way to be wrong about someone's disk.
tpm_has_pin() {
  local device=$1
  local id
  for id in $(root_run cryptsetup luksDump "$device" 2>/dev/null |
    awk '/^[[:space:]]*[0-9]+: systemd-tpm2/ { sub(":", "", $1); print $1 }'); do
    root_run cryptsetup token export --token-id "$id" "$device" 2>/dev/null |
      grep -q '"tpm2-pin"[[:space:]]*:[[:space:]]*true' && return 0
  done
  return 1
}

disk_unlock_entry() {
  local device types choice
  while true; do
    screen "Disk unlock"

    device=$(root_crypt_device) || {
      say "The root filesystem is not encrypted, so there is nothing to unlock."
      pause
      return 1
    }

    types=$(enrolled_types "$device")
    say "Encrypted device: $device"
    echo

    local mode="passphrase"
    if grep -qx "tpm2" <<<"$types"; then
      if tpm_has_pin "$device"; then
        mode="tpm+pin"
        say "✓ TPM + PIN — a short PIN every boot"
      else
        mode="tpm"
        say "✓ TPM only — this machine unlocks silently at boot"
      fi
    else
      say "✓ Passphrase only — the full passphrase every boot"
    fi
    grep -qx "recovery" <<<"$types" && say "  a recovery key is also enrolled"
    echo

    # The table is the UI, not the documentation. Someone choosing TPM
    # only should read "laptop theft: no" while they choose it.
    say "                  boot            defends drive   defends whole"
    say "                  experience      theft           machine theft"
    say "  passphrase      full phrase     yes             yes"
    say "  TPM + PIN       short PIN       yes             yes (rate-limited)"
    say "  TPM only        silent          yes             NO"
    echo

    # PCR 7 measures Secure Boot policy, and with Secure Boot off it
    # holds a stable value that matches whatever boots - including an
    # attacker's stick. Said here because it changes what TPM-only is
    # worth on this machine specifically, and most machines running this
    # distribution have Secure Boot off.
    # Read from the firmware variable rather than parsing bootctl: the
    # efivar is the value itself, present on any UEFI machine, and one
    # byte instead of a text format that can be reworded. Measured on
    # this hardware: five bytes, the last of which is the flag.
    local secureboot="off"
    local sb_var
    sb_var=$(echo /sys/firmware/efi/efivars/SecureBoot-*)
    if [[ -r $sb_var ]]; then
      [[ $(od -An -t u1 "$sb_var" 2>/dev/null | awk '{ print $NF }') == "1" ]] &&
        secureboot="on"
    fi
    case "$secureboot" in
      on) say "  Secure Boot is on, so the PCR 7 binding means what it says." ;;
      *)
        warn "! Secure Boot is off, so PCR 7 holds the same value for any"
        warn "  boot media. TPM-only unlock protects a removed drive, not"
        warn "  this machine. A PIN is what closes that."
        ;;
    esac
    echo

    local entries=()
    [[ $mode != "tpm+pin" ]] && entries+=("Use TPM + PIN")
    [[ $mode != "tpm" ]] && entries+=("Use TPM only")
    [[ $mode != "passphrase" ]] && entries+=("Passphrase only")
    entries+=("Back")

    choice=$(gum choose --header "Disk unlock" "${entries[@]}") || return 0
    case "$choice" in
      "Use TPM + PIN")
        tpm_enroll "$device" yes
        ;;
      "Use TPM only")
        say "This machine will unlock with no prompt at all."
        [[ $secureboot != "on" ]] &&
          warn "With Secure Boot off, anything that boots this hardware unlocks it."
        gum confirm --affirmative "Enrol" --negative "Cancel" \
          "Unlock silently, defending a removed drive but not a stolen machine?" ||
          continue
        tpm_enroll "$device" no
        ;;
      "Passphrase only")
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Remove TPM unlock? Every boot will ask for the full passphrase." ||
          continue
        # --wipe-slot takes the type, so this removes the TPM enrolment
        # and leaves the passphrase and any recovery key untouched
        if root_run systemd-cryptenroll "$device" --wipe-slot=tpm2; then
          say "TPM unlock removed."
        else
          oops "Could not remove the TPM enrolment."
        fi
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# Enrol the TPM, with or without a PIN. Wipes any existing tpm2 slot
# first: cryptenroll adds a second one otherwise, and the old silent slot
# would still unlock the disk, which makes adding a PIN do nothing.
tpm_enroll() {
  local device=$1 with_pin=$2

  if [[ ! -e /dev/tpmrm0 && ! -e /dev/tpm0 ]]; then
    oops "No TPM on this machine."
    pause
    return 1
  fi

  if [[ $with_pin == "yes" ]]; then
    # The hardware is what makes a short PIN safe - the TPM rate-limits
    # attempts itself, unlike a passphrase an attacker can try offline.
    # Report the machine's real policy rather than claiming it.
    # Measured against a software TPM: the field prints as
    # "TPM2_PT_MAX_AUTH_FAIL: 0x3", so the value is hex and telling
    # someone their TPM allows 0x3 attempts helps nobody.
    local max_fail
    max_fail=$(root_run tpm2_getcap properties-variable 2>/dev/null |
      awk '/MAX_AUTH_FAIL/ { print $NF; exit }')
    [[ $max_fail == 0x* ]] && max_fail=$((max_fail))
    if [[ -n $max_fail ]]; then
      say "This TPM locks out after $max_fail failed attempts, which is what"
      say "makes a short PIN safe where a short passphrase would not be."
    fi
    echo
  fi

  # The existing passphrase is needed to add any new slot, and
  # cryptenroll asks for it on the terminal itself.
  say "You will be asked for the current disk passphrase."
  [[ $with_pin == "yes" ]] && say "then for a new PIN, twice."
  echo

  root_run systemd-cryptenroll "$device" --wipe-slot=tpm2 >/dev/null 2>&1 || true

  if root_run systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 \
    "--tpm2-with-pin=$with_pin" "$device"; then
    # crypttab is what makes early boot ask the TPM at all; without it
    # the enrolment exists and nothing uses it
    if ! grep -q "tpm2-device=auto" /etc/crypttab 2>/dev/null; then
      warn "Enrolled, but /etc/crypttab does not ask the TPM at boot."
      warn "Add tpm2-device=auto to the root entry's options."
    else
      say "Enrolled. Test it by rebooting before you rely on it."
    fi
  else
    oops "Enrolment failed. The disk still unlocks with the passphrase."
  fi
  pause
}

flashing_entry() {
  local unit=flashfocus
  local user_config="${XDG_CONFIG_HOME:-$HOME/.config}/sway/flashfocus.conf"
  local choice

  while true; do
    screen "Focus flashing"
    say "A window dips in opacity for a moment when it takes focus, so the"
    say "eye can follow where focus went."
    echo

    # Masked is the off state, not disabled: etc/sway/autostart runs
    # `systemctl --user enable --now flashfocus` on every login, so a
    # disable is undone by the next one. A mask makes that enable fail
    # loudly instead. Do not "simplify" this back to disable.
    if unit_masked "$unit"; then
      warn "! off - and it stays off across logins"
    elif systemctl --user is-active "$unit" >/dev/null 2>&1; then
      say "✓ on"
    else
      warn "! not running, but not switched off either"
      say "  it starts with the next sway session"
    fi

    echo
    if [[ -f $user_config ]]; then
      say "Your settings: $user_config"
    else
      say "Timing and opacity live in /etc/sway/flashfocus.conf."
      say "Copy it to $user_config to change them."
    fi

    echo
    choice=$(gum choose --header "Focus flashing" \
      "Turn on" "Turn off" "Edit my settings" "Back") || return 0

    case $choice in
      "Turn on")
        if unit_switch "$unit" on; then
          say "On."
        else
          oops "It did not start: systemctl --user status $unit"
        fi
        pause
        ;;
      "Turn off")
        unit_switch "$unit" off
        say "Off, and it will stay off after a login."
        pause
        ;;
      "Edit my settings")
        mkdir -p "$(dirname "$user_config")"
        if [[ ! -f $user_config ]] && [[ -f /etc/sway/flashfocus.conf ]]; then
          cp /etc/sway/flashfocus.conf "$user_config"
        fi
        "${EDITOR:-vim}" "$user_config"
        systemctl --user try-restart "$unit" 2>/dev/null
        ;;
      "Back") return 0 ;;
    esac
  done
}

wluma_entry() {
  local user_config="${XDG_CONFIG_HOME:-$HOME/.config}/wluma/config.toml"
  local choice

  while true; do
    screen "Adaptive brightness"

    if systemctl --user is-active wluma >/dev/null 2>&1; then
      say "✓ wluma is running"
    else
      warn "! wluma is not running"
      warn "  the waybar toggle starts it, or: systemctl --user enable --now wluma"
    fi

    # What it could possibly control, read from the machine rather than
    # assumed. A laptop with no backlight directory is a laptop where this
    # tool has nothing to do, and saying so beats an empty success.
    local backlights
    backlights=$(ls -A /sys/class/backlight 2>/dev/null | tr '\n' ' ')
    if [[ -n $backlights ]]; then
      say "  backlights: $backlights"
    else
      oops "  no /sys/class/backlight device - nothing to dim"
    fi

    # a glob rather than ls|grep: wluma matches on the same substring
    local leds=""
    for led in /sys/class/leds/*kbd_backlight*; do
      [[ -e $led ]] && leds+="${led##*/} "
    done
    [[ -n $leds ]] && say "  keyboard LEDs: $leds"

    # wluma discovers an IIO ambient light sensor when one exists and no
    # explicit [als.*] section overrides it. A real sensor beats inferring
    # room brightness from a webcam image, so it is worth naming.
    if [[ -d /sys/bus/iio/devices ]] &&
      compgen -G "/sys/bus/iio/devices/iio:device*" >/dev/null; then
      say "  ambient light sensor: present (IIO)"
    else
      say "  ambient light sensor: none found; wluma will use screen contents"
    fi

    echo
    if [[ -f $user_config ]]; then
      warn "Your own config overrides auto-detection:"
      say "  $user_config"
    else
      say "No user config: everything is auto-detected, which is usually right."
    fi

    echo
    choice=$(gum choose --header "Adaptive brightness" \
      "Show what wluma detected" "Edit my config" "Remove my config" "Back") || return 0

    case $choice in
      "Show what wluma detected")
        screen "Adaptive brightness"
        # The daemon logs what it discovered at debug level, which is the
        # only place the detected names appear. Reading its journal beats
        # reimplementing the detection and disagreeing with it.
        say "The last thing wluma logged:"
        echo
        journalctl --user -u wluma -n 25 --no-pager 2>&1 | sed "s/^/  /"
        echo
        say "Names and paths appear here with RUST_LOG=debug."
        pause
        ;;
      "Edit my config")
        # Seeded with a pointer rather than the packaged example: wluma 5.0.0
        # deleted config.toml from its tarball and documents the sections in
        # the README instead, which the package renders to man 7 wluma. An
        # empty file is a valid config that changes no behaviour, so a user
        # who wants to override something still has to be told where the
        # section names are written down.
        mkdir -p "$(dirname "$user_config")"
        if [[ ! -f $user_config ]]; then
          {
            echo "# Everything you add below is OPTIONAL and every section"
            echo "# you add turns OFF auto-detection for what it names."
            echo "# An empty file is the right config on most machines."
            echo "#"
            echo "# The sections and their fields: man 7 wluma"
          } > "$user_config"
        fi
        "${EDITOR:-vim}" "$user_config"
        systemctl --user restart wluma 2>/dev/null
        ;;
      "Remove my config")
        [[ -f $user_config ]] || { warn "There is no user config to remove."; pause; continue; }
        gum confirm --affirmative "Remove" --negative "Cancel" \
          "Delete $user_config and go back to auto-detection?" || continue
        rm -f "$user_config"
        systemctl --user restart wluma 2>/dev/null
        say "Removed. wluma will detect everything again."
        pause
        ;;
      "Back") return 0 ;;
    esac
  done
}

# 21. THEME
#
# Was its own script, ashlaros-theme, behind a launcher entry: two rofi
# prompts and a separate foot window just to ask for sudo. The same steps
# here, in the terminal this already runs in.
#
# A theme is a pair. The day theme becomes the active one; the night theme
# is stashed beside it as theme.light.conf_ and foot-theme.light.ini_ -
# the names theme-toggle.sh reads to tell which half is live and writes
# back when the waybar toggle flips them. "light" is that contract, not a
# description of the theme.
THEME_DIR=/usr/share/sway/themes

# Missing packages a theme names, one per line; empty when all are there.
theme_missing() {
  [[ -f $1/packages ]] || return 0
  local -a wanted
  mapfile -t wanted < "$1/packages"
  pacman -T "${wanted[@]}" 2>/dev/null || true
}

# Whether a theme can be finished on this machine: every package it lacks
# is in a configured repository. Offering one that cannot is #56 - on ARM
# the catppuccin themes applied their sway colours and then asked for
# AUR-only packages the machine could not get.
theme_installable() {
  local pkg
  while read -r pkg; do
    [[ -n $pkg ]] || continue
    pacman -Si "$pkg" >/dev/null 2>&1 || return 1
  done < <(theme_missing "$1")
  return 0
}

# Which shipped theme a copy in definitions.d is, or nothing if edited.
theme_name_of() {
  local copy=$1 dir
  [[ -f $copy ]] || return 0
  for dir in "$THEME_DIR"/*/; do
    cmp -s "$copy" "$dir/theme.conf" && { basename "$dir"; return 0; }
  done
}

theme_install() {
  local -a missing
  mapfile -t missing < <(theme_missing "$1")
  [[ ${#missing[@]} -gt 0 ]] || return 0
  say "$(basename "$1") needs: ${missing[*]}"
  sudo pacman -S --needed "${missing[@]}"
}

theme_entry() {
  screen "Theme"

  local defs="$HOME/.config/sway/definitions.d"
  local day night
  day=$(theme_name_of "$defs/theme.conf")
  night=$(theme_name_of "$defs/theme.light.conf_")
  say "Day theme:   ${day:-a theme.conf you edited}"
  say "Night theme: ${night:-a theme.light.conf_ you edited}"
  say "The waybar toggle switches between them."
  echo

  local -a themes=()
  local dir
  for dir in "$THEME_DIR"/*/; do
    dir=${dir%/}
    theme_installable "$dir" && themes+=("$(basename "$dir")")
  done
  if [[ ${#themes[@]} -eq 0 ]]; then
    oops "No theme on this machine can install its packages."
    pause
    return 1
  fi

  local new_day new_night
  new_day=$(printf '%s\n' "${themes[@]}" | gum filter --header "Day theme" \
    --placeholder "type to filter") || return 0
  new_night=$(printf '%s\n' "${themes[@]}" | gum filter --header "Night theme" \
    --placeholder "type to filter") || return 0
  [[ -n $new_day && -n $new_night ]] || return 0

  theme_install "$THEME_DIR/$new_day" || { pause; return 1; }
  theme_install "$THEME_DIR/$new_night" || { pause; return 1; }

  mkdir -p "$defs" "$HOME/.config/foot"
  cp --backup "$THEME_DIR/$new_day/theme.conf" "$defs/theme.conf"
  cp --backup "$THEME_DIR/$new_night/theme.conf" "$defs/theme.light.conf_"
  # foot-theme.ini is not one of the pair: theme-toggle.sh builds it from
  # the .dark. and .light. halves, so writing it directly would be undone
  # by the first toggle. Write the halves, then have it merged.
  [[ -f $THEME_DIR/$new_day/foot-theme.ini ]] &&
    cp --backup "$THEME_DIR/$new_day/foot-theme.ini" "$HOME/.config/foot/foot-theme.dark.ini_"
  [[ -f $THEME_DIR/$new_night/foot-theme.ini ]] &&
    cp --backup "$THEME_DIR/$new_night/foot-theme.ini" "$HOME/.config/foot/foot-theme.light.ini_"
  /usr/share/sway/scripts/theme-toggle.sh merge-foot >/dev/null 2>&1 || true
  # last, so the reload applies the day theme with everything in place
  swaymsg reload >/dev/null 2>&1

  say "Day: $new_day, night: $new_night."
  pause
}

# 22. LOCATION
#
# One place for everything that follows the sun or the sky: the weather in
# the bar, the night light (sunset.sh -> wlsunset) and the automatic
# day/night theme (theme-toggle.sh). All three ask geoip.sh, which answers
# from this file when it exists and guesses from the network when it does
# not - so "Automatic" is the absence of the file, not a value in it.
LOCATION_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ashlaros/location"
readonly GEOCODE_URL="https://geocoding-api.open-meteo.com/v1/search"

# A place as "latitude<TAB>longitude<TAB>name", the name last because typed
# coordinates have none and read would collapse a leading empty field.
# Typed coordinates are taken as they are and go nowhere; a name is looked
# up at open-meteo, the same geocoder the weather module uses for a typed
# city. Messages to stderr: stdout is the answer.
location_pick() {
  local query lang results choice
  query=$(gum input --header "A town or city, or coordinates as 50.11, 8.68" \
    --placeholder "Frankfurt am Main") || return 1
  query=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$query")
  [[ -n $query ]] || return 1

  if [[ $query =~ ^(-?[0-9]+(\.[0-9]+)?)[[:space:]]*,[[:space:]]*(-?[0-9]+(\.[0-9]+)?)$ ]]; then
    local lat=${BASH_REMATCH[1]} lon=${BASH_REMATCH[3]}
    if jq -en --argjson lat "$lat" --argjson lon "$lon" \
      '$lat >= -90 and $lat <= 90 and $lon >= -180 and $lon <= 180' >/dev/null; then
      printf '%s\t%s\t' "$lat" "$lon"
      return 0
    fi
    oops "Latitude runs from -90 to 90 and longitude from -180 to 180." >&2
    return 1
  fi

  # names in the language the desktop is in, where open-meteo has them
  lang=${LANG%%[_.]*}
  [[ $lang =~ ^[a-z]{2}$ ]] || lang=en
  results=$(gum spin --title "Looking up $query" -- \
    curl -fsSL --max-time 10 -G --data-urlencode "name=$query" \
    --data-urlencode "count=10" --data-urlencode "language=$lang" \
    "$GEOCODE_URL" 2>/dev/null |
    jq -r '.results // [] | .[]
      | [([.name, .admin1, .country] | map(select(. != null and . != "")) | join(", ")),
         (.latitude * 10000 | round / 10000), (.longitude * 10000 | round / 10000), .name]
      | @tsv' 2>/dev/null)
  if [[ -z $results ]]; then
    oops "Nothing found for \"$query\" - or open-meteo.com could not be reached." >&2
    return 1
  fi
  # the label alone is chosen: two Frankfurts differ by region, and the
  # region is in the label
  choice=$(cut -f1 <<<"$results" | gum choose --header "Which one?") || return 1
  awk -F'\t' -v c="$choice" '$1 == c { printf "%s\t%s\t%s", $2, $3, $4; exit }' <<<"$results"
}

# What follows the new place right away rather than at the next login:
# wlsunset reads its coordinates once, at start.
location_apply() {
  systemctl --user try-restart wlsunset >/dev/null 2>&1
  waybar-signal weather >/dev/null 2>&1
  waybar-signal theme >/dev/null 2>&1
  return 0
}

location_entry() {
  local choice pick name lat lon geo
  while true; do
    screen "Location"
    say "The weather in the bar, the night light and the automatic"
    say "day/night theme all follow this."
    echo

    # what the three consumers will actually get, asked the way they ask
    geo=$(sh /usr/share/sway/scripts/geoip.sh 2>/dev/null)
    if [[ -r $LOCATION_FILE ]]; then
      name=$(conf_get "$LOCATION_FILE" name)
      say "Set to ${name:+$name, }$(conf_get "$LOCATION_FILE" latitude), $(conf_get "$LOCATION_FILE" longitude)"
    elif [[ -n $geo ]]; then
      say "Automatic: $(jq -r '.city // "somewhere unnamed"' <<<"$geo")"
      hint "Guessed from this machine's network address by ashlaros.download,"
      hint "which keeps no record of it."
    else
      say "Automatic"
      warn "! No guess yet - offline, or the network hides where it is."
    fi
    [[ -n $geo ]] && hint "$(jq -r 'if .sunrise then "Sunrise \(.sunrise[11:16]), sunset \(.sunset[11:16])"
      else "No sunrise or sunset today" end' <<<"$geo" 2>/dev/null)"

    # Settings of their own that win over this one, said rather than
    # silently ignored: a place here that the weather does not follow
    # looks like a bug.
    local city
    city=$(conf_get "${XDG_CONFIG_HOME:-$HOME/.config}/weather.cfg" city)
    if [[ -n $city && $city != auto ]]; then
      echo
      warn "! The weather follows city = $city in ~/.config/weather.cfg instead."
    fi
    if grep -qs '^[[:space:]]*\(latitude\|longitude\|location\)=' "$HOME/.config/wlsunset/config"; then
      echo
      warn "! ~/.config/wlsunset/config sets the night light's own location."
    fi
    echo

    local weather_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/weather.cfg" temperature distance
    temperature=$(conf_get "$weather_cfg" temperature)
    distance=$(conf_get "$weather_cfg" distance)
    [[ ${temperature:-C} == F ]] && temperature="°F" || temperature="°C"
    [[ ${distance:-km} == miles ]] && distance="mph" || distance="km/h"

    local -a entries=("Choose a place")
    [[ -r $LOCATION_FILE ]] && entries+=("Automatic")
    entries+=("Weather in $temperature and $distance" "Back")
    choice=$(gum choose --header "Location" "${entries[@]}") || return 0

    case $choice in
      "Choose a place")
        pick=$(location_pick) || { pause; continue; }
        IFS=$'\t' read -r lat lon name <<<"$pick"
        private_file "$LOCATION_FILE"
        {
          echo "# written by ashlaros-settings-tui; read by geoip.sh"
          [[ -n $name ]] && echo "name = $name"
          echo "latitude = $lat"
          echo "longitude = $lon"
        } > "$LOCATION_FILE"
        location_apply
        say "✓ ${name:-$lat, $lon}"
        pause
        ;;
      "Automatic")
        rm -f "$LOCATION_FILE"
        location_apply
        say "✓ Guessing from the network again."
        pause
        ;;
      "Weather in "*)
        # weather.sh reads both from weather.cfg; the rest of that file,
        # city included, is left as it is
        local units
        units=$(printf '%s\n' "°C and km/h|C km" "°F and mph|F miles" "°C and mph|C miles" |
          gum choose --label-delimiter="|" --header "Weather units") || continue
        conf_line "$weather_cfg" temperature "temperature = ${units% *}"
        conf_line "$weather_cfg" distance "distance = ${units#* }"
        waybar-signal weather >/dev/null 2>&1
        ;;
      *) return 0 ;;
    esac
  done
}

# 23. SCREEN TIMEOUTS
#
# /etc/swayidle/config reads its timeouts as ${IDLE_*} with the shipped
# values as defaults, and swayidle.service loads this file as its
# environment - so a user sets numbers and never takes a copy of the
# config, which would stop every later fix to it reaching them. 0 is "never".
IDLE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ashlaros/idle"
# "variable|label|default seconds"
IDLE_STEPS=(
  "IDLE_DIM|Dim the screen|240"
  "IDLE_LOCK|Lock|300"
  "IDLE_SCREEN_OFF|Turn the screen off|600"
  "IDLE_SUSPEND_BATTERY|Suspend on battery|900"
  "IDLE_SUSPEND_AC|Suspend when plugged in|3600"
)
readonly MEDIA_UNIT=wayland-pipewire-idle-inhibit

idle_seconds() {
  local value
  value=$(conf_get "$IDLE_FILE" "$1")
  printf '%s' "${value:-$2}"
}

idle_words() {
  local s=$1
  if ((s == 0)); then printf 'never'
  elif ((s % 3600 == 0)); then printf '%d h' $((s / 3600))
  elif ((s % 60 == 0)); then printf '%d min' $((s / 60))
  else printf '%d s' "$s"
  fi
}

screen_timeouts_entry() {
  local choice step var label def value
  while true; do
    screen "Screen timeouts"
    say "After how long without input:"
    echo
    local -a rows=()
    for step in "${IDLE_STEPS[@]}"; do
      IFS='|' read -r var label def <<<"$step"
      value=$(idle_seconds "$var" "$def")
      rows+=("$(printf '%-24s %s' "$label" "$(idle_words "$value")")|$var")
    done
    # the lock is what stands between an unattended laptop and anyone
    # walking past it; say so where it is switched off
    [[ $(idle_seconds IDLE_LOCK 300) == 0 ]] &&
      warn "! The screen never locks by itself - Super+Shift+E, then L, still does."
    if command -v "$MEDIA_UNIT" >/dev/null; then
      if unit_masked "$MEDIA_UNIT"; then
        rows+=("$(printf '%-24s %s' "Stay on while media plays" "no")|media")
      else
        rows+=("$(printf '%-24s %s' "Stay on while media plays" "yes")|media")
      fi
    fi
    hint "A video in the browser, or anything you started with Super+Shift+I,"
    hint "keeps the screen on too."
    echo
    rows+=("Back to the defaults|reset" "Back|back")

    choice=$(printf '%s\n' "${rows[@]}" |
      gum choose --label-delimiter="|" --header "Screen timeouts") || return 0
    case $choice in
      back|"") return 0 ;;
      media)
        if unit_masked "$MEDIA_UNIT"; then
          unit_switch "$MEDIA_UNIT" on
        else
          unit_switch "$MEDIA_UNIT" off
        fi
        continue
        ;;
      reset)
        rm -f "$IDLE_FILE"
        ;;
      *)
        for step in "${IDLE_STEPS[@]}"; do
          [[ ${step%%|*} == "$choice" ]] && IFS='|' read -r var label def <<<"$step"
        done
        # minutes, because that is how anyone thinks about this; the
        # config is seconds, so a line someone wrote by hand in seconds
        # is shown as it is
        value=$(printf '%s\n' "1 min|60" "2 min|120" "3 min|180" "4 min|240" \
          "5 min|300" "10 min|600" "15 min|900" "20 min|1200" "30 min|1800" \
          "45 min|2700" "1 h|3600" "2 h|7200" "never|0" |
          gum choose --label-delimiter="|" --header "$label after" \
            --selected "$(idle_words "$(idle_seconds "$var" "$def")")") || continue
        conf_line "$IDLE_FILE" "$var" "$var=$value"
        ;;
    esac
    # swayidle reads its environment once, at start
    systemctl --user try-restart swayidle >/dev/null 2>&1
  done
}

# 24. TOUCHPAD AND KEYBOARD
#
# etc/sway/inputs/default-touchpad sets tap, natural scrolling and
# typing-disables-touchpad; nothing set speed or key repeat. This writes
# config.d/50-input.conf, which sway includes after /etc/sway/inputs, and
# applies each change to the running session with the same line.
INPUT_CONF="$HOME/.config/sway/config.d/50-input.conf"

# The live value of one libinput setting on the first device of a type,
# e.g. input_live touchpad tap -> enabled. Empty where there is none.
input_live() {
  swaymsg -t get_inputs --raw 2>/dev/null |
    jq -r --arg t "$1" --arg k "$2" \
      'first(.[] | select(.type == $t) | (.libinput[$k] // .[$k])) // empty'
}

# Writes `input type:<type> <setting> <value>` to the file and to sway.
# Sway first: a line it refuses live would break the config at the next
# reload, so it is only written once sway has taken it.
input_set() {
  local type=$1 setting=$2 value=$3
  if ! swaymsg -q "input type:$type $setting $value" 2>/dev/null; then
    oops "sway did not take: input type:$type $setting $value"
    pause
    return 1
  fi
  conf_line "$INPUT_CONF" "input type:$type $setting" "input type:$type $setting $value"
}

input_onoff() { [[ $(input_live touchpad "$1") == enabled ]] && printf 'on' || printf 'off'; }

input_toggle() {
  local type=$1 setting=$2
  if [[ $(input_live "$type" "$setting") == enabled ]]; then
    input_set "$type" "$setting" disabled
  else
    input_set "$type" "$setting" enabled
  fi
}

# -1 to 1 as five steps anyone can pick between, and back to a word for
# the row; a value set by hand between two steps shows as the number
INPUT_SPEEDS=("Slowest|-0.8" "Slower|-0.4" "Default|0" "Faster|0.4" "Fastest|0.8")
input_speed_word() {
  local entry
  for entry in "${INPUT_SPEEDS[@]}"; do
    awk -v a="${entry#*|}" -v b="$1" 'BEGIN { exit !(a - b < 0.01 && b - a < 0.01) }' &&
      { printf '%s' "${entry%|*}"; return; }
  done
  printf '%s' "${1:-Default}"
}

input_speed_pick() {
  printf '%s\n' "${INPUT_SPEEDS[@]}" |
    gum choose --label-delimiter="|" --header "$1 speed"
}

input_entry() {
  local choice value has_touchpad=0 has_mouse=0
  swaymsg -t get_inputs --raw 2>/dev/null | jq -e 'any(.[]; .type == "touchpad")' >/dev/null &&
    has_touchpad=1
  swaymsg -t get_inputs --raw 2>/dev/null | jq -e 'any(.[]; .type == "pointer")' >/dev/null &&
    has_mouse=1

  while true; do
    screen "Touchpad and keys"
    if [[ -z ${SWAYSOCK:-} ]]; then
      oops "This needs a running sway session to read and apply the settings."
      pause
      return 1
    fi
    local -a rows=()
    if ((has_touchpad)); then
      rows+=("$(printf '%-28s %s' "Tap to click" "$(input_onoff tap)")|tap")
      rows+=("$(printf '%-28s %s' "Natural scrolling" "$(input_onoff natural_scroll)")|natural_scroll")
      rows+=("$(printf '%-28s %s' "Ignore touchpad while typing" "$(input_onoff dwt)")|dwt")
      rows+=("$(printf '%-28s %s' "Touchpad speed" "$(input_speed_word "$(input_live touchpad accel_speed)")")|touchpad_speed")
    fi
    ((has_mouse)) &&
      rows+=("$(printf '%-28s %s' "Mouse speed" "$(input_speed_word "$(input_live pointer accel_speed)")")|pointer_speed")
    rows+=("$(printf '%-28s after %s ms, %s per second' "Key repeat" \
      "$(input_live keyboard repeat_delay)" "$(input_live keyboard repeat_rate)")|repeat")
    [[ -f $INPUT_CONF ]] && rows+=("Back to the defaults|reset")
    rows+=("Back|back")

    choice=$(printf '%s\n' "${rows[@]}" |
      gum choose --label-delimiter="|" --header "Touchpad and keys") || return 0
    case $choice in
      back|"") return 0 ;;
      tap|natural_scroll|dwt) input_toggle touchpad "$choice" ;;
      touchpad_speed)
        value=$(input_speed_pick Touchpad) || continue
        # pointer_accel to set it, accel_speed where get_inputs reports it
        input_set touchpad pointer_accel "$value"
        ;;
      pointer_speed)
        value=$(input_speed_pick Mouse) || continue
        input_set pointer pointer_accel "$value"
        ;;
      repeat)
        # delay then rate, as sway takes them; sway's defaults are 600/25
        value=$(printf '%s\n' "Slow - after 600 ms, 25 per second|600 25" \
          "Medium - after 400 ms, 35 per second|400 35" \
          "Fast - after 250 ms, 50 per second|250 50" |
          gum choose --label-delimiter="|" --header "Key repeat") || continue
        input_set keyboard repeat_delay "${value% *}"
        input_set keyboard repeat_rate "${value#* }"
        ;;
      reset)
        rm -f "$INPUT_CONF"
        # a reload puts back what the shipped config says, which a
        # removed line alone would not
        swaymsg -q reload 2>/dev/null
        ;;
    esac
  done
}

# 25. NIGHT LIGHT
#
# sunset.sh reads ~/.config/wlsunset/config as shell assignments -
# temp_low, temp_high, location=on|off, sunrise, sunset - and has since
# before this menu. On "follow the sun" it asks geoip.sh, so Location
# decides where the sun is.
WLSUNSET_CONF="$HOME/.config/wlsunset/config"

night_light_entry() {
  local choice value mode
  while true; do
    screen "Night light"
    say "The screen turns warmer between sunset and sunrise."
    echo
    local low sunrise sunset
    low=$(conf_get "$WLSUNSET_CONF" temp_low)
    mode=$(conf_get "$WLSUNSET_CONF" location)
    sunrise=$(conf_get "$WLSUNSET_CONF" sunrise)
    sunset=$(conf_get "$WLSUNSET_CONF" sunset)
    local -a rows=()
    if systemctl --user is-active wlsunset >/dev/null 2>&1; then
      rows+=("$(printf '%-18s %s' "Night light" "on")|power")
    else
      rows+=("$(printf '%-18s %s' "Night light" "off")|power")
    fi
    rows+=("$(printf '%-18s %s K' "Warmth at night" "${low:-4000}")|warmth")
    if [[ ${mode:-on} == off ]]; then
      rows+=("$(printf '%-18s %s' "When" "fixed, ${sunset:-19:00} to ${sunrise:-07:00}")|when")
    else
      rows+=("$(printf '%-18s %s' "When" "sunset to sunrise, from Location")|when")
    fi
    rows+=("Back|back")
    choice=$(printf '%s\n' "${rows[@]}" |
      gum choose --label-delimiter="|" --header "Night light") || return 0

    case $choice in
      back|"") return 0 ;;
      power)
        # the bar's toggle calls the same script, so the two agree
        if systemctl --user is-active wlsunset >/dev/null 2>&1; then
          /usr/share/sway/scripts/sunset.sh off >/dev/null 2>&1
        else
          /usr/share/sway/scripts/sunset.sh on >/dev/null 2>&1
        fi
        continue
        ;;
      warmth)
        value=$(printf '%s\n' "Slightly warm|5000" "Warm|4000" "Warmer|3500" \
          "Very warm|3000" "Warmest|2500" |
          gum choose --label-delimiter="|" --header "At night") || continue
        conf_line "$WLSUNSET_CONF" temp_low "temp_low=$value"
        ;;
      when)
        value=$(printf '%s\n' "From sunset to sunrise where I am|on" "At fixed times|off" |
          gum choose --label-delimiter="|" --header "When") || continue
        conf_line "$WLSUNSET_CONF" location "location=$value"
        if [[ $value == off ]]; then
          local t
          t=$(gum input --header "Warmer from (HH:MM)" --value "${sunset:-19:00}") || continue
          [[ $t =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { oops "HH:MM, like 19:30."; pause; continue; }
          conf_line "$WLSUNSET_CONF" sunset "sunset=$t"
          t=$(gum input --header "Back to normal from (HH:MM)" --value "${sunrise:-07:00}") || continue
          [[ $t =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { oops "HH:MM, like 07:00."; pause; continue; }
          conf_line "$WLSUNSET_CONF" sunrise "sunrise=$t"
        fi
        ;;
    esac
    # wlsunset takes all of it as arguments at start
    systemctl --user try-restart wlsunset >/dev/null 2>&1
  done
}

# 26. WINDOWS
#
# Autotiling, gaps and borders. Gaps and borders are sway settings, so
# they go to definitions.d as variables the shipped config reads; each is
# also sent to the running session.
WINDOWS_CONF="$HOME/.config/sway/definitions.d/50-windows.conf"

windows_entry() {
  local choice value
  while true; do
    screen "Windows"
    local gaps border
    gaps=$(conf_get "$WINDOWS_CONF" 'set $gaps')
    border=$(conf_get "$WINDOWS_CONF" 'set $border')
    local -a rows=()
    if unit_masked autotiling; then
      rows+=("$(printf '%-22s %s' "Automatic tiling" "off")|autotiling")
    else
      rows+=("$(printf '%-22s %s' "Automatic tiling" "on")|autotiling")
    fi
    rows+=("$(printf '%-22s %s px' "Gaps between windows" "${gaps:-5}")|gaps")
    rows+=("$(printf '%-22s %s px' "Window border" "${border:-1}")|border")
    rows+=("Back|back")
    hint "Automatic tiling splits the other way for each new window, so they"
    hint "spiral instead of lining up in a row."
    echo
    choice=$(printf '%s\n' "${rows[@]}" |
      gum choose --label-delimiter="|" --header "Windows") || return 0

    case $choice in
      back|"") return 0 ;;
      autotiling)
        if unit_masked autotiling; then
          unit_switch autotiling on
        else
          unit_switch autotiling off
        fi
        ;;
      gaps)
        value=$(printf '%s\n' "None|0" "Small|5" "Medium|10" "Large|20" |
          gum choose --label-delimiter="|" --header "Gaps") || continue
        conf_line "$WINDOWS_CONF" 'set $gaps' "set \$gaps $value"
        swaymsg -q "gaps inner all set $value; gaps outer all set $value" 2>/dev/null
        ;;
      border)
        value=$(printf '%s\n' "None|0" "Thin|1" "Medium|2" "Thick|4" |
          gum choose --label-delimiter="|" --header "Border") || continue
        conf_line "$WINDOWS_CONF" 'set $border' "set \$border $value"
        # every window that exists, then the default for new ones
        swaymsg -q "[tiling] border pixel $value; default_border pixel $value" 2>/dev/null
        ;;
    esac
  done
}

# 27. CONFIG SYNC
#
# chezmoi, not a sync tool of ours (#103): it owns the repository, the
# templating that lets a laptop and a desktop differ, and age encryption
# for anything secret. This clones, shows what applying would change, and
# applies once that has been confirmed. Nothing is committed or pushed for
# you, for the same reason notes are not: a tool that pushes by itself can
# publish something you did not choose to publish.
#
# Wi-Fi is deliberately out. The installer writes networks to
# /etc/NetworkManager/system-connections as root with the PSK in plain
# text, so syncing them means applying as root and trusting a dotfiles
# repository with passwords - a different trust model from $HOME. Half-
# syncing them is worse than saying so, and the screen says so.
#
# Without the age key, `chezmoi status` fails on the first encrypted file
# and shows nothing at all (measured with 2.72.2) - which is exactly the
# state of a new machine. So the preview falls back to leaving them out
# and naming them with `chezmoi managed`, which needs no key; the README's
# key handoff makes that first apply ask for the key's passphrase once.
# $1 is extra arguments for status.
config_sync_plan() {
  local out
  # shellcheck disable=SC2086 # $1 is a flag list or nothing
  out=$(chezmoi status --include=files,symlinks,remove,scripts ${1-} 2>&1) ||
    { printf '%s\n' "$out"; return 1; }
  [[ -n $out ]] || return 0
  # first column: edited here since chezmoi last wrote it; second: what
  # apply does
  awk '{
    a = substr($0, 2, 1); p = substr($0, 4)
    w = a == "A" ? "add" : a == "M" ? "update" : a == "D" ? "remove" : a == "R" ? "run" : a
    printf "  %-7s %s%s\n", w, p, substr($0, 1, 1) != " " ? "  (edited here - replaced)" : ""
  }' <<<"$out"
}

# Shows the plan and applies it once confirmed. --force only after that
# confirm: chezmoi's own prompt asks per file and names the file, not what
# replacing it means, which is the question the plan already answered.
config_sync_apply() {
  local plan secret=""
  if ! plan=$(config_sync_plan); then
    if ! plan=$(config_sync_plan --exclude=encrypted); then
      oops "chezmoi could not read the repository:"
      say "$plan"
      return 1
    fi
    secret=$(chezmoi managed --include=encrypted 2>/dev/null)
  fi

  if [[ -z $plan && -z $secret ]]; then
    say "✓ Nothing to change: this machine already matches the repository."
    return 0
  fi
  [[ -n $plan ]] && say "Applying would:" && echo "$plan"
  if [[ -n $secret ]]; then
    echo
    say "$(grep -c . <<<"$secret") encrypted file(s), which need the repository's key:"
    sed 's/^/  decrypt /' <<<"$secret"
    hint "This machine does not have the key yet; applying asks for its"
    hint "passphrase."
  fi
  echo
  gum confirm --affirmative "Apply" --negative "Back" "Apply it?" || return 0

  # not captured: the passphrase and any git credential prompt need the
  # terminal
  if ! chezmoi apply --force; then
    echo
    oops "Applying stopped partway. What chezmoi printed above says where."
    return 1
  fi
  echo
  say "✓ Applied."
  hint "Sway picks up its part on reload (Super+Shift+c); open programs"
  hint "read theirs when they next start."
}

config_sync_entry() {
  local source choice
  source=$(chezmoi source-path 2>/dev/null)
  while true; do
    screen "Config sync"

    local synced=0
    [[ -d $source/.git ]] && synced=1
    if ((synced)); then
      say "Repository: $(chezmoi git -- remote get-url origin 2>/dev/null || echo "none, local only")"
    else
      say "Not set up. Point this at a private git repository of your"
      say "configuration - sway, waybar, the shell - and this machine takes it."
    fi
    echo
    hint "Wi-Fi networks are not synced: they live outside your home"
    hint "directory, with their passwords in plain text. Join them again on"
    hint "each machine."
    if ((synced)); then
      hint "Sending a change from here is yours to do: chezmoi re-add, then"
      hint "chezmoi git -- commit -am '...' and chezmoi git push."
    fi
    echo

    local -a entries=()
    if ((synced)); then
      entries+=("Pull and apply")
    else
      entries+=("Use a repository")
    fi
    entries+=("Back")

    choice=$(gum choose --header "Config sync" "${entries[@]}") || return 0
    case $choice in
      "Use a repository")
        local url
        url=$(gum input --prompt "Repository: " \
          --placeholder "git@github.com:you/dotfiles.git") || continue
        [[ -n $url ]] || continue
        echo
        # -- so a URL can never be read as a flag
        if ! chezmoi init -- "$url"; then
          echo
          oops "Could not clone $url."
          hint "A private repository needs an SSH key the host knows, or an"
          hint "HTTPS token when git asks for a password."
          pause
          continue
        fi
        echo
        config_sync_apply
        pause
        ;;
      "Pull and apply")
        echo
        if ! chezmoi update --apply=false; then
          echo
          oops "Could not pull. What git printed above says why."
          pause
          continue
        fi
        echo
        config_sync_apply
        pause
        ;;
      *) return 0 ;;
    esac
  done
}

# The main menu's rows. Each is "key|icon|label|what it is": the key is
# what main dispatches on, so the label can say anything without
# breaking the case below. Icons are Nerd Font codepoints, nf-dev first
# and nf-md otherwise, the same preference as the workspace icons.
#
# Plain text only: gum choose strips ANSI from its items, so styling here
# never shows - and --selected matches against the stripped label, so an
# escape left in one means the cursor is never restored.
menu_row() {
  local key=$1 icon=$2 label=$3 blurb=$4
  # the label padded to one width, so the descriptions line up
  printf '%s  %-20s %s|%s\n' "$icon" "$label" "$blurb" "$key"
}

# A heading row, with no key, so choosing it does nothing. A rule rather
# than a colour, for the same reason; an empty one is just a gap.
menu_section() {
  if [[ -n $1 ]]; then
    printf '── %s %s|\n' "$1" "$(printf '─%.0s' $(seq $((40 - ${#1}))))"
  else
    printf '|\n'
  fi
}

# A one-line summary of the machine for the header: what someone opening
# settings most often wants to know without opening anything.
machine_line() {
  local host kernel parts=()
  host=$(uname -n)
  kernel=$(uname -r)
  parts+=("$host" "$kernel")
  local theme
  theme=$(sed -n 's/^# \(.*\): the palette.*/\1/p;s/^# \(.*\), light: the palette.*/\1 light/p' \
    "$HOME/.config/sway/definitions.d/theme.conf" 2>/dev/null | head -1)
  [[ -n $theme ]] && parts+=("theme $theme")
  local IFS='·'
  printf '%s' "${parts[*]/#/ }" | sed 's/^ //; s/·/ · /g; s/  */ /g'
}

main() {
  command -v gum >/dev/null || { echo "ashlaros-settings-tui: gum is not installed" >&2; exit 1; }

  local last=""
  while true; do
    screen "Settings"
    hint "$(machine_line)"
    echo

    # Rows are built rather than listed, so one pointing at a binary that
    # is not installed is absent rather than present and broken - which is
    # the rot #7 removed. A group is only printed when something is in
    # it.
    local -a input=() screen=() software=() sec=() look=() accounts=() apps=() rows=()

    input+=("$(menu_row keyboard $'\U000f030c' "Keyboard layout" "how keys map")")
    input+=("$(menu_row locale $'\U000f05ca' "System locale" "language and formats")")
    input+=("$(menu_row time $'\U000f0150' "Time and date" "clock and time zone")")
    input+=("$(menu_row location $'\U000f034e' "Location" "weather, night light, sunrise")")
    swaymsg -t get_inputs --raw 2>/dev/null | jq -e 'any(.[]; .type == "touchpad" or .type == "pointer")' >/dev/null &&
      input+=("$(menu_row input $'\U000f037d' "Touchpad and keys" "tap, scrolling, speed, key repeat")")
    command -v ashlaros-displays >/dev/null &&
      screen+=("$(menu_row displays $'\U000f0379' "Displays" "arrangement and scaling")")
    # a speaker to measure is the predicate: PipeWire answering is enough,
    # and the tool itself says when there is no microphone
    command -v ashlaros-speakers >/dev/null && pactl list short sinks 2>/dev/null | grep -q . &&
      screen+=("$(menu_row speakers $'\U000f04c3' "Speakers" "measure and calibrate")")
    # only where there is a backlight to adapt - the same predicate the
    # waybar toggle uses, so the bar and the menu agree about whether this
    # machine has the hardware at all
    if command -v wluma >/dev/null &&
      [[ -n $(ls -A /sys/class/backlight 2>/dev/null) ]]; then
      screen+=("$(menu_row wluma $'\U000f00e1' "Adaptive brightness" "screen follows the light")")
    fi
    command -v swayidle >/dev/null &&
      screen+=("$(menu_row timeouts $'\U000f04b2' "Screen timeouts" "dim, lock and sleep")")
    # the bar shows its toggle on the same condition
    command -v wlsunset >/dev/null &&
      screen+=("$(menu_row nightlight $'\U000f0594' "Night light" "warmer colours after dark")")
    # Built only where the daemon answers. power-profiles-daemon is
    # installed on every desktop, so the binary existing proves nothing;
    # asking it is what distinguishes a machine it can drive from one it
    # cannot. Not gated on a backlight or a battery - profiles are neither
    # laptop- nor battery-specific, and a desktop can switch them too.
    if command -v powerprofilesctl >/dev/null &&
      powerprofilesctl get >/dev/null 2>&1; then
      screen+=("$(menu_row power $'\U000f140b' "Power" "performance or battery")")
    fi
    software+=("$(menu_row kernels $'\ue712' "Kernels" "install another kernel")")
    command -v chwd >/dev/null &&
      software+=("$(menu_row hardware $'\U000f061a' "Hardware profiles" "drivers for this machine")")
    command -v pacseek >/dev/null &&
      software+=("$(menu_row packages $'\U000f03d6' "Install packages" "search and install")")
    [[ -n $(pacman -Qtdq 2>/dev/null) ]] &&
      software+=("$(menu_row orphans $'\U000f00e2' "Unneeded packages" "installed, needed by nothing")")
    # btrfs only: an ext4 install has no snapshots, and the entry would
    # open onto an explanation of why it cannot work
    [[ $(findmnt -no FSTYPE / 2>/dev/null) == btrfs ]] &&
      software+=("$(menu_row snapshots $'\U000f02da' "Snapshots" "roll back an update")")

    # Built only where there is an encrypted root to unlock: an
    # unencrypted install has no slots and no choice to make.
    root_crypt_device >/dev/null 2>&1 &&
      sec+=("$(menu_row disk $'\U000f033e' "Disk unlock" "passphrase, TPM or PIN")")
    # a machine with no reader must not show the entry at all: fprintd is
    # installed everywhere, so the binary existing proves nothing
    if command -v fprintd-enroll >/dev/null &&
      fprintd-list "$ME" >/dev/null 2>&1; then
      sec+=("$(menu_row fingerprint $'\U000f0237' "Fingerprint" "for sudo")")
    fi
    # howdy-next is an optdepend, so the binary existing is already a
    # choice someone made - but a machine with no camera at all should
    # still not be offered face unlock. /dev/video0 is the weakest honest
    # test: whether the camera sees infrared is what the entry's own
    # recognition test decides, and it refuses to enable until it passes.
    if command -v howdy >/dev/null && compgen -G "/dev/video*" >/dev/null; then
      sec+=("$(menu_row face $'\U000f0c7b' "Face unlock" "for sudo, with the IR camera")")
    fi

    look+=("$(menu_row theme $'\U000f03d8' "Theme" "day and night colours")")
    look+=("$(menu_row background $'\U000f02e9' "Background" "the wallpaper")")
    # No hardware predicate: any sway session can flash a window. The script
    # ships with this package, so the entry is always offerable.
    look+=("$(menu_row flashing $'\U000f0241' "Focus flashing" "flash the window you switch to")")
    look+=("$(menu_row windows $'\U000f0574' "Windows" "tiling, gaps and borders")")

    command -v aerc >/dev/null && accounts+=("$(menu_row mail $'\U000f01f0' "Mail" "aerc accounts")")
    command -v vdirsyncer >/dev/null && accounts+=("$(menu_row calendar $'\U000f00ed' "Calendar" "sync and subscriptions")")
    command -v tailscale >/dev/null &&
      accounts+=("$(menu_row tailscale $'\U000f0582' "Tailscale" "your private network")")
    command -v chezmoi >/dev/null &&
      accounts+=("$(menu_row sync $'\U000f04e6' "Config sync" "your config from a git repo")")
    command -v zk >/dev/null && apps+=("$(menu_row notes $'\U000f082e' "Notes" "your zk notebook")")
    command -v firefoxpwa >/dev/null && apps+=("$(menu_row webapps $'\U000f059f' "Web apps" "sites as windows")")
    command -v aichat >/dev/null && apps+=("$(menu_row model $'\U000f06a9' "Model" "aichat's model")")

    # Grouped by what someone is looking for, not by which tool does it.
    # Headings without blank rows between groups: the rule already
    # separates them, and a gap per group would cost seven rows.
    local name
    for name in "input:Language and time" "screen:Screen and power" \
      "look:Appearance" "software:Software" "sec:Security" \
      "accounts:Accounts" "apps:Apps"; do
      local -n group=${name%%:*}
      ((${#group[@]})) || continue
      rows+=("$(menu_section "${name#*:}")" "${group[@]}")
    done
    rows+=("$(menu_section "")" "$(menu_row quit $'\U000f0206' "Quit" "")")

    # Tall enough for every row where the terminal allows it: gum's
    # default of 10 hid most of the menu behind "…". Header and help line
    # take about 8 rows.
    local height=$(( $(tput lines 2>/dev/null || echo 30) - 8 ))
    ((height > ${#rows[@]})) && height=${#rows[@]}
    ((height < 5)) && height=5

    # --selected brings the cursor back to the entry just left, so going
    # into a screen and out again does not throw you to the top; the first
    # time, onto the first entry rather than the "System" heading
    [[ -n $last ]] || last=$(printf '%s\n' "${rows[@]}" | awk -F'|' '$2 != "" { sub(/\|[^|]*$/, ""); print; exit }')
    local key
    key=$(printf '%s\n' "${rows[@]}" |
      gum choose --label-delimiter="|" --height "$height" --header "" \
        ${last:+--selected "$last"}) || exit 0
    [[ -n $key ]] || continue
    last=$(printf '%s\n' "${rows[@]}" | awk -F'|' -v k="$key" '$2 == k { sub(/\|[^|]*$/, ""); print; exit }')

    case $key in
      keyboard) keyboard_menu ;;
      locale) locale_menu ;;
      displays) displays_entry ;;
      speakers) speakers_entry ;;
      kernels) kernel_menu ;;
      packages) packages_entry ;;
      time) time_menu ;;
      location) location_entry ;;
      input) input_entry ;;
      timeouts) screen_timeouts_entry ;;
      nightlight) night_light_entry ;;
      windows) windows_entry ;;
      hardware) hardware_menu ;;
      wluma) wluma_entry ;;
      flashing) flashing_entry ;;
      snapshots) snapshots_entry ;;
      power) power_entry ;;
      disk) disk_unlock_entry ;;
      fingerprint) fingerprint_entry ;;
      face) face_entry ;;
      orphans) orphans_entry ;;
      notes) notes_entry ;;
      mail) mail_entry ;;
      calendar) calendar_entry ;;
      theme) theme_entry ;;
      background) background_entry ;;
      webapps) webapps_entry ;;
      model) model_entry ;;
      tailscale) tailscale_entry ;;
      sync) config_sync_entry ;;
      quit) exit 0 ;;
    esac
  done
}

main "$@"
