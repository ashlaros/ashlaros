# The live system. It is the installer plus enough of a rescue environment
# to fix a machine that will not boot, not a full desktop: the desktop is
# what gets installed, and pulling it in twice would only make the ISO
# bigger and the boot slower.

# base
base
linux-cachyos
# Always beside the kernel, never separately. DKMS rebuilds a module
# against each installed kernel and needs that kernel's headers to do it;
# a kernel without them silently builds nothing and reports no error, so
# the two travel together everywhere a kernel is installed.
linux-cachyos-headers
linux-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils
# the archiso_pxe_nbd hook links nbd-client; without it every initramfs
# build ends in "binary not found" and produces an incomplete image
nbd
systemd
systemd-resolvconf
sudo
sed
which
less
nano
vim

# AshlarOS
ashlaros-branding
ashlaros-installer
ashlaros-keyring
# the live system resolves the TARGET's packages through pacstrap, so it
# needs to trust the repositories it fetches them from; without this the
# installer's `pacman -Sy` fails on the cachyos database signature
cachyos-keyring
ashlaros-mirrorlist
ashlaros-release
# Rollback is a rescue-media procedure, so the command has to be ON the
# rescue media. It lives in its own package rather than in
# ashlaros-settings precisely so the live system can carry it without
# pulling a desktop: `rollback` uses btrfs and findmnt, not snapper.
ashlaros-snapshot

# installer
# extra/, not the v3 rebuild: cachyos-extra-v3 carried python-pydantic-core
# 2.46.4 while extra's python-pydantic 2.13.5 requires exactly 2.46.5, so
# archinstall raised SystemError on import and the installer died before it
# touched the disk. Caught by booting the ISO, not by resolution checks -
# each package resolved fine alone. Drop the prefix when the v3 tree catches
# up; `pacman -Si python-pydantic-core` in both repos is the check.
extra/python-pydantic-core
archinstall
arch-install-scripts
gum
jq
openssl
tpm2-tools
tpm2-tss
chwd

# a live session, for looking something up mid-install. Started on tty2 by
# root/.live_session.sh; the installer keeps tty1 (#83). The wlroots and
# mesa stack behind sway was already on the medium for these four, so the
# ones below cost single-digit MiB on top of it.
sway
foot
foot-terminfo
firefox
# sway's default config names wmenu-run as $menu and brightnessctl as an
# optional dependency for its brightness keys
wmenu
brightnessctl
# copy and paste between the browser and the installer's questions, which
# is most of why someone switches to this VT
wl-clipboard
# firefox still has X11-only dialogues; without xwayland they open onto
# nothing
xorg-xwayland

# filesystems the installer can create or repair
btrfs-progs
e2fsprogs
dosfstools
exfatprogs
f2fs-tools
xfsprogs
ntfs-3g
cryptsetup
lvm2
mdadm
parted
gptfdisk
partclone

# storage and hardware
nvme-cli
hdparm
smartmontools
usbutils
pciutils
lsscsi
sg3_utils

# network: the install is online, so this is not optional
networkmanager
iwd
wireless-regdb
wpa_supplicant
dhcpcd
ethtool
openssh
rsync
curl
wget
bind

# rescue
arch-install-scripts
testdisk
ddrescue
fsarchiver
gpm
htop
man-db
man-pages
# a rescue shell over a flaky link: mosh survives roaming and suspend where
# ssh drops, which is the hotel-network case this environment exists for.
# The cost is protobuf, not mosh itself - 4.4 MiB of package files for the
# four of them. Client only: mosh-server needs sshd, which nothing enables.
mosh
tmux
zsh
grml-zsh-config

# virtualisation guest support, so the ISO is testable in a VM
qemu-guest-agent
open-vm-tools
virtualbox-guest-utils-nox

# archiso itself
edk2-shell
efibootmgr
memtest86+-efi
