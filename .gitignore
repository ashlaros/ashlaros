.wrangler/
__pycache__/
node_modules/
out/
work/
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.iso
# signing key material - never commit
.gnupg-tmp/
*.private-key.pem
# credentials, in any of the shapes an editor leaves them
.env
.env.*
*.env
.*.swp
# cargo build trees
core/target/
client/target/
# built from core/ by `npm run core:build` - a binary that a compiler
# emits does not belong in the tree
worker/src/game/ashlaros_games.wasm
docs/game/ashlaros_games.wasm
# generated from worker/src/game/; see docs/game/README.md
docs/game/logic.js
docs/game/quarry.js
# generated by scripts/game-sfx.mjs, deterministically - committing
# 340 KiB of WAV that a script emits is carrying it twice
docs/game/audio/
