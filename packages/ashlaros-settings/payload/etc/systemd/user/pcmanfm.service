[Unit]
# The autostart has always enabled this unit and no package in any
# repository provides one, so automount has never worked: a stick plugged
# into a running desktop only mounts if a file manager window happens to be
# open. --daemon-mode is what watches udisks without showing a window.
Description=pcmanfm-qt mounting daemon
PartOf=sway-session.target
After=sway-session-pre.target

[Service]
ExecStart=/usr/bin/pcmanfm-qt --daemon-mode
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
