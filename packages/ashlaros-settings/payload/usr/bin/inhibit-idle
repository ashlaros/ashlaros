#!/usr/bin/env bash

status() {
    ps -ef | grep -v grep | grep -m 1 -q "systemd-inhibit --what=idle"
}

inhibit() {
    systemd-inhibit --what=idle --who=swayidle-inhibit --why=commanded --mode=block sleep $1 &
    waybar-signal idle
}

case $1'' in
'interactive')
    # --only-match, so what comes back is one of these or nothing: typed
    # text is not a number of minutes. Cancelling inhibits nothing, as
    # before, and still falls through to the status line below.
    MINUTES=$(printf '%s\n' 1 10 15 20 30 45 60 90 120 Unlimited |
        fuzzel --dmenu --only-match --minimal-lines --prompt "Inhibit idle for (minutes): ")
    if [ "$MINUTES" = "Unlimited" ]; then
        inhibit $((365 * 24 * 60 * 60))
    elif [ -n "$MINUTES" ]; then
        inhibit $((MINUTES * 60))
    fi
    ;;
'off')
    pkill -U $USER -f "systemd-inhibit --what=idle" || true
    waybar-signal idle
    ;;
esac

# Returns data for Waybar
if status; then
    class="on"
    text="Inhibiting idle (Mid click to clear)"
else
    class="off"
    text="Idle not inhibited"
fi

printf '{"alt":"%s","tooltip":"%s"}\n' "$class" "$text"
