# Maintainer: AshlarOS <build@ashlaros.download>

# rebuilt once when source_hash began covering the executable bit
pkgname=ashlaros-installer
pkgver=20260910
pkgrel=1
pkgdesc="AshlarOS TUI installer"
arch=('any')
url="https://github.com/ashlaros/ashlaros"
license=('GPL-3.0-or-later')
depends=(
    'bash'
    'gum'          # every prompt in the configurator
    'jq'           # json the configurator writes and the dashboard reads
    'archinstall'  # driven as a library by the orchestrator
    'python'
    'arch-install-scripts' # arch-chroot, used by the post-install phases
    'openssl'      # password hashing
    'systemd'      # systemd-cryptenroll, for the TPM enrolment
    'tpm2-tools'
    'util-linux'   # lsblk, blockdev
    'parted'       # cfdisk, partprobe
    'ashlaros-branding' # the logo the TUI header renders
)
# built from installer/ in the monorepo checkout; the installer and this
# PKGBUILD move together, so a source= would pin them to a release that
# does not exist yet
source=()

# Content built from outside this directory. Read by
# scripts/discover_packages.py and scripts/package_version.py, which
# otherwise see only the package directory and would never notice an edit
# to installer/ - the package would keep its version and stay skipped.
#
# iso/airootfs is here for live-only below: the manifest is generated from
# that tree, so a file added to the ISO profile has to re-version this
# package or the installer would copy it onto the target.
_source_trees=(installer iso/airootfs)

package() {
  local installer="${startdir}/../../installer"

  install -Dm755 "${installer}/configurator" "${pkgdir}/usr/bin/ashlaros-configurator"
  install -Dm755 "${installer}/dashboard" "${pkgdir}/usr/bin/ashlaros-install-dashboard"
  install -Dm755 "${installer}/ashlaros-install" "${pkgdir}/usr/bin/ashlaros-install"

  install -d "${pkgdir}/usr/share/ashlaros-installer/orchestrator"
  install -Dm644 "${installer}"/orchestrator/*.py \
    "${pkgdir}/usr/share/ashlaros-installer/orchestrator/"

  # The denominator the dashboard fills its progress band from. Resolved at
  # build time rather than written by hand, for the reason
  # ashlaros-branding generates its plymouth script from logo.txt: a
  # literal goes stale the first time a dependency changes, and the
  # staleness is invisible - the bar just fills to the wrong place.
  #
  # Not fatal, deliberately. The builder syncs the full repository stack
  # before this runs, so resolution works there - but a mirror hiccup must
  # degrade the progress bar, not fail the package. Without the file the
  # dashboard falls back to whole-phase arithmetic, which is exactly what it
  # did before #94. The script itself refuses to emit a count below 100, so
  # a partial resolution cannot ship a wrong denominator either.
  # /etc/pacman.conf, not iso/pacman.conf: --dbpath below is the builder's
  # own database, synced against the builder's own configuration. Handing
  # pacman a different config names repositories those databases were never
  # fetched for, and resolution fails with "database not valid" - which is
  # how this silently fell back to no file at all and shipped an ISO whose
  # progress bar still moved per phase.
  python3 "${installer}/expected_package_count.py" \
    --pacman-conf /etc/pacman.conf \
    --dbpath /var/lib/pacman \
    --output "${pkgdir}/usr/share/ashlaros-installer/expected-packages" \
    || warning "could not resolve the package count; the install bar will move per phase only"

  # What the installer must NOT copy from the medium onto the target.
  #
  # Generated from the ISO profile, because that tree IS the definition of
  # "live only" - every file in it exists to make the medium a live medium.
  # A hand-written list beside it would drift the first time somebody adds
  # a file to the profile, and the drift is silent: the installer would
  # copy the new file onto installed systems and nothing would say so.
  #
  # Fatal if it produces nothing, unlike the package count above. An empty
  # manifest means an unfiltered copy, and iso/airootfs/etc/shadow gives
  # root an empty password - livecopy refuses to run without this file, so
  # a package that shipped without it would disable the copy entirely
  # rather than install a machine anyone can log into.
  ( cd "${startdir}/../../iso/airootfs" && find . -type f -o -type l ) |
    sed 's|^\.||' | sort > "${srcdir}/live-only"
  [[ -s ${srcdir}/live-only ]] ||
    { error "the live-only manifest is empty; iso/airootfs was not readable"; return 1; }
  install -Dm644 "${srcdir}/live-only" \
    "${pkgdir}/usr/share/ashlaros-installer/live-only"
}
