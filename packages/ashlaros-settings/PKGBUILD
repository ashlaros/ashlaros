                              # all assume it, and without it the desktop
                              # loses auto-scale, hotplug and lid handling
    'eww'                     # widget system; draws the keybinding help overlay
    'dex'                     # executes desktop entries on autostart
    'gum'                     # the TUI toolkit ashlaros-settings-tui and
                              # ashlaros-displays are built from; without
                              # it both exit with "gum is not installed"
                              # the first time a user opens settings
    'jq'                      # json parsing, used across the scripts
    'bc'                      # arithmetic for the bar scripts
    'inotify-tools'           # file watchers
    'lm_sensors'              # sensor readings for the bar
    # Calendar: khal views a vdir, vdirsyncer fills it. calcurse was here
    # and could not reach Google - its OAuth path is built on
    # python-oauth2client, which Google archived, sends no PKCE and wants
    # a client secret in a config file (#53).
    'khal'                    # tui calendar over a directory of .ics files
    # Our build carries an unmerged upstream fix (PR #1203): Google
    # advertises events it then 404s, and stock vdirsyncer treats that as
    # fatal, aborting the whole sync including calendars that were fine.
    # By its own name, like autotiling-rs-ashlaros: [ashlaros] is ordered
    # last, so a package called vdirsyncer here would lose to extra's.
    # Retire it by hand when #1203 is released.
    'vdirsyncer-ashlaros'     # caldav sync into that directory
    # vdirsyncer names this an optdepend for Google support; without it the
    # google_calendar storage raises "aiohttp-oauthlib not installed" at
    # sync time rather than at configure time, which is the wrong end
    'python-aiohttp-oauthlib' # oauth2 for the google calendar storage
    # notes, as plain Markdown in a directory: nothing to export and
    # nothing to sync, so git persistence is `git init` and no more
    'zk'                      # plain-text notes with an index and an LSP
    'btop'                    # system monitor
    'bluetuith'               # bluetooth management tool
